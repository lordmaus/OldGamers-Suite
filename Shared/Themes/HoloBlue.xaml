<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Holo Blue — holographic sci-fi interface -->
  <SolidColorBrush x:Key="BrushBg"           Color="#020C1B"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#132F4C"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#1E4060"/>
  <SolidColorBrush x:Key="BrushText"         Color="#66FCFC"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#A1DCDC"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#66CACA"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#00B4D8"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5B78"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FF88"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8C44"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#AA88FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF66CC"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00E5FF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#0A1929"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A3A55"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#2D8282"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF9FB0"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#00CBF3"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FF88"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
