<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Terminal Red — red phosphor terminal -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D0000"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#150000"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#200000"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FF6868"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#FF6868"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#FF6464"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#FF8888"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#FFAA44"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8833"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF44FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF4488"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFCC"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#080000"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#440000"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFFF00"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#BB0000"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF6464"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#FF8888"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#FFAA44"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFFF00"/>
</ResourceDictionary>
