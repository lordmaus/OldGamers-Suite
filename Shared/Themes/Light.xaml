<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WCAG 2.1/2.2 Level AAA — Light: #FFFFFF bg / #000000 text (21:1 contrast) -->
  <SolidColorBrush x:Key="BrushBg"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#F0F0F0"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#D0D0D0"/>
  <SolidColorBrush x:Key="BrushText"     Color="#000000"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#333333"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#0040CC"/>
  <SolidColorBrush x:Key="BrushRed"      Color="#AA0000"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="#005500"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="#7A4400"/>
  <SolidColorBrush x:Key="BrushBar"      Color="#E8E8E8"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#555555"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#0000CC"/><!-- Dark Blue: 10.7:1 on #FFF -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#333333"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#A60000"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#0040CC"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#005500"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#794300"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushOrange"      Color="#7A3300"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#0000CC"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#886600"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#660099"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#990055"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#006666"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
</ResourceDictionary>
