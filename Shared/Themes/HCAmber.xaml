<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- HC Amber — High Contrast amber retro -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A0A00"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3A1500"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#4A1A00"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFBF00"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#FF9D09"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#F89100"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF6228"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#AAFF00"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFBF00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF88FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF44AA"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFCC"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#2A1000"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#664400"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFE500"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#CC7700"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF8A5F"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#AAFF00"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFBF00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFE500"/>
</ResourceDictionary>
