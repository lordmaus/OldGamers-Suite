<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Monochrome — pure greyscale -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#242424"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#303030"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#BDBDBD"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#AFAFAF"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#BDBDBD"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F6675C"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9E9E9E"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#EEEEEE"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#9E9E9E"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#121212"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#424242"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFFFFF"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6D6D6D"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F9928A"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#BDBDBD"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#6FC172"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFFFFF"/>
</ResourceDictionary>
