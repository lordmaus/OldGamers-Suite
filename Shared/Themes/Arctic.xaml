<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Arctic — cool crisp light theme -->
  <SolidColorBrush x:Key="BrushBg"           Color="#F0F4F8"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#D4DDE5"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#BFCCD6"/>
  <SolidColorBrush x:Key="BrushText"         Color="#2D3748"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#323A47"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#3D4552"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#589AD7"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#EC6E6E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#38A169"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#D69E2E"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#DD6B20"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#ECC94B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#805AD5"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#D53F8C"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#2C7A7B"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#E2EBF0"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#A0AEC0"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#1A365D"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#494949"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6F7E94"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#891313"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#1B4770"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#1B4D33"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#584111"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#1A365D"/>
</ResourceDictionary>
