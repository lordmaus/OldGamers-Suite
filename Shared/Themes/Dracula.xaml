<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dracula palette — https://draculatheme.com/
       Text #F8F8F2 on Bg #282A36 ≈ 10.4:1 (WCAG AAA ✓) -->
  <SolidColorBrush x:Key="BrushBg"       Color="#282A36"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#383A47"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#44475A"/>
  <SolidColorBrush x:Key="BrushText"     Color="#F8F8F2"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#E2E2E2"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#C6CCDE"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#8BE9FD"/>
  <SolidColorBrush x:Key="BrushRed"      Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="#50FA7B"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="#F1FA8C"/>
  <SolidColorBrush x:Key="BrushBar"      Color="#21222C"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#6272A4"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FFD700"/><!-- Gold: 9.6:1 on #282A36 -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7483AF"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFBBBB"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#8BE9FD"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#50FA7B"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#F1FA8C"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushOrange"      Color="#FABA8C"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#F1FA8C"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BD93F9"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF79C6"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#8BE9FD"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
</ResourceDictionary>
