<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- High Contrast Light — WCAG AAA (light) -->
  <SolidColorBrush x:Key="BrushBg"           Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#C0C0C0"/>
  <SolidColorBrush x:Key="BrushText"         Color="#000000"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#333333"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#0000CC"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#B60000"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#006600"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#806000"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#804000"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#806000"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#550055"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#880044"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#005566"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#F0F0F0"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#707070"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#0000EE"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#333333"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#940000"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#0000CC"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#005400"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#5B4400"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#0000EE"/>
</ResourceDictionary>
