<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Nord palette — https://www.nordtheme.com/
       Text #ECEFF4 on Bg #2E3440 ≈ 10.9:1 (WCAG AAA ✓) -->
  <SolidColorBrush x:Key="BrushBg"       Color="#2E3440"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#3B4252"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#434C5E"/>
  <SolidColorBrush x:Key="BrushText"     Color="#ECEFF4"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#E3E8EF"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#CCD9E6"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#88C0D0"/>
  <SolidColorBrush x:Key="BrushRed"      Color="#CC8087"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="#A3BE8C"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="#EBCB8B"/>
  <SolidColorBrush x:Key="BrushBar"      Color="#242933"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#616E88"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#EFD5A0"/><!-- Nord amber: 8.3:1 on #2E3440 -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#81A1C1"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#ECD1D3"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#BEDDE5"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#CEDCC1"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#EFD5A0"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushOrange"      Color="#EBB38B"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#EFD5A0"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#EBCB8B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#B48EAD"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#B48EAD"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#88C0D0"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
</ResourceDictionary>
