<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One Dark (Atom) — https://github.com/atom/atom
       Text #ABB2BF on Bg #282C34 ≈ 8.6:1 (WCAG AAA ✓) -->
  <SolidColorBrush x:Key="BrushBg"       Color="#282C34"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#353B45"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#3E4451"/>
  <SolidColorBrush x:Key="BrushText"     Color="#D7DBE1"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#D7DBE1"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#C8CCD5"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#61AFEF"/>
  <SolidColorBrush x:Key="BrushRed"      Color="#E2747C"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="#98C379"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="#E5C07B"/>
  <SolidColorBrush x:Key="BrushBar"      Color="#21252B"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#636D83"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#E8C88B"/><!-- warm gold: 7.4:1 on #282C34 -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7A849A"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F2C0C3"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#A5D1F6"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#B7D5A1"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#E8C88B"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushOrange"      Color="#E5A77B"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#E8C88B"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#E5C07B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#C678DD"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E06C75"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#56B6C2"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
</ResourceDictionary>
