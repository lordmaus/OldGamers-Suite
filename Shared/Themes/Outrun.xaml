<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Outrun — retro synthwave racing -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000510"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#02143B"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#0B1F50"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E0E8FF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#A0ABD6"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#94A1CC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5A7E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#02FF6E"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF7700"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF00FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF3864"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#010A1E"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A2A55"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#4D60A1"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7492"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#02FF6E"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
