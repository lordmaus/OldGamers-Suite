<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WCAG 2.1/2.2 Level AAA — Dark: #000000 bg / #FFFFFF text (21:1 contrast) -->
  <SolidColorBrush x:Key="BrushBg"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#333333"/>
  <SolidColorBrush x:Key="BrushText"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#C0C0C0"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#89B4FA"/>
  <SolidColorBrush x:Key="BrushRed"      Color="#FF6E6E"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="#7AE87A"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="#FFD080"/>
  <SolidColorBrush x:Key="BrushBar"      Color="#111111"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#808080"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FFD700"/><!-- Gold: 11.5:1 on #000 -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#C0C0C0"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7D7D"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#89B4FA"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#7AE87A"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD080"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushOrange"      Color="#FFB580"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F48FB1"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#4DB6AC"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
</ResourceDictionary>
