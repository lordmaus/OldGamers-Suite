<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ivory — warm off-white light -->
  <SolidColorBrush x:Key="BrushBg"           Color="#FFFFF0"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#EEEEDE"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#DDDDC8"/>
  <SolidColorBrush x:Key="BrushText"         Color="#3D3D3D"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#444444"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#4E4E4E"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#6B9AC4"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#DD7878"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#2D7A2D"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#C8960C"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#B8520A"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#C8A020"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#7040A0"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#B03070"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#2A7870"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#F5F5DC"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#C0C0B8"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#1A4A80"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#494949"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#888888"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#942525"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#2D5172"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#215A21"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#644B06"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#1A4A80"/>
</ResourceDictionary>
