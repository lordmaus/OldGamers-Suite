<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Meadow — bright sunlit grassland -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A2A0A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#243810"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#304818"/>
  <SolidColorBrush x:Key="BrushText"         Color="#D8F0C8"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#C3DFAD"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#ABC998"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#EF9A9A"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#8BC34A"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFAB40"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F48FB1"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#121F05"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#385A18"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#78A858"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F2B0B0"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#A0CE6C"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>

  <!-- Suite superset keys (2026-10-13): app-specific tokens merged from other apps -->
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
