<Application x:Class="TimerStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:TimerStudio"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Active theme — swapped at runtime by App.SetTheme() -->
        <ResourceDictionary Source="Themes/Dark.xaml"/>
        <!-- Fixed-color JT icon set (theme-independent). App.ApplyThemeUri swaps only the "Themes/" entry;
             App.OnStartup re-adds this after its MergedDictionaries.Clear(). -->
        <ResourceDictionary Source="Theming/ColorIcons.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Converter: "Visible"/"Collapsed" string → Visibility enum -->
      <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

      <!-- Fixed-color JT icons (Theming/ColorIcons.xaml). Never recolored per theme;
           always paired with a text label or AutomationProperties.Name. Disabled = faded. -->
      <local:JtIconConverter x:Key="JtIconConverter"/>
      <local:JtLabelIconConverter x:Key="JtLabelIconConverter"/>
      <Style x:Key="JtBtnIcon" TargetType="Image">
        <Setter Property="Width"             Value="18"/>
        <Setter Property="Height"            Value="18"/>
        <Setter Property="Stretch"           Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,7,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.4"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="JtSoloIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="JtInlineIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
      <Style x:Key="JtMenuIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0"/>
      </Style>
      <Style x:Key="JtHeaderIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
      </Style>
      <!-- Combo items whose content is plain text (mode, default sort): icon looked up from the label.
           Set per ComboBoxItem (ContentTemplate) — ComboBox.ItemTemplate is ignored for explicit ComboBoxItems.
           The selection box reuses the item's ContentTemplate. -->
      <DataTemplate x:Key="JtLabelItemTemplate">
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding Converter={StaticResource JtLabelIconConverter}}" Style="{StaticResource JtInlineIcon}"/>
          <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>

      <!-- ── Low-Vision: app-wide font family + size anchors (swappable at runtime) ── -->
      <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
      <sys:Double x:Key="UiTitleBase">17</sys:Double>
      <sys:Double x:Key="UiButtonBase">12</sys:Double>
      <sys:Double x:Key="UiBodyBase">12</sys:Double>

      <!-- ── WCAG 2.2 AAA type ramp (1.4.8, low-vision goal): 12px floor. Always DynamicResource. ── -->
      <sys:Double x:Key="FontSizeCaption">12</sys:Double>
      <sys:Double x:Key="FontSizeBody">14</sys:Double>
      <sys:Double x:Key="FontSizeTitle">18</sys:Double>

      <!-- ── Headings (2.4.10 Section Headings): section labels = Level2, dialog titles = Level1.
           Local FontSize/Foreground/Margin on an element still win; the style guarantees the UIA heading. ── -->
      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
      </Style>
      <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
      </Style>


      <!-- ── Tooltip style ── -->
      <Style TargetType="ToolTip">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
      </Style>

      <!-- ── Base flat button — TargetType ButtonBase so implicit Button AND ToggleButton styles
           can be BasedOn it. Hover/press keep full text contrast (no opacity dimming, F4):
           hover = 1px BrushText outline, press = 97% scale (non-colour cues). ── -->
      <Style x:Key="FlatButton" TargetType="ButtonBase">
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="MinWidth"        Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="6"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Primary (accent-coloured) button — takes alert colour at runtime ── -->
      <Style x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- ── Danger button ── -->
      <Style x:Key="DangerButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushRed}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- ── Implicit Button / ToggleButton (F6): no default OS chrome anywhere in the app.
           Opt out per element with Style="{x:Null}" (used by the ComboBox template's toggle). ── -->
      <Style TargetType="Button" BasedOn="{StaticResource FlatButton}"/>
      <Style x:Key="FlatToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource FlatButton}">
        <Style.Triggers>
          <!-- Checked = accent fill + OnAccent text + 1px text outline (shape cue, not colour-only) -->
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background"  Value="{DynamicResource BrushBlue}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="ToggleButton" BasedOn="{StaticResource FlatToggleButton}"/>

      <!-- ── ComboBox ── -->
      <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="ComboBoxItem">
              <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
              <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
              <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
              <Setter Property="FontSize"    Value="12"/>
              <Setter Property="Padding"     Value="8,5"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                            Padding="{TemplateBinding Padding}">
                      <!-- Use TextElement.Foreground so the colour reaches the
                           text inside ContentPresenter regardless of item template -->
                      <ContentPresenter
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <!-- Hover: Surf2 + 3px left bar (non-colour cue); text stays 7:1 on Surf2 -->
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushSurf2}"/>
                        <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{DynamicResource BrushText}"/>
                      </Trigger>
                      <!-- Selected in dropdown: blue bg, white text (readable in both themes) -->
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushBlue}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                        <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{DynamicResource BrushOnAccent}"/>
                      </Trigger>
                      <!-- Selected + hovered: keep blue, keep white -->
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsSelected"     Value="True"/>
                          <Condition Property="IsHighlighted"  Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushBlue}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                        <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{DynamicResource BrushOnAccent}"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="MainBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      TextElement.Foreground="{DynamicResource BrushText}"/>
                    <TextBox x:Name="PART_EditableTextBox"
                             AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                             Grid.Column="0" Visibility="Hidden"
                             Background="Transparent"
                             Foreground="{DynamicResource BrushText}"
                             BorderThickness="0"
                             Margin="{TemplateBinding Padding}"
                             VerticalAlignment="Center"
                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <Border Grid.Column="1" Background="Transparent" CornerRadius="0,3,3,0">
                      <TextBlock Text="∨" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushHint}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="Transparent" BorderThickness="0"
                                  Style="{x:Null}"/>
                  </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Slide">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1" CornerRadius="0,0,3,3"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer SnapsToDevicePixels="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing"   Property="Opacity"     Value="1"/>
                  <Setter TargetName="MainBorder"  Property="BorderBrush"
                          Value="{DynamicResource FocusRingBrush}"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                  <Setter TargetName="MainBorder" Property="BorderBrush"
                          Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── TextBox ── -->
      <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- ── DatePicker — theme-aware ── -->
      <!-- Calendar popup background and foreground -->
      <Style TargetType="Calendar">
        <Setter Property="Background"   Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"   Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"     Value="12"/>
      </Style>

      <Style TargetType="CalendarDayButton">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="MinWidth"     Value="30"/>
        <Setter Property="MinHeight"    Value="30"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
          </Trigger>
          <Trigger Property="IsToday" Value="True">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBlueText}"/>
          </Trigger>
          <Trigger Property="IsInactive" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
          </Trigger>
          <!-- Selected today: BlueText on Blue fill would vanish — OnAccent wins -->
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True"/>
              <Condition Property="IsToday"    Value="True"/>
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="CalendarButton">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Style.Triggers>
          <!-- CalendarButton is the month/year nav header — only hover state needed -->
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="CalendarItem">
        <Setter Property="Background"   Value="{DynamicResource BrushSurf}"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>

      <Style TargetType="DatePicker">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="4,3"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
      </Style>

      <!-- ── DatePickerTextBox inside DatePicker ── -->
      <Style TargetType="DatePickerTextBox">
        <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"    Value="2,2"/>
      </Style>

      <!-- ── F6 implicit styles: PasswordBox / RichTextBox / ListView / RadioButton.
           FileCopy/src/App.xaml has no styles for these types (it doesn't use them), so they are
           authored here to the same contract as TextBox/CheckBox; later apps copy from TimerStudio. ── -->
      <Style TargetType="PasswordBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource BrushBlue}"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="RichTextBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource BrushBlue}"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RichTextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ListViewItem: plain ContentPresenter template — NOT for GridView ListViews
           (those need a GridViewRowPresenter; give them a local ItemContainerStyle). -->
      <Style x:Key="ThemedListViewItem" TargetType="ListViewItem">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource BrushText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"                    Value="6,4"/>
        <Setter Property="MinHeight"                  Value="44"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="4,0,0,0"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="-1" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Hover: Surf2 + Muted bar; Selected: Surf2 + accent bar. Text stays BrushText (7:1 on Surf2). -->
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListView">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedListViewItem}"/>
      </Style>

      <!-- RadioButton (ported from BadgeOverlay/Themes/_Inputs.xaml): 18px ring + 10px dot,
           44px row, 2px FocusRingBrush ring like CheckBox. -->
      <Style TargetType="RadioButton">
        <Setter Property="Foreground"               Value="{DynamicResource BrushText}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="FontFamily"               Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="MinHeight"                Value="44"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent" MinHeight="44">
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4" Margin="-2" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                  <Border x:Name="OuterRing" Width="18" Height="18" CornerRadius="9"
                          BorderThickness="2" BorderBrush="{DynamicResource BrushMuted}"
                          Background="{DynamicResource BrushSurf}" Margin="0,0,8,0"
                          VerticalAlignment="Center">
                    <Ellipse x:Name="InnerDot" Width="10" Height="10"
                             Fill="{DynamicResource BrushBlueText}" Visibility="Collapsed"/>
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="InnerDot"  Property="Visibility"  Value="Visible"/>
                  <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushBlueText}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Separator ── -->
      <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BrushDivider}"/>
        <Setter Property="Margin"     Value="0,4"/>
        <Setter Property="Height"     Value="1"/>
      </Style>

      <!-- ── CheckBox ── -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground"              Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"              Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                Value="12"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"        Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent" MinHeight="44">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4"
                        Margin="-2" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                  <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Border x:Name="CheckBorder"
                            BorderBrush="{DynamicResource BrushMuted}"
                            BorderThickness="1.5" CornerRadius="3"
                            Background="Transparent"/>
                    <TextBlock x:Name="CheckMark" Text="✓"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource BrushBlueText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" Opacity="0"/>
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="CheckMark"   Property="Opacity"      Value="1"/>
                  <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushHint}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- L-4: global Slider style — previously unstyled everywhere in the
           app (default WPF chrome: thin system-colour track, ~10px thumb).
           Fails WCAG AAA on two counts: contrast against dark themes and the
           44px minimum touch target. Track/thumb now use theme brushes and
           the thumb hit area is bumped to 20px inside a 44px-tall row. -->
      <Style TargetType="Slider">
        <Setter Property="Height"           Value="28"/>
        <Setter Property="MinHeight"        Value="44"/>
        <Setter Property="Focusable"        Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid Background="Transparent" VerticalAlignment="Center" MinHeight="44">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="6"
                        Margin="0,10" Opacity="0"/>
                <Border x:Name="TrackBg"
                        Height="4" CornerRadius="2"
                        Background="{DynamicResource BrushMuted}"
                        VerticalAlignment="Center"/>
                <Track x:Name="PART_Track" VerticalAlignment="Center">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                  AutomationProperties.Name="Decrease value">
                      <RepeatButton.Style>
                        <Style TargetType="RepeatButton">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="RepeatButton">
                                <Border Height="4" CornerRadius="2"
                                        Background="{DynamicResource BrushBlue}"/>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </RepeatButton.Style>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                  AutomationProperties.Name="Increase value">
                      <RepeatButton.Style>
                        <Style TargetType="RepeatButton">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </RepeatButton.Style>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <!-- L-4 follow-up: hit area widened to 44x44 (WCAG SC 2.5.5/2.5.8)
                         via a transparent template root; the visible glyph stays a
                         20x20 Ellipse centered inside it, so the look is unchanged. -->
                    <Thumb x:Name="SliderThumb" Width="44" Height="44">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent">
                            <Ellipse Width="20" Height="20"
                                     Fill="{DynamicResource BrushBlue}"
                                     Stroke="{DynamicResource BrushBg}"
                                     StrokeThickness="2"/>
                          </Grid>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="TrackBg" Property="Opacity" Value="0.5"/>
                  <Setter TargetName="PART_Track" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>


      <!-- L-5: implicit ContextMenu/MenuItem style — previously fully
           unstyled everywhere in the app (OS-default light popup chrome
           behind every dark/neon theme: Sort, Theme picker, Templates,
           Category picker). Covers plain items, separators, and submenu
           headers (the Theme picker's category flyouts nest MenuItems). -->
      <Style TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="2"/>
        <Setter Property="HasDropShadow"   Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Background" Value="{DynamicResource BrushDivider}"/>
        <Setter Property="Margin"     Value="6,4"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="{TemplateBinding Background}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="MenuItem">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="MinHeight"        Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Grid x:Name="Root" Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="20"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto" MinWidth="14"/>
                </Grid.ColumnDefinitions>
                <!-- Hover/keyboard highlight bar: non-colour cue alongside the Surf2 fill -->
                <Border x:Name="HighlightBar" Grid.Column="0" Width="3"
                        HorizontalAlignment="Left" Background="{DynamicResource BrushText}"
                        Opacity="0" IsHitTestVisible="False"/>
                <!-- Fixed-color JT icon (MenuItem.Icon, 16px); collapsed when none -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                  MaxWidth="16" MaxHeight="16"
                                  Margin="4,0" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource BrushMuted}"
                           Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#9656;" FontSize="{DynamicResource FontSizeCaption}"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushMuted}"
                           Visibility="Collapsed"/>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="1" Opacity="0"
                        IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       Placement="Right" HorizontalOffset="-4" VerticalOffset="-2"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1" CornerRadius="4" Padding="2">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                  <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                  <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="HighlightBar" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
