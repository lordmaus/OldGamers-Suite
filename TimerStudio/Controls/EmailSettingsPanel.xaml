<UserControl x:Class="TimerStudio.Controls.EmailSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Email alert settings">
  <!-- TS-10 (2026-10-12): shared by SettingsDialog (Email tab) and CalendarSettingsDialog.
       DataContext = TimerStudio.EmailSettingsViewModel (set in code-behind). -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize"          Value="{DynamicResource FontSizeCaption}"/>
      <Setter Property="Foreground"        Value="{DynamicResource BrushMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldError" TargetType="TextBlock">
      <Setter Property="FontSize"     Value="{DynamicResource FontSizeCaption}"/>
      <Setter Property="Foreground"   Value="{DynamicResource BrushRedText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin"       Value="0,0,0,8"/>
      <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource SectionHeader}" Text="EMAIL ALERTS"
               FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
               Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
    <TextBlock Text="Send an email whenever a timer fires. Requires network access."
               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Enable -->
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Send email on timer alert"
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}"
                 VerticalAlignment="Center"/>
      <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                MinHeight="44" MinWidth="44"
                IsChecked="{Binding EmailEnabled}"
                AutomationProperties.Name="Enable email alerts"/>
    </Grid>

    <!-- Mode -->
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="210"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Send via"
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}"
                 VerticalAlignment="Center"/>
      <ComboBox Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}"
                SelectedIndex="{Binding ModeIndex}"
                ToolTip="Choose how to send email alerts"
                AutomationProperties.Name="Email send method"
                AutomationProperties.HelpText="SMTP works with any provider. Outlook uses your installed Outlook client. Microsoft account signs in with OAuth.">
        <ComboBoxItem>MailKit / SMTP  (any provider)</ComboBoxItem>
        <ComboBoxItem>Outlook  (uses installed Outlook)</ComboBoxItem>
        <ComboBoxItem>Microsoft Account  (Hotmail / Outlook.com / Live)</ComboBoxItem>
      </ComboBox>
    </Grid>

    <!-- Recipient — all modes (TS-14) -->
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Send to (To:)" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="TxtEmailTo" Grid.Column="1"
               FontSize="{DynamicResource FontSizeCaption}"
               Text="{Binding To, UpdateSourceTrigger=LostFocus}"
               ToolTip="Email address(es) to receive alerts — separate with commas"
               AutomationProperties.Name="Alert recipient email address">
        <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AutomationProperties.HelpText" Value="Separate multiple addresses with commas."/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasToError}" Value="True">
                <Setter Property="BorderBrush"     Value="{DynamicResource BrushRedText}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="AutomationProperties.HelpText" Value="{Binding ToError}"/>
              </DataTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </Grid>
    <TextBlock Style="{StaticResource FieldError}" Margin="110,-4,0,8"
               Visibility="{Binding HasToError, Converter={StaticResource BoolToVis}}"><InlineUIContainer BaselineAlignment="Center"><Image Source="{StaticResource JtIcon.Warning}" Style="{StaticResource JtInlineIcon}"/></InlineUIContainer><Run Text="{Binding ToError, Mode=OneWay}"/></TextBlock>

    <!-- MailKit SMTP fields -->
    <StackPanel Visibility="{Binding IsSmtp, Converter={StaticResource BoolToVis}}">

      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="From address" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}"
                 Text="{Binding From, UpdateSourceTrigger=LostFocus}"
                 ToolTip="Sender email address (usually same as SMTP username)"
                 AutomationProperties.Name="Sender email address"/>
      </Grid>

      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="SMTP host" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}"
                 Text="{Binding Host, UpdateSourceTrigger=LostFocus}"
                 ToolTip="Personal @hotmail/@outlook/@live → smtp-mail.outlook.com  |  Gmail → smtp.gmail.com  |  Office 365 business → smtp.office365.com"
                 AutomationProperties.Name="SMTP server hostname"/>
        <TextBox Grid.Column="3" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Center"
                 Text="{Binding PortText, UpdateSourceTrigger=LostFocus}"
                 ToolTip="SMTP port — 587 (STARTTLS) or 465 (SSL/TLS)"
                 AutomationProperties.Name="SMTP port number"/>
      </Grid>

      <!-- Security (TS-03) -->
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Security" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}"
                  SelectedIndex="{Binding SecurityIndex}"
                  ToolTip="Connection encryption. Automatic picks SSL/TLS for port 465 and STARTTLS otherwise."
                  AutomationProperties.Name="Connection security"
                  AutomationProperties.HelpText="Automatic is recommended. None is only available when no username is set.">
          <ComboBoxItem>Automatic (recommended)</ComboBoxItem>
          <ComboBoxItem>SSL/TLS — port 465</ComboBoxItem>
          <ComboBoxItem>STARTTLS — port 587</ComboBoxItem>
          <ComboBoxItem IsEnabled="{Binding NoneAllowed}"
                        AutomationProperties.Name="None — only for servers without sign-in">
            <TextBlock Text="None — only for servers without sign-in">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NoneAllowed}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </ComboBoxItem>
        </ComboBox>
      </Grid>
      <TextBlock Margin="110,0,0,8" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"><InlineUIContainer BaselineAlignment="Center"><Image Source="{StaticResource JtIcon.Lock}" Style="{StaticResource JtInlineIcon}"/></InlineUIContainer><Run Text="{Binding SecurityHint, Mode=OneWay}"/></TextBlock>

      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Column="1" FontSize="{DynamicResource FontSizeCaption}"
                 Text="{Binding User, UpdateSourceTrigger=LostFocus}"
                 ToolTip="SMTP login username (usually your email address). Leave blank for servers without sign-in."
                 AutomationProperties.Name="SMTP username"/>
      </Grid>

      <!-- Password (TS-04) -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    ToolTip="Stored encrypted on this machine only (Windows DPAPI)">
          <Image Source="{StaticResource JtIcon.Lock}" Style="{StaticResource JtInlineIcon}"/>
          <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
        </StackPanel>
        <PasswordBox x:Name="PwdSmtp" Grid.Column="1"
                     FontSize="{DynamicResource FontSizeCaption}"
                     ToolTip="SMTP password — stored encrypted on this machine only"
                     AutomationProperties.Name="SMTP password"
                     PasswordChanged="PwdSmtp_PasswordChanged"
                     LostFocus="PwdSmtp_LostFocus">
          <PasswordBox.Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PasswordUnreadable}" Value="True">
                  <Setter Property="BorderBrush"     Value="{DynamicResource BrushRedText}"/>
                  <Setter Property="BorderThickness" Value="2"/>
                  <Setter Property="AutomationProperties.HelpText" Value="Saved password can't be read on this PC. Re-enter it."/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </PasswordBox.Style>
        </PasswordBox>
      </Grid>
      <TextBlock Style="{StaticResource FieldError}" Margin="110,-4,0,8"
                 Visibility="{Binding PasswordUnreadable, Converter={StaticResource BoolToVis}}"><InlineUIContainer BaselineAlignment="Center"><Image Source="{StaticResource JtIcon.Warning}" Style="{StaticResource JtInlineIcon}"/></InlineUIContainer><Run Text="Saved password can't be read on this PC. Re-enter it."/></TextBlock>

    </StackPanel>

    <!-- Outlook note -->
    <Border Background="{DynamicResource BrushSurf}" BorderBrush="{DynamicResource BrushSurf2}"
            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
            Visibility="{Binding IsOutlook, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Outlook mode sends via your installed Outlook client. No SMTP config needed — it sends from your default Outlook account."
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>
    </Border>

    <!-- Microsoft OAuth2 (client ID embedded in app) -->
    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsOAuth, Converter={StaticResource BoolToVis}}">
      <Border Background="{DynamicResource BrushSurf}" BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
        <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"
                   Text="Sign in once to authorize Timer Studio to send email using your Hotmail / Outlook.com / Live account. Your credentials are never stored — only a refresh token is cached locally."/>
      </Border>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding OAuthAccountText}"
                   FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                   Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2" Style="{StaticResource FlatButton}"
                FontSize="{DynamicResource FontSizeCaption}" Padding="10,6" MinHeight="44" MinWidth="44"
                IsEnabled="{Binding CanSignIn}"
                ToolTip="Opens your browser to sign in with your Microsoft account"
                AutomationProperties.Name="Sign in with Microsoft account"
                Click="BtnMsSignIn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Password}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Sign in with Microsoft" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Grid.Column="4" Content="Sign out" Style="{StaticResource FlatButton}"
                FontSize="{DynamicResource FontSizeCaption}" Padding="10,6" MinHeight="44" MinWidth="44"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}"
                ToolTip="Remove saved Microsoft account credentials"
                AutomationProperties.Name="Sign out Microsoft account"
                Click="BtnMsSignOut_Click"/>
      </Grid>
    </StackPanel>

    <!-- Test + status -->
    <Grid Margin="0,4,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}"
                 FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                 Foreground="{DynamicResource BrushMuted}"
                 VerticalAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite"/>
      <Button Grid.Column="1" Style="{StaticResource FlatButton}"
              Padding="12,6" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44" MinWidth="44"
              IsEnabled="{Binding CanSendTest}"
              ToolTip="Send a test email using the current settings"
              ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="Send test email"
              Click="BtnTestEmail_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Smtp}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Send Test" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>
  </StackPanel>
</UserControl>
