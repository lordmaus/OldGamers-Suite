<Window x:Class="TimerStudio.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TimerStudio.Controls"
        Title="Timer Studio — Settings"
        Width="540" Height="760"
        MinWidth="460" MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Timer Studio Settings">

  <Window.Resources>
    <!-- Tab nav button style — RadioButton styled as underline tab -->
    <Style x:Key="TabBtn" TargetType="RadioButton">
      <Setter Property="GroupName"   Value="SettingsTabs"/>
      <Setter Property="FontFamily"  Value="Segoe UI"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="MinHeight"   Value="44"/>
      <Setter Property="MinWidth"    Value="44"/>
      <Setter Property="Padding"     Value="18,0"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0,0,0,3"
                    BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush"   Value="{DynamicResource FocusRingBrush}"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurf2}"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="2,2,2,3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- tab nav row -->
      <RowDefinition Height="1"/>     <!-- separator -->
      <RowDefinition Height="*"/>     <!-- content -->
      <RowDefinition Height="1"/>     <!-- separator -->
      <RowDefinition Height="Auto"/>  <!-- footer -->
    </Grid.RowDefinitions>

    <!-- ── Tab navigation ──────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal"
                Background="{DynamicResource BrushBar}"
                AutomationProperties.Name="Settings sections">
      <RadioButton x:Name="TabEvent"
                   Style="{StaticResource TabBtn}"
                   IsChecked="True"
                   AutomationProperties.Name="Event Settings"
                   Checked="Tab_Checked" Tag="0"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Settings}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Event Settings" VerticalAlignment="Center"/></StackPanel></RadioButton>
      <RadioButton x:Name="TabCalendar"
                   Style="{StaticResource TabBtn}"
                   AutomationProperties.Name="Calendar Settings"
                   Checked="Tab_Checked" Tag="1"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Calendar}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Calendar Settings" VerticalAlignment="Center"/></StackPanel></RadioButton>
      <RadioButton x:Name="TabEmail"
                   Style="{StaticResource TabBtn}"
                   AutomationProperties.Name="Email Settings"
                   Checked="Tab_Checked" Tag="2"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Smtp}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Email Settings" VerticalAlignment="Center"/></StackPanel></RadioButton>
    </StackPanel>

    <!-- separator -->
    <Rectangle Grid.Row="1" Fill="{DynamicResource BrushSurf2}"/>

    <!-- ── Content ScrollViewer ────────────────────────────────────────────── -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <Grid Margin="20,14,20,14">

        <!-- ══ PANEL 0 — EVENT SETTINGS ══════════════════════════════════════ -->
        <StackPanel x:Name="PnlEventTab" Visibility="Visible">

          <TextBlock Style="{StaticResource SectionHeader}" Text="EVENT TIMER FONT SIZES"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="DateTime / calendar event timers"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Countdown display size"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Large time display on each card"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldEventTimeFontScale"
                    Minimum="0.5" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Event timer countdown font scale"
                    AutomationProperties.HelpText="Adjust in 0.25× steps. Range: 0.5× to 4.0×."
                    ValueChanged="SldEventTimeFontScale_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblEventTimeFontScale"
                       Text="1.00×" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Title font size"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Timer name in the card header"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldEventTitleFontScale"
                    Minimum="0.5" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Event timer title font scale"
                    AutomationProperties.HelpText="Adjust in 0.25× steps. Range: 0.5× to 4.0×."
                    ValueChanged="SldEventTitleFontScale_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblEventTitleFontScale"
                       Text="1.00×" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Separator Margin="0,0,0,12"/>

          <TextBlock Style="{StaticResource SectionHeader}" Text="COUNTDOWN / STOPWATCH FONT SIZES"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Countdown and Stopwatch timers"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Countdown display size"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Large time display on each card"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldTimeFontScale"
                    Minimum="0.5" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Countdown font scale"
                    AutomationProperties.HelpText="Adjust in 0.25× steps. Range: 0.5× to 4.0×."
                    ValueChanged="SldTimeFontScale_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblTimeFontScale"
                       Text="1.00×" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Title font size"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Timer name in the card header"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldTitleFontScale"
                    Minimum="0.5" Maximum="4.0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Title font scale"
                    AutomationProperties.HelpText="Adjust in 0.25× steps. Range: 0.5× to 4.0×."
                    ValueChanged="SldTitleFontScale_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblTitleFontScale"
                       Text="1.00×" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Separator Margin="0,0,0,12"/>

          <TextBlock Style="{StaticResource SectionHeader}" Text="ALERT DEFAULTS"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Applied to all new timers"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Alert sound"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="CboDefaultSound"
                      AutomationProperties.Name="Default alert sound"
                      SelectionChanged="CboDefaultSound_Changed">
              <ComboBoxItem>Beep</ComboBoxItem>
              <ComboBoxItem>Chime</ComboBoxItem>
              <ComboBoxItem>Alarm</ComboBoxItem>
              <ComboBoxItem>Bell</ComboBoxItem>
              <ComboBoxItem>Ping</ComboBoxItem>
              <ComboBoxItem>Silent</ComboBoxItem>
            </ComboBox>
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Alert style"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="CboDefaultStyle"
                      AutomationProperties.Name="Default alert style"
                      SelectionChanged="CboDefaultStyle_Changed">
              <ComboBoxItem>Lens (small popup)</ComboBoxItem>
              <ComboBoxItem>Fullscreen flash</ComboBoxItem>
              <ComboBoxItem>Both</ComboBoxItem>
            </ComboBox>
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Auto-dismiss (seconds)"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="0 = require manual dismiss"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldDefaultFlashSecs"
                    Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Default auto-dismiss seconds"
                    AutomationProperties.HelpText="Use left/right arrow keys. 0 = never auto-dismiss."
                    ValueChanged="SldDefaultFlashSecs_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblDefaultFlashSecs"
                       Text="5 s" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Alert popup text size"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Font size inside the alert popup"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <Slider Grid.Column="1" x:Name="SldDefaultFontSize"
                    Minimum="12" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Default alert font size"
                    AutomationProperties.HelpText="Use left/right arrow keys. Range: 12 to 60 points."
                    ValueChanged="SldDefaultFontSize_Changed"/>
            <TextBlock Grid.Column="2" x:Name="LblDefaultFontSize"
                       Text="22 pt" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Auto-reset by default"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Countdown timers restart automatically after alert"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Grid.Column="1" x:Name="ChkDefaultAutoReset"
                      VerticalAlignment="Center" Margin="8,0,0,0"
                      MinWidth="44" MinHeight="44"
                      AutomationProperties.Name="Auto-reset by default"
                      Checked="ChkDefaultAutoReset_Changed"
                      Unchecked="ChkDefaultAutoReset_Changed"/>
          </Grid>

          <!-- ── Default sort order ── -->
          <Separator Margin="0,0,0,12"/>

          <TextBlock Style="{StaticResource SectionHeader}" Text="SORT ORDER"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Applied on launch and after importing calendar events"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Default sort"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Order of timer cards at startup"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="CboDefaultSort"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Default sort order"
                      SelectionChanged="CboDefaultSort_Changed">
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">None (manual order)</ComboBoxItem>
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">By time remaining (ascending)</ComboBoxItem>
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">By time remaining (descending)</ComboBoxItem>
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">By name (A → Z)</ComboBoxItem>
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">By name (Z → A)</ComboBoxItem>
              <ComboBoxItem ContentTemplate="{StaticResource JtLabelItemTemplate}">By category</ComboBoxItem>
            </ComboBox>
          </Grid>

          <Separator Margin="0,0,0,12"/>

          <!-- ── Feature 6: Auto dark/light theme ── -->
          <TextBlock Style="{StaticResource SectionHeader}" Text="APPEARANCE"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Follow Windows color scheme"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Automatically switch dark/light theme to match Windows Settings"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="ChkThemeAuto"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinWidth="44" MinHeight="44"
                      ToolTip="Match the theme to Windows &quot;Apps use dark mode&quot; setting automatically"
                      AutomationProperties.Name="Follow Windows color scheme"
                      Checked="ChkThemeAuto_Changed"
                      Unchecked="ChkThemeAuto_Changed"/>
          </Grid>

        </StackPanel><!-- /PnlEventTab -->

        <!-- ══ PANEL 1 — CALENDAR SETTINGS ═══════════════════════════════════ -->
        <StackPanel x:Name="PnlCalendarTab" Visibility="Collapsed">

          <!-- DEFAULT CALENDAR -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" Grid.Column="0" Text="DEFAULT CALENDAR"
                       FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
            <!-- Refresh always visible so user can retry after any error -->
            <Button x:Name="BtnRefreshCalendars"
                    Grid.Column="1"
                    Style="{StaticResource FlatButton}"
                    FontSize="{DynamicResource FontSizeCaption}" Padding="10,4" MinHeight="44" MinWidth="44"
                    ToolTip="Re-scan Outlook for calendar folders (Outlook does not need to be open)"
                    AutomationProperties.Name="Refresh Outlook calendar list"
                    Click="BtnRefreshCalendars_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Refresh}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Refresh" VerticalAlignment="Center"/></StackPanel></Button>
          </Grid>
          <TextBlock Text="The default calendar auto-loads in the Import picker and is used for auto-pull."
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>

          <Border x:Name="PnlNoOutlookDefault"
                  Background="{DynamicResource BrushSurf}"
                  BorderBrush="{DynamicResource BrushSurf2}"
                  BorderThickness="1" CornerRadius="4"
                  Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="Outlook is not installed — Outlook calendar features are unavailable."
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"/>
          </Border>

          <Grid x:Name="PnlDefaultCalendar" Visibility="Collapsed" Margin="0,0,0,16">
            <ComboBox x:Name="CboDefaultCalendar"
                      FontSize="{DynamicResource FontSizeCaption}"
                      ToolTip="Choose the default Outlook calendar"
                      AutomationProperties.Name="Default calendar"
                      SelectionChanged="CboDefaultCalendar_SelectionChanged"/>
          </Grid>

          <Separator Margin="0,0,0,12"/>

          <!-- CALENDAR VISIBILITY -->
          <TextBlock Style="{StaticResource SectionHeader}" Text="CALENDAR VISIBILITY"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Unchecked calendars are hidden from auto-pull and the Import picker."
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>

          <Border x:Name="PnlCalVisibility"
                  Background="{DynamicResource BrushSurf}"
                  BorderBrush="{DynamicResource BrushSurf2}"
                  BorderThickness="1" CornerRadius="4"
                  Padding="6,4" Margin="0,0,0,8" Visibility="Collapsed"
                  MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="PnlCalVisList"/>
            </ScrollViewer>
          </Border>

          <TextBlock x:Name="LblCalLoading"
                     Text="Scanning Outlook calendars…"
                     FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                     Foreground="{DynamicResource BrushMuted}"
                     Margin="0,0,0,8" Visibility="Collapsed"/>

          <Separator Margin="0,0,0,12"/>

          <!-- AUTO-PULL -->
          <TextBlock Style="{StaticResource SectionHeader}" Text="AUTO-PULL FROM CALENDAR"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Automatically creates timer cards for upcoming Outlook events. Skips duplicates. Look-ahead and keyword filters apply."
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Enable auto-pull"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Polls all visible calendars on the interval below"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="ChkAutoPull"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="Enable automatic calendar polling"
                      AutomationProperties.Name="Enable auto-pull from calendar"
                      Checked="ChkAutoPull_Changed"
                      Unchecked="ChkAutoPull_Changed"/>
          </Grid>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Poll interval"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            <Slider Grid.Column="2" x:Name="SldPollInterval"
                    Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ToolTip="How often to check for new calendar events."
                    AutomationProperties.Name="Calendar poll interval slider"
                    AutomationProperties.HelpText="Adjust in 5-minute steps. Range: 5 to 120 minutes."
                    ValueChanged="SldPollInterval_Changed"/>
            <TextBlock Grid.Column="3" x:Name="LblPollInterval"
                       Text="15 min" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>

          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblLastPulled"
                       Grid.Column="0"
                       Text="Last pulled: never"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnPullNow"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Padding="12,6" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44" MinWidth="44"
                    ToolTip="Pull calendar events immediately"
                    AutomationProperties.Name="Pull calendar events now"
                    Click="BtnPullNow_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Pull Now" VerticalAlignment="Center"/></StackPanel></Button>
          </Grid>

          <Separator Margin="0,12,0,12"/>

          <!-- IMPORT FILTERS -->
          <TextBlock Style="{StaticResource SectionHeader}" Text="IMPORT FILTERS"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Applies to both auto-pull and the manual Import picker."
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Look-ahead window"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Skip events that start further out than this"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <TextBox x:Name="TxtLookahead"
                     Grid.Column="2"
                     FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0" Text="30"
                     ToolTip="Only import events starting within this many days from now (1–365)."
                     AutomationProperties.Name="Calendar look-ahead days"
                     AutomationProperties.HelpText="Enter a number from 1 to 365."
                     LostFocus="TxtLookahead_LostFocus"/>
            <TextBlock Grid.Column="3"
                       Text=" days"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
          </Grid>

          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Exclude events containing these words"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtExcludeKeywords"
                     FontSize="{DynamicResource FontSizeCaption}" MinHeight="0"
                     ToolTip="Comma-separated keywords (not case-sensitive). Events with any of these words in the title are not imported."
                     AutomationProperties.Name="Exclude keywords"
                     LostFocus="TxtExcludeKeywords_LostFocus"/>
            <TextBlock Text="Comma-separated — e.g.  Cancelled, Hold, OOO"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                       TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Skip birthday calendars"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Excludes Birthdays calendars from auto-pull and import"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="ChkHideBirthdays"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="Skip any calendar whose name contains 'Birthday'"
                      AutomationProperties.Name="Skip birthday calendars"
                      Checked="ChkCalTypeFilter_Changed"
                      Unchecked="ChkCalTypeFilter_Changed"/>
          </Grid>

          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Skip holiday calendars"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Excludes US Holidays and similar calendars"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="ChkHideHolidays"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="Skip any calendar whose name contains 'Holiday'"
                      AutomationProperties.Name="Skip holiday calendars"
                      Checked="ChkCalTypeFilter_Changed"
                      Unchecked="ChkCalTypeFilter_Changed"/>
          </Grid>

          <Separator Margin="0,12,0,12"/>

          <!-- CALENDAR EVENT DEFAULTS -->
          <TextBlock Style="{StaticResource SectionHeader}" Text="CALENDAR EVENT DEFAULTS"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,4"/>
          <TextBlock Text="Applied to every timer card created from a calendar event (auto-pull or import). Per-card settings override these."
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,10"/>

          <!-- Popup position -->
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Popup position"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
            <Grid Width="138" HorizontalAlignment="Left">
              <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="44"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="SdBtnCalEvtPosTopLeft"   Grid.Row="0" Grid.Column="0" Content="↖" Tag="0" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Top left"    AutomationProperties.Name="Default popup position: Top left"/>
              <Button x:Name="SdBtnCalEvtPosTopCenter" Grid.Row="0" Grid.Column="1" Content="↑" Tag="1" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Top center"  AutomationProperties.Name="Default popup position: Top center"/>
              <Button x:Name="SdBtnCalEvtPosTopRight"  Grid.Row="0" Grid.Column="2" Content="↗" Tag="2" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Top right"   AutomationProperties.Name="Default popup position: Top right"/>
              <Button x:Name="SdBtnCalEvtPosMidLeft"   Grid.Row="1" Grid.Column="0" Content="←" Tag="3" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Middle left" AutomationProperties.Name="Default popup position: Middle left"/>
              <Button x:Name="SdBtnCalEvtPosCenter"    Grid.Row="1" Grid.Column="1" Content="·" Tag="4" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Center"      AutomationProperties.Name="Default popup position: Center"/>
              <Button x:Name="SdBtnCalEvtPosMidRight"  Grid.Row="1" Grid.Column="2" Content="→" Tag="5" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Middle right" AutomationProperties.Name="Default popup position: Middle right"/>
              <Button x:Name="SdBtnCalEvtPosBotLeft"   Grid.Row="2" Grid.Column="0" Content="↙" Tag="6" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Bottom left"  AutomationProperties.Name="Default popup position: Bottom left"/>
              <Button x:Name="SdBtnCalEvtPosBotCenter" Grid.Row="2" Grid.Column="1" Content="↓" Tag="7" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Bottom center" AutomationProperties.Name="Default popup position: Bottom center"/>
              <Button x:Name="SdBtnCalEvtPosBotRight"  Grid.Row="2" Grid.Column="2" Content="↘" Tag="8" Style="{StaticResource FlatButton}" FontSize="14" Padding="0" MinHeight="44" MinWidth="44" Click="BtnSdCalEvtPos_Click" ToolTip="Bottom right (default)" AutomationProperties.Name="Default popup position: Bottom right (default)"/>
            </Grid>
          </StackPanel>

          <!-- Alert duration -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Alert duration"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Auto-dismiss after this many seconds (0 = manual)"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <TextBox x:Name="SdTxtCalEvtFlashSeconds"
                     Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0"
                     ToolTip="Seconds before the alert auto-dismisses. 0 = must dismiss manually."
                     AutomationProperties.Name="Calendar event default alert duration in seconds"
                     LostFocus="TxtSdCalEvtFlashSeconds_LostFocus"/>
            <TextBlock Grid.Column="3" Text=" sec" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </Grid>

          <!-- Alert repeat limit -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Alert repeat limit"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Max repeats after first alert (0 = unlimited)"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <TextBox x:Name="SdTxtCalEvtAlertRepeatLimit"
                     Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0"
                     ToolTip="Maximum number of times the alert sound repeats. 0 = no limit."
                     AutomationProperties.Name="Calendar event default alert repeat limit"
                     LostFocus="TxtSdCalEvtAlertRepeatLimit_LostFocus"/>
            <TextBlock Grid.Column="3" Text=" times" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </Grid>

          <!-- Escalate to fullscreen -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Escalate to fullscreen after"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Switches to fullscreen flash if not dismissed (0 = off)"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <TextBox x:Name="SdTxtCalEvtEscalateAfterSeconds"
                     Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0"
                     ToolTip="Seconds after the first alert before escalating to a fullscreen flash. 0 = never."
                     AutomationProperties.Name="Calendar event default escalate to fullscreen seconds"
                     LostFocus="TxtSdCalEvtEscalateAfterSeconds_LostFocus"/>
            <TextBlock Grid.Column="3" Text=" sec" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </Grid>

          <!-- Hide from pill -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Hide from pill strip"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Calendar event timers excluded from the compact pill overlay"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="SdChkCalEvtExcludeFromPill"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="When checked, calendar event timers are hidden from the pill strip by default"
                      AutomationProperties.Name="Calendar event default hide from pill strip"
                      Checked="ChkSdCalEvt_Changed" Unchecked="ChkSdCalEvt_Changed"/>
          </Grid>

          <!-- Early reminder -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Enable early reminder"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Show a reminder popup before the event starts"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="SdChkCalEvtReminderEnabled"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="When checked, calendar event timers will show an early reminder by default"
                      AutomationProperties.Name="Calendar event default enable early reminder"
                      Checked="ChkSdCalEvt_Changed" Unchecked="ChkSdCalEvt_Changed"/>
          </Grid>

          <Border x:Name="SdPnlCalEvtReminderDetails"
                  Margin="0,0,0,8" Padding="10,8,10,6"
                  Background="{DynamicResource BrushSurf}"
                  BorderBrush="{DynamicResource BrushSurf2}"
                  BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start reminding before event"
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}"/>
                <TextBox x:Name="SdTxtCalEvtReminderLeadMinutes"
                         Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0"
                         ToolTip="How many minutes before the event start time to show the first reminder."
                         AutomationProperties.Name="Calendar event default reminder lead minutes"
                         LostFocus="TxtSdCalEvtReminderLeadMinutes_LostFocus"/>
                <TextBlock Grid.Column="3" Text=" min" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="60"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Repeat reminder every"
                             FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
                  <TextBlock Text="0 = show once only"
                             FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
                </StackPanel>
                <TextBox x:Name="SdTxtCalEvtReminderIntervalMinutes"
                         Grid.Column="2" FontSize="{DynamicResource FontSizeCaption}" TextAlignment="Right" MinHeight="0"
                         ToolTip="Repeat the reminder popup this many minutes apart. 0 = show once only."
                         AutomationProperties.Name="Calendar event default reminder repeat interval minutes"
                         LostFocus="TxtSdCalEvtReminderIntervalMinutes_LostFocus"/>
                <TextBlock Grid.Column="3" Text=" min" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Send email on reminder -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Send email on reminders"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,2"/>
              <TextBlock Text="Requires email alerts to be configured"
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
            </StackPanel>
            <CheckBox x:Name="SdChkCalEvtSendEmailOnReminder"
                      Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                      MinHeight="44" MinWidth="44"
                      ToolTip="When checked, calendar event timers send an email for each reminder by default"
                      AutomationProperties.Name="Calendar event default send email on reminders"
                      Checked="ChkSdCalEvt_Changed" Unchecked="ChkSdCalEvt_Changed"/>
          </Grid>

        </StackPanel><!-- /PnlCalendarTab -->

        <!-- ══ PANEL 2 — EMAIL SETTINGS ══════════════════════════════════════ -->
        <StackPanel x:Name="PnlEmailTab" Visibility="Collapsed">

          <!-- TS-10: shared control (Controls/EmailSettingsPanel.xaml) -->
          <ctl:EmailSettingsPanel x:Name="EmailPanel"/>

        </StackPanel><!-- /PnlEmailTab -->

      </Grid>
    </ScrollViewer>

    <!-- separator -->
    <Rectangle Grid.Row="3" Fill="{DynamicResource BrushSurf2}"/>

    <!-- ── Footer bar ───────────────────────────────────────────────────────── -->
    <Border Grid.Row="4" Background="{DynamicResource BrushBar}"
            BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,1,0,0"
            Padding="16,10,52,10">
      <Button x:Name="BtnDone"
              Content="Done"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Right"
              Padding="24,8" MinHeight="44" IsDefault="True" IsCancel="True"
              AutomationProperties.Name="Close settings"
              Click="BtnDone_Click"/>
    </Border>


  <!-- WCAG 2.2 AAA: shared 44x44 keyboard + mouse resize grip (Controls/AccessibleResizeGrip.cs) -->
  <ctl:AccessibleResizeGrip/>
  </Grid>
</Window>
