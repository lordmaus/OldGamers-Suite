<Window x:Class="TimerStudio.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Manage Categories"
        Width="380" Height="460"
        MinWidth="300" MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Manage Categories">

  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.FolderGear}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Style="{StaticResource DialogTitle}" Text="Manage Categories" VerticalAlignment="Center"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="15" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"/></StackPanel>
      <TextBlock Text="Add, rename, or remove category labels. Colours are assigned automatically."
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushMuted}"
                 Margin="0,3,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Category list -->
    <ListView x:Name="LstCategories"
              Grid.Row="2"
              Background="{DynamicResource BrushSurf}"
              BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="1"
              FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
              Foreground="{DynamicResource BrushText}"
              SelectionMode="Single"
              AutomationProperties.Name="Category list">

      <!-- Force every row to use theme text colour, not the system default.
           L-4: also themes selection/hover — the default template paints
           IsSelected/IsMouseOver with system Highlight colours, which fail
           contrast against several dark themes. -->
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Foreground"
                  Value="{DynamicResource BrushText}"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="2,4"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <Grid>
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="Transparent" BorderThickness="4,0,0,0"
                          Padding="{TemplateBinding Padding}"
                          SnapsToDevicePixels="True">
                    <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                          Content="{TemplateBinding Content}"/>
                  </Border>
                  <Border x:Name="FocusRing"
                          BorderBrush="{DynamicResource FocusRingBrush}"
                          BorderThickness="2" Margin="-1" Opacity="0"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <!-- WCAG AAA (F4): hover/selected use Surf2 (text 7:1) + a 4px left bar so the
                       state is not colour-only. BrushHint is text-strength now — never a fill. -->
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected"  Value="True"/>
                      <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                  </MultiTrigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.View>
        <GridView>
          <!-- Colour dot column — WCAG 1.4.1: AutomationProperties.Name
               conveys the category name so colour is not the sole indicator. -->
          <GridViewColumn Width="36">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <Ellipse Width="14" Height="14"
                         Fill="{Binding Color}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding Name, StringFormat='Category colour for {0}'}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>

          <!-- Change color button column: fixed swatches icon + the user's colour -->
          <GridViewColumn Width="56">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <Button Height="44"
                        ToolTip="Change category colour"
                        AutomationProperties.Name="Change colour"
                        Tag="{Binding Name}"
                        Click="BtnChangeColor_Click"
                        Padding="0" MinHeight="44" MinWidth="44"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource BrushSurf2}"
                        Cursor="Hand">
                  <StackPanel Orientation="Horizontal" Margin="3,0">
                    <Image Source="{StaticResource JtIcon.Swatches}" Style="{StaticResource JtMenuIcon}"/>
                    <Ellipse Width="10" Height="10" Margin="3,0,0,0" VerticalAlignment="Center" Fill="{Binding Color}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>

          <!-- Name column — explicit TextBlock with theme foreground -->
          <GridViewColumn Width="160">
            <GridViewColumn.Header>
              <TextBlock Text="Name"
                         Foreground="{DynamicResource BrushText}"
                         FontWeight="SemiBold"/>
            </GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>

          <!-- Timers count column -->
          <GridViewColumn Width="60">
            <GridViewColumn.Header>
              <TextBlock Text="Timers"
                         Foreground="{DynamicResource BrushText}"
                         FontWeight="SemiBold"/>
            </GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TimerCount}"
                           Foreground="{DynamicResource BrushMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>

    <!-- Add / rename / delete row -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="TxtCategoryName"
               Grid.Column="0"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
               Padding="6,4" MinHeight="0"
               ToolTip="Category name"
               AutomationProperties.Name="New category name"
               KeyDown="TxtCategoryName_KeyDown"/>
      <Button Grid.Column="2" x:Name="BtnAddCategory"
              Style="{StaticResource PrimaryButton}"
              Padding="14,5" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
              ToolTip="Add new category"
              AutomationProperties.Name="Add category"
              Click="BtnAddCategory_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.NewCategory}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Add" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="4" x:Name="BtnRenameCategory"
              Style="{StaticResource FlatButton}"
              Padding="10,5" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
              IsEnabled="False"
              ToolTip="Rename selected category"
              AutomationProperties.Name="Rename selected category"
              Click="BtnRenameCategory_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rename}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Rename" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="6" x:Name="BtnDeleteCategory"
              Style="{StaticResource FlatButton}"
              Foreground="{DynamicResource BrushRedText}"
              Padding="10,5" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
              IsEnabled="False"
              ToolTip="Delete selected category (timers become uncategorised)"
              AutomationProperties.Name="Delete selected category"
              Click="BtnDeleteCategory_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>

    <!-- Close -->
    <Button Grid.Row="6"
            Content="Done"
            Style="{StaticResource PrimaryButton}"
            HorizontalAlignment="Right" Margin="0,0,26,0"
            Padding="24,7" IsDefault="True" IsCancel="True"
            AutomationProperties.Name="Close category manager"
            Click="BtnDone_Click"/>

  <!-- WCAG 2.2 AAA: shared 44x44 keyboard + mouse resize grip (Controls/AccessibleResizeGrip.cs) -->
  <sh:AccessibleResizeGrip Margin="0,0,-18,-14"/>
  </Grid>
</Window>
