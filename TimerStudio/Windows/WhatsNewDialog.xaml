<Window x:Class="TimerStudio.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="What's New in Timer Studio"
        Width="480" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="What's New in Timer Studio">

  <StackPanel Margin="32,28,32,28">

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource JtIcon.GettingStarted}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Style="{StaticResource DialogTitle}" Text="What's New" VerticalAlignment="Center"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource BrushBlueText}"/></StackPanel>
    <TextBlock x:Name="LblVersion"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,2,0,0"/>

    <Separator Margin="0,14,0,14"/>

    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Date / Time countdown mode"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Set a specific date and time as a target. The timer counts down to that exact moment and alerts when it arrives."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Collapsible timer cards"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Click ▾ in the header to collapse a timer to just its name. Collapse state persists across restarts."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Timer persistence"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="All timers and their settings are automatically saved and restored when you restart the app."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Export &amp; Import"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Back up your timers or move them between machines using Export / Import in the About dialog."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Popup position &amp; multi-monitor"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Choose from 9 popup positions (corners, edges, center). The popup follows your cursor's monitor and respects per-monitor DPI scaling."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Alert style options"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Choose between Lens (small popup), Fullscreen flash, or Both. Configure duration, auto-dismiss, and auto-reset per timer."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard shortcut: Ctrl+N"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <TextBlock Text="Press Ctrl+N anywhere in the main window to quickly add a new timer."
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

      </StackPanel>
    </ScrollViewer>

    <Separator Margin="0,14,0,14"/>

    <Button Content="Got it!" Style="{StaticResource PrimaryButton}"
            HorizontalAlignment="Center" Padding="40,8"
            IsCancel="True" IsDefault="True"
            AutomationProperties.Name="Close What's New dialog"
            Click="CloseBtn_Click"/>


  <!-- WCAG 2.2 AAA: shared 44x44 keyboard + mouse resize grip (Controls/AccessibleResizeGrip.cs) -->
  <sh:AccessibleResizeGrip Margin="0,0,-32,-28"/>
  </StackPanel>
</Window>
