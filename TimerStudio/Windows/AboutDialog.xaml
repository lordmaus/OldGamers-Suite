<Window x:Class="TimerStudio.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="About Timer Studio"
        Width="540" Height="640" MinWidth="500" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="About Timer Studio"
        AutomationProperties.HelpText="About information, version, links, and donation options for Timer Studio">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,28,24">

    <!-- Logo / Title -->
    <TextBlock Style="{StaticResource DialogTitle}" Text="⏱ Timer Studio"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="22" FontWeight="Bold"
               Foreground="{DynamicResource BrushBlueText}"
               HorizontalAlignment="Center"/>
    <TextBlock Text="Multi-timer application with alerts for Windows"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,2,0,0"/>

    <Separator Margin="0,14,0,14"/>

    <!-- Info grid -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionLabel"
                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 AutomationProperties.Name="Application version number"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Created by"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Matthew Pittman"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Platform"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="4" Grid.Column="1"
                 Text="Windows · WPF · .NET 10"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <TextBlock Grid.Row="6" Grid.Column="0" Text="Settings file"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical">
        <TextBlock x:Name="SettingsPathLabel"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Path to saved timers file"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3"
                  MinHeight="44"
                  ToolTip="Copy settings file path to clipboard"
                  AutomationProperties.Name="Copy settings file path to clipboard"
                  AutomationProperties.HelpText="Copies the path to timers.json to the clipboard"
                  Click="CopySettingsPathBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Copy path" VerticalAlignment="Center"/></StackPanel></Button>
          <Button
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3" Margin="6,0,0,0"
                  MinHeight="44"
                  ToolTip="Export timers to a JSON file for backup or transfer"
                  AutomationProperties.Name="Export timers to JSON file"
                  AutomationProperties.HelpText="Saves all timer configurations to a file you choose"
                  Click="ExportBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Export}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Export" VerticalAlignment="Center"/></StackPanel></Button>
          <Button
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3" Margin="6,0,0,0"
                  MinHeight="44"
                  ToolTip="Import timers from a previously exported JSON file"
                  AutomationProperties.Name="Import timers from JSON file"
                  AutomationProperties.HelpText="Loads timer configurations from a file, replacing current timers"
                  Click="ImportBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Import" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </StackPanel>

      <!-- Website -->
      <TextBlock Grid.Row="8" Grid.Column="0" Text="Website"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="8" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="https://oldgamerssoftware.com/"
                 AutomationProperties.Name="Open Old Gamers Software website"
                 AutomationProperties.HelpText="Opens oldgamerssoftware.com in your default browser"
                 Click="WebsiteBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Web}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="oldgamerssoftware.com" VerticalAlignment="Center"/></StackPanel></Button>

      <!-- GitHub -->
      <TextBlock Grid.Row="10" Grid.Column="0" Text="GitHub"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="10" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="https://github.com/lordmaus/TimerStudio"
                 AutomationProperties.Name="View Timer Studio on GitHub"
                 AutomationProperties.HelpText="Opens the TimerStudio GitHub repository in your browser"
                 Click="GitHubBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Link}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="GitHub" VerticalAlignment="Center"/></StackPanel></Button>

      <TextBlock Grid.Row="12" Grid.Column="0" Text="Start with Windows"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <CheckBox  Grid.Row="12" Grid.Column="1" x:Name="ChkStartup"
                 Content="Launch at Windows startup"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 VerticalAlignment="Center"
                 ToolTip="Add Timer Studio to Windows startup so it launches automatically when you log in"
                 AutomationProperties.Name="Launch Timer Studio at Windows startup"
                 AutomationProperties.HelpText="When checked, Timer Studio starts automatically when you log in to Windows"
                 Click="ChkStartup_Click"/>

      <TextBlock Grid.Row="14" Grid.Column="0" Text="Help"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="14" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="Opens README.md in your default text editor"
                 AutomationProperties.Name="Open README help file"
                 AutomationProperties.HelpText="Opens the README documentation in your default text editor"
                 Click="ReadmeBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.File}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Open README" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>

    <Separator Margin="0,14,0,14"/>

    <!-- Description -->
    <TextBlock FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushText}"
               TextWrapping="Wrap" TextAlignment="Center"
               Text="Timer Studio lets you run multiple named countdown timers, stopwatches, and date/time targets simultaneously, each with custom alert colors, sounds, font sizes, and popup styles. Timers persist across restarts."/>

    <Separator Margin="0,14,0,14"/>

    <!-- Donate -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="☕  Donate / Buy Me a Coffee"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="13" FontWeight="SemiBold"
               Foreground="{DynamicResource BrushBlueText}"
               HorizontalAlignment="Center" Margin="0,0,0,8"/>
    <TextBlock Text="If Timer Studio is useful to you, consider a small donation!"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="💙  Venmo"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,9" Margin="0,0,12,0"
              MinHeight="44"
              ToolTip="Donate via Venmo: @Matthew-Pittman-80"
              AutomationProperties.Name="Donate via Venmo"
              AutomationProperties.HelpText="Opens the Venmo donation page in your browser"
              Click="VenmoBtn_Click"/>
      <Button Content="💚  Cash App"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,9"
              MinHeight="44"
              ToolTip="Donate via Cash App: $MatthewPittman80"
              AutomationProperties.Name="Donate via Cash App"
              AutomationProperties.HelpText="Opens the Cash App donation page in your browser"
              Click="CashAppBtn_Click"/>
    </StackPanel>

    <Separator Margin="0,14,0,14"/>

    <!-- Privacy Notice -->
    <Border Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushBlue}"
            BorderThickness="0,0,0,2"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,14"
            AutomationProperties.Name="Privacy notice">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="&#x1F512;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy — what this app does NOT do"
                     FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6"
                   Text="Timer Studio never: collects, stores, or transmits usage data · requires an account · makes network calls (no telemetry, no analytics, no update pings) · stores files outside %APPDATA%\TimerStudio."/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6"
                   Text="The only outbound network activity occurs when YOU click a link in this dialog (website, GitHub, Venmo, Cash App). That opens your default browser — Timer Studio itself makes no HTTP calls."/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6">
          <Run FontWeight="SemiBold">Data stored locally:</Run>
          <Run>Timer configurations (name, duration, alert settings, notes) are saved to </Run>
          <Run FontStyle="Italic">timers.json</Run>
          <Run> in your AppData folder. This file never leaves your device.</Run>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6">
          <Run FontWeight="SemiBold">Calendar import:</Run>
          <Run>ICS files and Outlook calendar data are read into memory only and are not stored on disk.</Run>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}">
          <Run FontWeight="SemiBold">GDPR legal basis:</Run>
          <Run>Processing is based on your consent (you chose to install and use this application). You may delete all stored data at any time by removing the AppData\TimerStudio folder or using the Uninstaller.</Run>
        </TextBlock>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>

  <!-- Sticky footer bar -->
  <Border Grid.Row="1" Background="{DynamicResource BrushBar}" Padding="16,10">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Close" Style="{StaticResource PrimaryButton}"
              Padding="40,8" MinHeight="44"
              IsCancel="True" IsDefault="True"
              AutomationProperties.Name="Close About dialog"
              AutomationProperties.HelpText="Close this dialog. Keyboard shortcut: Escape or Enter"
              Click="CloseBtn_Click"/>
    </StackPanel>
  </Border>

  <!-- WCAG 2.2 AAA: shared 44x44 keyboard + mouse resize grip (Controls/AccessibleResizeGrip.cs) -->
  <sh:AccessibleResizeGrip/>
  </Grid>
</Window>
