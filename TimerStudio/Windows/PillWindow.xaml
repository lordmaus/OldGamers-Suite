<Window x:Class="TimerStudio.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer Studio — Pill"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Height="48"
        SizeToContent="Width"
        MinWidth="160"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="Timer Studio compact pill window"
        Closing="PillWindow_Closing">

  <!-- Rounded pill container. MouseLeftButtonDown → DragMove so user can reposition.
       Keyboard: Alt+Arrow moves; Shift+F10 / right-click → "Move with keyboard" (KeyboardWindowMover). -->
  <Border x:Name="PillRoot"
          Background="#CC1e1e2e"
          CornerRadius="24"
          MouseLeftButtonDown="PillRoot_MouseLeftButtonDown"
          Cursor="SizeAll">
    <DockPanel LastChildFill="True">

      <!-- Close button pinned to the right -->
      <Button x:Name="BtnClose"
              DockPanel.Dock="Right"
              Content="✕"
              Background="Transparent"
              BorderThickness="0"
              Foreground="#CCFFFFFF"
              FontSize="{DynamicResource FontSizeCaption}"
              Padding="10,0,12,0"
              Height="48" MinWidth="44"
              Cursor="Hand"
              Click="BtnClose_Click"
              ToolTip="Close pill window"
              AutomationProperties.Name="Close pill window"/>

      <!-- Separator line -->
      <Rectangle DockPanel.Dock="Right"
                 Width="1" Fill="#44FFFFFF"
                 VerticalAlignment="Stretch" Margin="0,8,0,8"/>

      <!-- Pill app icon / label -->
      <TextBlock DockPanel.Dock="Left"
                 Text="⏱"
                 FontSize="16"
                 Foreground="#CCFFFFFF"
                 VerticalAlignment="Center"
                 Margin="14,0,6,0"/>

      <!-- Running timer items — populated in code-behind -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Focusable="False">
        <StackPanel x:Name="PillItems"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="4,0,4,0"/>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
