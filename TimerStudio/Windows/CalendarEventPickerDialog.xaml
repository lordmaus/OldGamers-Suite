<Window x:Class="TimerStudio.CalendarEventPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Import Calendar Events"
        Width="560" Height="580"
        MinWidth="420" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Import Calendar Events">

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Header -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>  <!-- Source buttons -->
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>  <!-- Calendar picker row (Outlook only) -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>  <!-- Selection bar -->
      <RowDefinition Height="6"/>
      <RowDefinition Height="*"/>     <!-- Event list / loading -->
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>  <!-- Detail panel -->
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>  <!-- Buttons -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Calendar}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Style="{StaticResource DialogTitle}" Text="Import Calendar Events" VerticalAlignment="Center"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}"/></StackPanel>
      <TextBlock x:Name="LblSubtitle"
                 Text="Choose a source, then select events to import as timers."
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushMuted}"
                 Margin="0,3,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Source buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <Button x:Name="BtnImportIcs"
              Style="{StaticResource FlatButton}"
              Padding="12,7" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,8,0"
              ToolTip="Browse for an exported .ics calendar file"
              AutomationProperties.Name="Browse for ICS calendar file"
              Click="BtnImportIcs_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="ICS / Calendar File" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="BtnImportOutlook"
              Style="{StaticResource FlatButton}"
              Padding="12,7" FontSize="{DynamicResource FontSizeCaption}"
              ToolTip="Choose a calendar from Outlook"
              AutomationProperties.Name="Choose Outlook Calendar"
              Click="BtnImportOutlook_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Smtp}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Outlook Calendar" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock x:Name="LblOutlookStatus"
                 Text="" FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                 Foreground="{DynamicResource BrushMuted}"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
    </StackPanel>

    <!-- Outlook calendar picker row — visible after Outlook button clicked -->
    <Border Grid.Row="4"
            x:Name="PnlCalendarPicker"
            Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushSurf2}"
            BorderThickness="1" CornerRadius="4"
            Padding="10,8" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="Calendar:"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="CboCalendars"
                  Grid.Column="1"
                  FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                  ToolTip="Select which Outlook calendar to load events from"
                  AutomationProperties.Name="Select Outlook calendar"
                  SelectionChanged="CboCalendars_SelectionChanged"/>
        <Button x:Name="BtnLoadEvents"
                Grid.Column="3"
                Content="Load Events"
                Style="{StaticResource PrimaryButton}"
                Padding="12,5" FontSize="{DynamicResource FontSizeCaption}"
                IsEnabled="False"
                AutomationProperties.Name="Load events from selected calendar"
                Click="BtnLoadEvents_Click"/>
      </Grid>
    </Border>

    <!-- Select-all bar -->
    <Grid Grid.Row="6" x:Name="PnlSelectionBar" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="Tick events to import  (Ctrl+A selects all)"
                 FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                 Foreground="{DynamicResource BrushMuted}"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="BtnSelectAll"
              Content="Select All"
              Style="{StaticResource FlatButton}"
              FontSize="{DynamicResource FontSizeCaption}" Padding="8,3" MinHeight="44"
              AutomationProperties.Name="Select all events"
              Click="BtnSelectAll_Click"/>
      <Button Grid.Column="3" x:Name="BtnSelectNone"
              Content="Clear"
              Style="{StaticResource FlatButton}"
              FontSize="{DynamicResource FontSizeCaption}" Padding="8,3" MinHeight="44"
              AutomationProperties.Name="Clear selection"
              Click="BtnSelectNone_Click"/>
    </Grid>

    <!-- Loading indicator -->
    <TextBlock x:Name="LblLoading"
               Grid.Row="8"
               Text="Loading…"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Collapsed"/>

    <!-- Event list -->
    <ListView x:Name="LstEvents"
              Grid.Row="8"
              Background="{DynamicResource BrushSurf}"
              BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="1"
              FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
              SelectionMode="Extended"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              MouseDoubleClick="LstEvents_DoubleClick"
              AutomationProperties.Name="Calendar events list"
              AutomationProperties.HelpText="Check events to import. Double-click to import one immediately.">
      <ListView.ItemContainerStyle>
        <!-- L-4: themed selection/hover — the default template paints
             IsSelected/IsMouseOver with system Highlight colours, which
             fail contrast against several dark themes. -->
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding"                    Value="4,3"/>
          <Setter Property="Background"                 Value="Transparent"/>
          <Setter Property="FocusVisualStyle"            Value="{x:Null}"/>
          <EventSetter Event="PreviewMouseLeftButtonDown"
                       Handler="LstItem_PreviewMouseDown"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <Grid>
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="Transparent" BorderThickness="4,0,0,0"
                          Padding="{TemplateBinding Padding}"
                          SnapsToDevicePixels="True">
                    <ContentPresenter/>
                  </Border>
                  <Border x:Name="FocusRing"
                          BorderBrush="{DynamicResource FocusRingBrush}"
                          BorderThickness="2" Margin="-1" Opacity="0"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <!-- WCAG AAA (F4): hover/selected use Surf2 (text 7:1) + a 4px left bar so the
                       state is not colour-only. BrushHint is text-strength now — never a fill. -->
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected"  Value="True"/>
                      <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                  </MultiTrigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      IsChecked="{Binding IsSelected,
                          RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                      Focusable="False"
                      AutomationProperties.Name="Select this event"/>
            <StackPanel Grid.Column="1" Margin="0,3,0,3">
              <TextBlock Text="{Binding Summary}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushText}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding StartLocal,
                             StringFormat='ddd, MMM d yyyy  h:mm tt'}"
                         Foreground="{DynamicResource BrushMuted}"
                         FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Location}"
                         Foreground="{DynamicResource BrushMuted}"
                         FontSize="{DynamicResource FontSizeCaption}" FontStyle="Italic"
                         Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Selection summary -->
    <Border Grid.Row="10"
            x:Name="PnlDetail"
            Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushBlue}"
            BorderThickness="1" CornerRadius="4"
            Padding="10,8" Visibility="Collapsed">
      <TextBlock x:Name="LblDetailSummary"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- Action buttons -->
    <Grid Grid.Row="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LblCount"
                 Grid.Column="0" Text=""
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                 VerticalAlignment="Center"/>
      <Button x:Name="BtnCancel"
              Grid.Column="2" Content="Cancel"
              Style="{StaticResource FlatButton}"
              Padding="20,7" IsCancel="True"
              AutomationProperties.Name="Cancel import"
              Click="BtnCancel_Click"/>
      <Button x:Name="BtnImport"
              Grid.Column="4"
              Style="{StaticResource PrimaryButton}"
              Padding="20,7" IsEnabled="False" Margin="0,0,24,0"
              AutomationProperties.Name="Import selected events"
              Click="BtnImport_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Import (0 selected)" VerticalAlignment="Center" x:Name="BtnImportText"/></StackPanel></Button>
    </Grid>

  <!-- WCAG 2.2 AAA: shared 44x44 keyboard + mouse resize grip (Controls/AccessibleResizeGrip.cs) -->
  <sh:AccessibleResizeGrip Margin="0,0,-20,-16"/>
  </Grid>
</Window>
