<Window x:Class="TimerStudio.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TimerStudio.Controls"
        Title="Clock — Timer Studio"
        Width="480" Height="260"
        MinWidth="280" MinHeight="160"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

  <Border x:Name="RootBorder"
          Background="{DynamicResource BrushSurf}"
          CornerRadius="12"
          BorderBrush="{DynamicResource BrushSurf2}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- title / drag bar (44px targets) -->
        <RowDefinition Height="*"/>    <!-- time display -->
        <RowDefinition Height="Auto"/> <!-- date display -->
        <RowDefinition Height="Auto"/> <!-- size controls + resize grip -->
      </Grid.RowDefinitions>

      <!-- ── Drag handle / title bar ── -->
      <Grid Grid.Row="0" MinHeight="44"
            MouseLeftButtonDown="TitleBar_MouseDown"
            Cursor="SizeAll">
        <TextBlock Text="🕐 Clock"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,4,0">
          <ToggleButton x:Name="TglSeconds"
                        Content="s"
                        Width="44" Height="44"
                        FontSize="{DynamicResource FontSizeCaption}" Padding="0"
                        MinHeight="44" MinWidth="44"
                        IsChecked="True"
                        ToolTip="Toggle seconds display"
                        Click="TglSeconds_Click"
                        AutomationProperties.Name="Toggle seconds"/>
          <ToggleButton x:Name="Tgl24h"
                        Content="24h"
                        Width="44" Height="44"
                        FontSize="{DynamicResource FontSizeCaption}" Padding="0"
                        MinHeight="44" MinWidth="44"
                        Margin="2,0,0,0"
                        IsChecked="False"
                        ToolTip="Toggle 12h/24h format"
                        Click="Tgl24h_Click"
                        AutomationProperties.Name="Toggle 24-hour format"/>
          <Button x:Name="BtnClose"
                  Content="✕"
                  Width="44" Height="44"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="0"
                  MinHeight="44" MinWidth="44"
                  Margin="2,0,0,0"
                  ToolTip="Close clock"
                  Click="BtnClose_Click"
                  AutomationProperties.Name="Close clock window"/>
        </StackPanel>
      </Grid>

      <!-- ── Time display (fills remaining height) ── -->
      <TextBlock x:Name="LblTime"
                 Grid.Row="1"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 FontSize="72" FontWeight="Bold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource BrushText}"
                 AutomationProperties.Name="Current time"
                 AutomationProperties.LiveSetting="Off"/>

      <!-- ── Date display ── -->
      <TextBlock x:Name="LblDate"
                 Grid.Row="2"
                 FontSize="13"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource BrushMuted}"
                 Margin="0,0,0,4"/>

      <!-- ── Size controls + resize grip ── -->
      <Grid Grid.Row="3" Margin="10,2,4,4">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">

          <!-- Time font size -->
          <TextBlock Text="T"
                     FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                     Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center"
                     ToolTip="Time font size"
                     Margin="0,0,4,0"/>
          <Slider x:Name="SldTimeSize"
                  Minimum="20" Maximum="160" Value="72"
                  Width="90" VerticalAlignment="Center"
                  TickFrequency="4" IsSnapToTickEnabled="True"
                  ValueChanged="SldTimeSize_Changed"
                  AutomationProperties.Name="Time font size"
                  ToolTip="Time font size"/>

          <!-- Date font size -->
          <TextBlock Text="D"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center"
                     ToolTip="Date font size"
                     Margin="10,0,4,0"/>
          <Slider x:Name="SldDateSize"
                  Minimum="8" Maximum="32" Value="13"
                  Width="70" VerticalAlignment="Center"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="SldDateSize_Changed"
                  AutomationProperties.Name="Date font size"
                  ToolTip="Date font size"/>
        </StackPanel>

        <!-- Single explicit resize grip: 44x44, drag or arrow keys (Controls/AccessibleResizeGrip).
             Keyboard move/resize for the whole borderless window: Alt+Arrow / Ctrl+Alt+Arrow,
             or right-click / Shift+F10 → "Move with keyboard" (KeyboardWindowMover). -->
        <ctl:AccessibleResizeGrip Margin="0,0,-4,-4"/>
      </Grid>
    </Grid>
  </Border>
</Window>
