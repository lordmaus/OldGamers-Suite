<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- C64 — Commodore 64 blue palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#40318D"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#4B3A9E"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#5A49AE"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#E6E5F3"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#A496E0"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F07874"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#8ACA85"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#F4E54E"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#E8916C"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#F4E54E"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#C19FF0"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E87EC4"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#89E0D4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#352880"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#4B3A9E"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#F6E96C"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#9890CD"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FCE0DF"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#E7E4F7"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#D6ECD4"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#F6E96C"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
