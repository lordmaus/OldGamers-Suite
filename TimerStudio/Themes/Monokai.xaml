<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Monokai — WCAG AAA: BrushText/BrushMuted/FocusRingBrush ≥7:1 on BrushBg -->
  <SolidColorBrush x:Key="BrushBg"        Color="#272822"/>
  <SolidColorBrush x:Key="BrushSurf"      Color="#2D2E27"/>
  <SolidColorBrush x:Key="BrushSurf2"     Color="#373832"/>
  <SolidColorBrush x:Key="BrushText"      Color="#F8F8F2"/>
  <SolidColorBrush x:Key="BrushMuted"     Color="#CFCFC2"/>
  <SolidColorBrush x:Key="BrushHint"      Color="#BCBAAC"/>
  <SolidColorBrush x:Key="BrushBlue"      Color="#66D9E8"/>
  <SolidColorBrush x:Key="BrushRed"       Color="#FFA5A5"/>
  <SolidColorBrush x:Key="BrushGreen"     Color="#A9DC76"/>
  <SolidColorBrush x:Key="BrushAmber"     Color="#FD971F"/>
  <SolidColorBrush x:Key="BrushBar"       Color="#1E1F1B"/>
  <SolidColorBrush x:Key="BrushDisabled"  Color="#575852"/>
  <!-- Focus ring: #FFB300 on #272822 = 7.6:1 — AAA -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FFB300"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7A7662"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFA5A5"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#66D9E8"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#A9DC76"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FDA740"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
  <SolidColorBrush x:Key="BrushOrange"      Color="#FD7C1F"/>
</ResourceDictionary>
