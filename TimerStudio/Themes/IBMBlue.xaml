<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- IBM Blue — classic IBM PC blue screen -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000088"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0000AA"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#0000CC"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#CDCDCD"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#BABADC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#55FFFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#55FF55"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFFF55"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8833"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFF55"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF55FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF55AA"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#55FFFF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#000066"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#0000AA"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFFF55"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7171B8"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFA4A4"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#55FFFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#55FF55"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFFF55"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
