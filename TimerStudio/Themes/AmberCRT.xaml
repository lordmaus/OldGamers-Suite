<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Amber CRT — vintage phosphor amber monitor -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A0F00"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#261500"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#341D00"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFB000"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#EA9C00"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#F48800"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF6213"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#AAFF00"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFB000"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8C00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF88FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF44AA"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFCC"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#120900"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#664400"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFE500"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#995500"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7F3E"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#FFE500"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#AAFF00"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFB000"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
