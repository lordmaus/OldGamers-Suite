<Window x:Class="TimerStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Timer Studio"
        Width="1150" Height="1060"
        MinWidth="380" MinHeight="400"
        Icon="Assets/app.ico"
        Background="{DynamicResource BrushBg}"
        Closing="Window_Closing">

  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.New"  Key="N"  Modifiers="Ctrl"/>
    <KeyBinding Command="ApplicationCommands.Delete" Key="Delete"/>
    <KeyBinding Command="ApplicationCommands.Undo" Key="Z"  Modifiers="Ctrl"/>
    <!-- WCAG 2.2 SC 3.2.6 — consistent help location: F1 opens About/Help -->
    <KeyBinding Command="ApplicationCommands.Help" Key="F1"/>
  </Window.InputBindings>

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="TaskbarInfo" Description="Timer Studio"/>
  </Window.TaskbarItemInfo>

  <!-- Root scale target — LayoutTransform drives the Cycle UI Size feature -->
  <Grid x:Name="RootLayout">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
    </Grid.LayoutTransform>

    <DockPanel>

      <!-- ══ SECTION 1 — Identity, Config & Scaling ═════════════════════════ -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource BrushBar}"
              BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="0,0,0,1"
              MinHeight="52" Padding="14,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- App name (bold, left) -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Timer Studio"
                       FontFamily="{DynamicResource AppFontFamily}" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Name="LblStatus"
                       Text="0 timers"
                       FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushMuted}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Timer status"/>
          </StackPanel>

          <!-- Config buttons + Size (right) -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

            <Button x:Name="BtnHotkeys"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    Click="BtnHotkeys_Click"
                    ToolTip="View keyboard shortcuts (F1)"
                    AutomationProperties.Name="Hotkeys"
                    AutomationProperties.AccessKey="H"
                    AutomationProperties.HelpText="View keyboard shortcuts and configure key bindings"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Keyboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Hotkeys" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnSettings"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    ToolTip="Open application settings"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.AccessKey="S"
                    AutomationProperties.HelpText="Open application settings"
                    Click="BtnSettings_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Settings}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnTheme"
                    Content="◑ Theme"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    Click="BtnTheme_Click"
                    ToolTip="Toggle dark / light theme"
                    AutomationProperties.Name="Theme"
                    AutomationProperties.AccessKey="T"
                    AutomationProperties.HelpText="Open theme selector"/>

            <Button x:Name="BtnAbout"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,10,0"
                    Click="BtnAbout_Click"
                    ToolTip="About Timer Studio"
                    AutomationProperties.Name="About"
                    AutomationProperties.AccessKey="A"
                    AutomationProperties.HelpText="About Timer Studio"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.About}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></Button>

            <!-- Divider -->
            <Rectangle Width="1" Height="24"
                       Fill="{DynamicResource BrushSurf2}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Button x:Name="BtnCycleSize"
                    Content="⊞ Standard (1×)"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12"
                    ToolTip="Cycle UI size: Standard → Medium → Large → Xtra Large"
                    AutomationProperties.Name="Cycle UI size"
                    AutomationProperties.AccessKey="U"
                    AutomationProperties.HelpText="Cycles UI size: Standard, Medium, Large, Xtra Large"
                    Click="BtnCycleSize_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══ SECTION 2 — Actions, Search & Widgets ═══════════════════════════ -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource BrushBar}"
              BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="0,0,0,1"
              MinHeight="52" Padding="8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- left action buttons -->
            <ColumnDefinition Width="*"/>     <!-- search box (fills) -->
            <ColumnDefinition Width="Auto"/>  <!-- Pill / Clock / Stats -->
          </Grid.ColumnDefinitions>

          <!-- Left: primary action buttons -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

            <Button x:Name="BtnAddTimer"
                    Style="{StaticResource PrimaryButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,10,0"
                    Click="BtnAddTimer_Click"
                    ToolTip="Add a new timer (Ctrl+N)"
                    AutomationProperties.Name="Add new timer"
                    AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.AddTimer}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Add Timer" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnSort"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnSort_Click"
                    ToolTip="Sort timers by name, time remaining, or category"
                    AutomationProperties.Name="Sort timers"
                    AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Sort}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Sort" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnGrouped"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnGrouped_Click"
                    ToolTip="Group timers by category with collapsible headers"
                    AutomationProperties.Name="Toggle grouped view by category"
                    AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Folder}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Grouped" VerticalAlignment="Center" x:Name="BtnGroupedText"/></StackPanel></Button>

            <Button x:Name="BtnBulkStart"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,4,0"
                    Click="BtnBulkStart_Click"
                    ToolTip="Start all idle timers"
                    AutomationProperties.Name="Start all idle timers"
                    AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.QueueNow}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="All" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnBulkPause"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnBulkPause_Click"
                    ToolTip="Pause all running timers"
                    AutomationProperties.Name="Pause all running timers"
                    AutomationProperties.PositionInSet="5" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Pause}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="All" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnTemplates"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnTemplates_Click"
                    ToolTip="Manage saved timer templates"
                    AutomationProperties.Name="Manage timer templates"
                    AutomationProperties.PositionInSet="6" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Template}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Templates" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnDeleteSelected"
                    Style="{StaticResource FlatButton}"
                    Foreground="{DynamicResource BrushRedText}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Visibility="Collapsed"
                    Click="BtnDeleteSelected_Click"
                    ToolTip="Delete all checked timers (cannot be undone)"
                    AutomationProperties.Name="Delete selected timers"
                    AutomationProperties.PositionInSet="7" AutomationProperties.SizeOfSet="7"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Delete Selected" VerticalAlignment="Center" x:Name="BtnDeleteSelectedText"/></StackPanel></Button>
          </StackPanel>

          <!-- Centre: search box (stretches to fill) -->
          <Border Grid.Column="1"
                  Background="{DynamicResource BrushSurf}"
                  BorderBrush="{DynamicResource BrushDivider}"
                  BorderThickness="1" CornerRadius="4"
                  Padding="6,0,0,0" MinHeight="44"
                  VerticalAlignment="Center" Margin="6,0,6,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Image Source="{StaticResource JtIcon.Search}" Style="{StaticResource JtInlineIcon}" Grid.Column="0" Margin="0,0,4,0"/>
              <TextBox Grid.Column="1" x:Name="TxtSearch"
                       Style="{x:Null}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource BrushText}"
                       CaretBrush="{DynamicResource BrushText}"
                       FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                       VerticalAlignment="Center"
                       ToolTip="Search timer names and notes"
                       AutomationProperties.Name="Search timers"
                       TextChanged="TxtSearch_TextChanged"/>
              <Button Grid.Column="2" x:Name="BtnClearSearch"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource BrushMuted}"
                      Padding="2" MinHeight="44" MinWidth="44"
                      Visibility="Collapsed"
                      Click="BtnClearSearch_Click"
                      ToolTip="Clear search"
                      AutomationProperties.Name="Clear search"><Image Source="{StaticResource JtIcon.Close}" Style="{StaticResource JtMenuIcon}"/></Button>
            </Grid>
          </Border>

          <!-- Right: widget toggles -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <Button x:Name="BtnPill"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnPill_Click"
                    ToolTip="Toggle compact always-on-top strip showing running timers"
                    AutomationProperties.Name="Toggle compact pill window"
                    AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="3"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Pill}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Pill" VerticalAlignment="Center" x:Name="BtnPillText"/></StackPanel></Button>

            <Button x:Name="BtnClock"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13" Margin="0,0,6,0"
                    Click="BtnClock_Click"
                    ToolTip="Open always-on-top live clock"
                    AutomationProperties.Name="Open clock window"
                    AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="3"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Recent}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Clock" VerticalAlignment="Center"/></StackPanel></Button>

            <Button x:Name="BtnStats"
                    Style="{StaticResource FlatButton}"
                    Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="13"
                    Click="BtnStats_Click"
                    ToolTip="View alert history and statistics"
                    AutomationProperties.Name="Open statistics dashboard"
                    AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="3"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Dashboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Stats" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>

        </Grid>
      </Border>

      <!-- ══ F7: Time-range filter bar ══════════════════════════════════════ -->
      <Border DockPanel.Dock="Top"
              x:Name="TimeRangeBar"
              Background="{DynamicResource BrushBg}"
              Padding="10,4">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Filter:"
                     FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <Button x:Name="BtnRangeAll"
                  Content="✓ All"
                  Style="{StaticResource FlatButton}"
                  Padding="10,4" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
                  Margin="0,0,4,0"
                  Click="BtnTimeRange_Click" Tag="All"
                  AutomationProperties.Name="Show all timers"/>
          <Button x:Name="BtnRangeToday"
                  Content="Today"
                  Style="{StaticResource FlatButton}"
                  Padding="10,4" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
                  Margin="0,0,4,0"
                  Click="BtnTimeRange_Click" Tag="Today"
                  ToolTip="Show only timers firing today"
                  AutomationProperties.Name="Filter timers firing today"/>
          <Button x:Name="BtnRangeWeek"
                  Content="This Week"
                  Style="{StaticResource FlatButton}"
                  Padding="10,4" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
                  Margin="0,0,4,0"
                  Click="BtnTimeRange_Click" Tag="Week"
                  ToolTip="Show only timers firing this week"
                  AutomationProperties.Name="Filter timers firing this week"/>
          <Button x:Name="BtnRangeOverdue"
                  Content="Overdue"
                  Style="{StaticResource FlatButton}"
                  Padding="10,4" MinHeight="44" FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{DynamicResource BrushRedText}"
                  Click="BtnTimeRange_Click" Tag="Overdue"
                  ToolTip="Show only overdue or active alert timers"
                  AutomationProperties.Name="Filter overdue timers"/>
        </StackPanel>
      </Border>

      <!-- ══ Category filter bar ════════════════════════════════════════════ -->
      <Border DockPanel.Dock="Top"
              x:Name="CategoryBar"
              Background="{DynamicResource BrushSurf}"
              BorderBrush="{DynamicResource BrushSurf2}"
              BorderThickness="0,0,0,1"
              Padding="10,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="CategoryChips"
                       Orientation="Horizontal"
                       VerticalAlignment="Center"/>
          </ScrollViewer>
          <Button Grid.Column="1"
                  x:Name="BtnManageCategories"
                  Style="{StaticResource FlatButton}"
                  Padding="10,6" MinHeight="44" MinWidth="44" FontSize="12"
                  Margin="8,0,0,0"
                  ToolTip="Manage categories"
                  AutomationProperties.Name="Manage categories"
                  Click="BtnManageCategories_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.FolderGear}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Categories" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
      </Border>

      <!-- ══ Body — timer cards ══════════════════════════════════════════════ -->
      <Grid>
        <!-- Bottom margin keeps the 44px resize grip off the scrollbar's down arrow -->
        <ScrollViewer x:Name="ScrollView"
                      Margin="0,0,0,44"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <!-- TimerPanel: WrapPanel populated imperatively in code-behind.
               WPF does not support UI virtualization for WrapPanel layouts.
               Virtualization would require migrating to an ItemsControl with a
               VirtualizingWrapPanel — deferred until Accessibility Insights pass
               confirms this is a real perf bottleneck (most sessions have <50 timers). -->
          <WrapPanel x:Name="TimerPanel"
                     Orientation="Horizontal"
                     Margin="6,6,6,6"/>
        </ScrollViewer>

        <!-- Empty filter state -->
        <StackPanel x:Name="EmptyFilterPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
          <Image Source="{StaticResource JtIcon.Search}" Style="{StaticResource JtMenuIcon}" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock x:Name="LblEmptyFilter"
                     Text="No timers in this category"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="14"
                     Foreground="{DynamicResource BrushMuted}"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="Select All to see every timer"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushHint}"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Hidden banner -->
        <StackPanel x:Name="HiddenBanner"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
          <Image Source="{StaticResource JtIcon.EyeOff}" Style="{StaticResource JtMenuIcon}" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="Timers are hidden" FontSize="14"
                     Foreground="{DynamicResource BrushMuted}"
                     HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <Border x:Name="AlertBanner"
                  Background="{DynamicResource BrushRed}"
                  CornerRadius="6" Padding="16,8" Margin="0,0,0,12"
                  Visibility="Collapsed">
            <TextBlock x:Name="LblAlertBanner" Text=""
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushOnAccent}"
                       HorizontalAlignment="Center"/>
          </Border>
          <Button Content="Show Timers"
                  Style="{StaticResource PrimaryButton}"
                  MinHeight="44" MinWidth="44"
                  HorizontalAlignment="Center"
                  AutomationProperties.Name="Show all timers"
                  Click="BtnShowTimers_Click"/>
        </StackPanel>

        <!-- ══ Resize grip — 44x44, drag OR keyboard (Controls/AccessibleResizeGrip) ══ -->
        <sh:AccessibleResizeGrip/>

      </Grid>
    </DockPanel>
  </Grid>
</Window>
