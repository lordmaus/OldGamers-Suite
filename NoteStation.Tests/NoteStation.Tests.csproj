<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 6 (2026-10-12): regression tests for NoteStation Skills Review fixes.
       Kept OUTSIDE NoteStation\ so the app's default **/*.cs glob never picks these up.
       Run:  dotnet test NoteStation.Tests\NoteStation.Tests.csproj  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- must match the app's platform-versioned TFM (WinRT OCR) to reference it -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoteStation\NoteStation.csproj" />
  </ItemGroup>

</Project>
