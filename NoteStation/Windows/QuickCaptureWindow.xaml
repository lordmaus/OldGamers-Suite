<Window x:Class="NoteStation.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NoteStation.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Quick Capture"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        ResizeMode="CanResize"
        MinWidth="300" MinHeight="200">

    <!-- Fixed-dark overlay palette: shared styles' DynamicResource brushes resolve here, not the app theme. -->
    <Window.Resources>
        <ResourceDictionary Source="/Theming/OverlayPalette.xaml"/>
    </Window.Resources>

    <Border Background="#CC1A1B2E"
            CornerRadius="8"
            BorderBrush="#5545475A"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Drag handle -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Mode toggle -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Title TextBox -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Main entry TextBox -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Save / Cancel buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Resize grip -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0: Drag handle ──────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="#BB11111B"
                    CornerRadius="8,8,0,0"
                    x:Name="DragHandle"
                    Cursor="SizeAll"
                    ToolTip="Drag to move — or Alt+Arrow keys; right-click for Move/Resize with keyboard"
                    MouseLeftButtonDown="DragHandle_MouseDown"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{StaticResource JtIcon.NewNote}" Style="{StaticResource JtInlineIcon}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="0" Margin="22,0,0,0"
                               Text="Quick Capture"
                               Foreground="#CDD6F4"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource OvBtn}"
                            Content="✕"
                            Click="BtnClose_Click"
                            MinWidth="44"
                            MinHeight="44"
                            AutomationProperties.Name="Close"/>
                </Grid>
            </Border>

            <!-- ── Row 1: Mode toggle ─────────────────────────────────────── -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="8,6">
                <StackPanel.Resources>
                    <Style x:Key="ChipRadio" TargetType="RadioButton">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#5545475A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#5589B4FA"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8889B4FA"/>
                                            <Setter Property="Foreground" Value="#CDD6F4"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True"/>
                                                <Condition Property="IsFocused" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <RadioButton x:Name="RbClip"
                             Style="{StaticResource ChipRadio}"
                             GroupName="QCMode"
                             IsChecked="True"
                             Checked="RbMode_Checked"
                             AutomationProperties.Name="Clip mode"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Clip" VerticalAlignment="Center"/></StackPanel></RadioButton>
                <RadioButton x:Name="RbNote"
                             Style="{StaticResource ChipRadio}"
                             GroupName="QCMode"
                             Checked="RbMode_Checked"
                             AutomationProperties.Name="Note mode"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.StickyNote}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Note" VerticalAlignment="Center"/></StackPanel></RadioButton>
                <RadioButton x:Name="RbTask"
                             Style="{StaticResource ChipRadio}"
                             GroupName="QCMode"
                             Checked="RbMode_Checked"
                             AutomationProperties.Name="Task mode"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.NewTask}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Task" VerticalAlignment="Center"/></StackPanel></RadioButton>
            </StackPanel>

            <!-- ── Row 2: Title TextBox (Note/Task only) ──────────────────── -->
            <Grid Grid.Row="2"
                  x:Name="TitleRow"
                  Visibility="Collapsed"
                  Margin="8,0,8,4">
                <TextBox x:Name="TxtTitle"
                         Foreground="#CDD6F4"
                         Background="#22FFFFFF"
                         BorderThickness="0"
                         Padding="10,8"
                         MinHeight="44"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         CaretBrush="#CDD6F4"
                         SelectionBrush="#5589B4FA"
                         AutomationProperties.Name="Title"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="WatermarkBrush" TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="Title…"
                                                   Foreground="{DynamicResource BrushMuted}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   Margin="10,0,0,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <DrawingBrush TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#22FFFFFF">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,9999,9999"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <!-- Watermark overlay for Title -->
                <TextBlock x:Name="TitlePlaceholder"
                           Text="Title…"
                           Foreground="{DynamicResource BrushMuted}"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- ── Row 3: Main entry TextBox ──────────────────────────────── -->
            <Grid Grid.Row="3"
                  Margin="8,4">
                <TextBox x:Name="TxtCapture"
                         MinHeight="44"
                         MaxHeight="160"
                         Padding="10,8"
                         Foreground="#CDD6F4"
                         Background="#22FFFFFF"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         CaretBrush="#CDD6F4"
                         SelectionBrush="#5589B4FA"
                         AutomationProperties.Name="Capture text"
                         VerticalContentAlignment="Top"/>
                <!-- Watermark overlay for Capture -->
                <TextBlock x:Name="CapturePlaceholder"
                           Text="Type and press Enter…"
                           Foreground="{DynamicResource BrushMuted}"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Margin="10,8,0,0"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtCapture}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ── Row 4: Save / Cancel buttons ──────────────────────────── -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="8,4,8,8">
                <StackPanel.Resources>
                    <Style x:Key="ActionBtn" TargetType="Button">
                        <Setter Property="Background" Value="#3389B4FA"/>
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Setter Property="BorderBrush" Value="#5589B4FA"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#5589B4FA"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#7789B4FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Button Style="{StaticResource ActionBtn}"
                        Content="Save"
                        MinWidth="70"
                        MinHeight="44"
                        Click="BtnSave_Click"
                        IsDefault="True"
                        AutomationProperties.Name="Save entry"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Cancel"
                        MinWidth="70"
                        MinHeight="44"
                        Click="BtnClose_Click"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Cancel"/>
            </StackPanel>

            <!-- Resize grip — suite-canonical AccessibleResizeGrip (mouse + keyboard, focus ring, UIA Thumb). -->
            <ctl:AccessibleResizeGrip Grid.Row="5"/>

        </Grid>
    </Border>
</Window>
