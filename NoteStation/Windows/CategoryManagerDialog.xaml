<Window x:Class="NoteStation.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Manage Categories"
        Width="480" Height="520"
        MinWidth="360" MinHeight="320"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <TextBlock Grid.Row="0" Text="Categories"
               Style="{StaticResource DialogTitle}"
               FontFamily="{DynamicResource AppFontFamily}" FontSize="16"
               Margin="0,0,0,12"/>

    <!-- Category list -->
    <Border Grid.Row="1"
            BorderBrush="{DynamicResource BrushSurf2}"
            BorderThickness="1" CornerRadius="4">
      <ListView x:Name="LvCategories"
                AutomationProperties.Name="Categories"
                AutomationProperties.HelpText="Select a category to rename or delete it"
                ItemContainerStyle="{StaticResource ThemedGridViewItem}"
                Background="{DynamicResource BrushSurf}"
                Foreground="{DynamicResource BrushText}"
                BorderThickness="0"
                SelectionMode="Single"
                FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Color" Width="56">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Button Tag="{Binding Name}"
                          Width="44" Height="44"
                          ToolTip="Change color"
                          AutomationProperties.Name="Change category color"
                          Click="BtnColor_Click"
                          Style="{StaticResource FlatButton}"
                          Padding="0">
                    <Ellipse Width="16" Height="16"
                             Fill="{Binding ColorBrush}"/>
                  </Button>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Name" Width="240">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource BrushText}"
                             VerticalAlignment="Center"
                             FontSize="13"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Items" Width="80">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Count}"
                             Foreground="{DynamicResource BrushMuted}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontSize="12"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <!-- Add new category row -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,8,0">
        <TextBox x:Name="TxtNewCategory"
                 MinHeight="44"
                 KeyDown="TxtNewCategory_KeyDown"
                 AutomationProperties.Name="New category name"/>
        <TextBlock x:Name="TxtHint"
                   Text="New category name…"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource BrushMuted}"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=TxtNewCategory}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <Button Grid.Column="1" Content="Add"
              MinWidth="80" MinHeight="44"
              Style="{StaticResource PrimaryButton}"
              AutomationProperties.Name="Add category"
              Click="BtnAdd_Click"/>
    </Grid>

    <!-- Action buttons -->
    <Grid Grid.Row="3" Margin="0,8,36,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Rename"
              MinWidth="80" MinHeight="44"
              Style="{StaticResource FlatButton}"
              AutomationProperties.Name="Rename selected category"
              Click="BtnRename_Click" Margin="0,0,8,0"/>
      <Button Grid.Column="1" Content="Delete"
              MinWidth="80" MinHeight="44"
              Style="{StaticResource DangerButton}"
              AutomationProperties.Name="Delete selected category"
              Click="BtnDelete_Click"/>
      <Button Grid.Column="3" Content="Close"
              MinWidth="80" MinHeight="44"
              Style="{StaticResource FlatButton}"
              AutomationProperties.Name="Close dialog"
              IsCancel="True" Click="BtnClose_Click"/>
    </Grid>

    <!-- Resize grip — suite-canonical AccessibleResizeGrip (replaces the OS CanResizeWithGrip grip,
         which is mouse-only). Negative margin cancels the root Grid's 16px margin. -->
    <sh:AccessibleResizeGrip Margin="0,0,-16,-16"/>

  </Grid>
</Window>
