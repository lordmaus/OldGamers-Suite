<Window x:Class="NoteStation.Windows.ScreenCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="#20000000"
        WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" Cursor="Cross"
        AutomationProperties.Name="Screen capture region selection">
    <Canvas x:Name="SelectionCanvas">
        <!-- Selection rectangle drawn at runtime -->
        <Rectangle x:Name="SelectionRect"
                   Stroke="#89B4FA" StrokeThickness="2"
                   Fill="#3089B4FA"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="HintText"
                   Text="Drag to select region — ESC to cancel"
                   Foreground="White" FontSize="16"
                   Background="#80000000" Padding="12,6"
                   HorizontalAlignment="Center"/>
    </Canvas>
</Window>
