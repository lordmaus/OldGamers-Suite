<Window x:Class="NoteStation.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="480"
        SizeToContent="Height"
        MaxHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <!-- Fixed-dark overlay palette (same as Clip/Task overlays): tokens resolve here, not the app theme. -->
  <Window.Resources>
    <ResourceDictionary Source="/Theming/OverlayPalette.xaml"/>
  </Window.Resources>

    <Border Background="{DynamicResource BrushSurf}"
            CornerRadius="10"
            BorderBrush="{DynamicResource BrushBlueText}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Search bar -->
            <TextBox x:Name="TxtSearch"
                     Grid.Row="0"
                     Foreground="{DynamicResource BrushText}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="14,10"
                     FontSize="14"
                     FontFamily="{DynamicResource AppFontFamily}"
                     CaretBrush="{DynamicResource BrushText}"
                     SelectionBrush="{DynamicResource BrushBlue}"
                     TextChanged="TxtSearch_TextChanged"
                     AutomationProperties.Name="Command palette search"
                     VerticalContentAlignment="Center"/>

            <!-- Separator -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource BrushDivider}"
                    Margin="0"/>

            <!-- Row 1: Results ScrollViewer -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="420"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ResultsPanel"/>
            </ScrollViewer>

            <!-- Row 2: Empty state -->
            <TextBlock x:Name="TxtEmpty"
                       Grid.Row="3"
                       Text="No results"
                       Foreground="{DynamicResource BrushMuted}"
                       FontSize="12"
                       FontFamily="{DynamicResource AppFontFamily}"
                       HorizontalAlignment="Center"
                       Padding="0,12"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>

</Window>
