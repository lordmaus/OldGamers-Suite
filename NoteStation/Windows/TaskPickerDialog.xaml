<Window x:Class="NoteStation.Windows.TaskPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Link to Task"
        Width="420" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource BrushBg}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="340" MinHeight="200"
        ShowInTaskbar="False"
        AutomationProperties.Name="Link to Task dialog">

    <Border BorderBrush="{DynamicResource BrushBlue}" BorderThickness="1" CornerRadius="4">
      <Grid>
        <StackPanel Margin="16">

            <!-- Title bar -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Link Clip to Task" Style="{StaticResource DialogTitle}" FontSize="15"
                           AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center"/>
                <Button x:Name="BtnClose" Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource FlatButton}" Padding="0"
                        Background="Transparent"
                        Click="BtnClose_Click"
                        AutomationProperties.Name="Close"/>
            </Grid>

            <!-- Search -->
            <TextBox x:Name="TxtSearch" FontSize="13"
                     Padding="8,0" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search tasks"
                     TextChanged="TxtSearch_TextChanged"
                     Margin="0,0,0,8">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Search tasks…" FontSize="13"
                                               Foreground="{DynamicResource BrushMuted}" Margin="8,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Task list -->
            <ListBox x:Name="LstTasks" Height="220"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Available tasks"
                     SelectionChanged="LstTasks_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Unlink button -->
            <Button x:Name="BtnUnlink" Content="Remove link" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Style="{StaticResource FlatButton}"
                    Click="BtnUnlink_Click"
                    AutomationProperties.Name="Remove task link"/>

            <!-- OK / Cancel -->
            <Grid Margin="0,12,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancel" Grid.Column="0" Content="Cancel"
                        Style="{StaticResource FlatButton}"
                        Click="BtnCancel_Click" AutomationProperties.Name="Cancel"/>
                <Button x:Name="BtnOk" Grid.Column="2" Content="Link"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnOk_Click" AutomationProperties.Name="Link clip to task"/>
            </Grid>

        </StackPanel>

        <!-- Resize grip — suite-canonical AccessibleResizeGrip (WCAG 2.1.3/2.5.5); Ctrl+Alt+Arrow also resizes. -->
        <sh:AccessibleResizeGrip/>
      </Grid>
    </Border>
</Window>
