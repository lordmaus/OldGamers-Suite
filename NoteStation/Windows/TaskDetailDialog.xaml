<Window x:Class="NoteStation.TaskDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Task Detail — NoteStation"
        Width="500" Height="480" MinWidth="400" MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Task Detail">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16,20,8">

      <TextBlock Text="Task Detail" Style="{StaticResource DialogTitle}"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

      <!-- Title -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="TITLE" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"/>
      <TextBox x:Name="TxtTitle"
               MinHeight="44" VerticalContentAlignment="Center"
               Margin="0,0,0,16" FontSize="14"
               ToolTip="Task title"
               AutomationProperties.Name="Task title"/>

      <!-- Notes -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="NOTES" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"/>
      <Border x:Name="NotesToolbarHost" Margin="0,0,0,4"/>
      <RichTextBox x:Name="TxtNotes"
               MinHeight="80" AcceptsTab="True"
               VerticalScrollBarVisibility="Auto"
               Margin="0,0,0,16" FontSize="13"
               ToolTip="Additional notes"
               AutomationProperties.Name="Task notes"/>

      <!-- Due date + time -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="DUE DATE &amp; TIME" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <DatePicker x:Name="DetailDatePicker"
                    Width="150" MinHeight="44"
                    ToolTip="Optional due date"
                    AutomationProperties.Name="Due date"/>
        <ComboBox x:Name="CboHour"
                  Width="60" MinHeight="44" Margin="8,0,0,0"
                  ToolTip="Due hour (24-hour)"
                  AutomationProperties.Name="Due hour"/>
        <TextBlock Text=":" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center" Margin="4,0"/>
        <ComboBox x:Name="CboMinute"
                  Width="60" MinHeight="44"
                  ToolTip="Due minute"
                  AutomationProperties.Name="Due minute"/>
        <Button x:Name="BtnClearDue"
                Content="✕ Clear"
                Style="{StaticResource FlatButton}"
                MinHeight="44" Padding="10,6" Margin="8,0,0,0"
                Click="BtnClearDue_Click"
                ToolTip="Remove due date and time"
                AutomationProperties.Name="Clear due date"/>
      </StackPanel>

      <!-- Star + accent color -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="OPTIONS" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"/>

      <CheckBox x:Name="ChkStarred"
                Margin="0,0,0,12"
                AutomationProperties.Name="Mark as starred"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Star}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Starred" VerticalAlignment="Center"/></StackPanel></CheckBox>

      <TextBlock Text="Priority:" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>
      <ComboBox x:Name="CboPriority"
                Width="160" MinHeight="44" HorizontalAlignment="Left"
                Margin="0,0,0,16"
                ToolTip="Task priority level"
                AutomationProperties.Name="Task priority"/>

      <TextBlock Text="Rank #:" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <TextBox x:Name="TxtPriorityRank"
                 Width="60" MinHeight="44"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 PreviewTextInput="TxtPriorityRank_PreviewTextInput"
                 ToolTip="Manual ordering number — 1 is top priority. Independent of the Priority level above."
                 AutomationProperties.Name="Manual rank number, 1 is top priority"/>
        <Button Content="Clear rank" MinHeight="44" Padding="12,0" Margin="8,0,0,0"
                Click="BtnClearRank_Click"
                AutomationProperties.Name="Clear manual rank number"/>
      </StackPanel>

      <TextBlock Text="Accent color:" FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"/>

      <StackPanel x:Name="AccentChips" Orientation="Horizontal" Margin="0,0,0,16"/>

      <!-- Subtasks -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="SUBTASKS" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"/>
      <ItemsControl x:Name="SubtaskList" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate>
              <DataTemplate>
                  <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="Subtask done"/>
                      <TextBox Grid.Column="1"
                               Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Background="Transparent"
                               BorderThickness="0,0,0,1"
                               BorderBrush="{DynamicResource BrushSurf2}"
                               Foreground="{DynamicResource BrushText}"
                               Padding="2,2"
                               AutomationProperties.Name="Subtask text"/>
                      <Button Grid.Column="2"
                              Content="✕"
                              MinWidth="44" MinHeight="44" Padding="0"
                              Background="Transparent"
                              Foreground="{DynamicResource BrushMuted}"
                              Cursor="Hand"
                              Click="RemoveSubtask_Click"
                              Tag="{Binding}"
                              AutomationProperties.Name="Remove subtask"
                              Margin="4,0,0,0"/>
                  </Grid>
              </DataTemplate>
          </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="+ Add subtask"
              x:Name="BtnAddSubtask"
              Click="BtnAddSubtask_Click"
              Background="Transparent"
              Foreground="{DynamicResource BrushBlueText}"
              Cursor="Hand"
              HorizontalAlignment="Left"
              Padding="8,4"
              Margin="0,0,0,8"
              AutomationProperties.Name="Add subtask"/>

      <!-- ── F17: Task Relations ───────────────────────────────────────── -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Depends On" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,14,0,4"/>
      <TextBlock Text="This task cannot start until these tasks are complete:"
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,4"/>
      <Border Height="120" BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
              Background="{DynamicResource BrushSurf2}">
          <ListBox x:Name="LstDependsOn"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="Transparent" BorderThickness="0"
                   SelectionMode="Multiple"
                   AutomationProperties.Name="Tasks this task depends on">
              <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="MinHeight" Value="44"/>
                      <Setter Property="Padding"   Value="8,2"/>
                  </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                  <DataTemplate>
                      <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                FontSize="12" Foreground="{DynamicResource BrushText}"
                                AutomationProperties.Name="{Binding Title}"/>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
      </Border>

      <TextBlock Style="{StaticResource SectionHeader}" Text="Blocks" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,12,0,4"/>
      <TextBlock Text="Completing this task will unblock:"
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,4"/>
      <Border Height="100" BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
              Background="{DynamicResource BrushSurf2}">
          <ItemsControl x:Name="LstBlocks"
                        AutomationProperties.Name="Tasks blocked by this task">
              <ItemsControl.ItemTemplate>
                  <DataTemplate>
                      <TextBlock Text="{Binding Title}" FontSize="12" Padding="8,4"
                                 Foreground="{DynamicResource BrushMuted}"/>
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>
      </Border>

      <!-- ── Linked Clips ───────────────────────────────────────────────────── -->
      <GroupBox Header="Linked Clips" Margin="0,8,0,0"
                Foreground="{DynamicResource BrushText}"
                BorderBrush="{DynamicResource BrushSurf2}">
          <StackPanel>
              <ItemsControl x:Name="LinkedClipsList">
                  <ItemsControl.ItemTemplate>
                      <DataTemplate>
                          <Grid MinHeight="44" Margin="0,2">
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Preview}"
                                         FontSize="12" Foreground="{DynamicResource BrushText}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                              <Button Grid.Column="1" Content="✕" Width="44" Height="44" Padding="0"
                                      Background="Transparent"
                                      Foreground="{DynamicResource BrushMuted}"
                                      Tag="{Binding}"
                                      Click="RemoveLinkedClip_Click"
                                      AutomationProperties.Name="Remove linked clip"/>
                          </Grid>
                      </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TxtNoLinkedClips" Text="No clips linked. Right-click a clip → Link to Task."
                         FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                         Margin="0,4" Visibility="Collapsed"/>
          </StackPanel>
      </GroupBox>

    </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="1" Background="{DynamicResource BrushBar}" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Save"
                Style="{StaticResource PrimaryButton}"
                Padding="30,8" MinHeight="44" Margin="0,0,12,0"
                Click="BtnSave_Click"
                AutomationProperties.Name="Save task"/>
        <Button Content="Cancel"
                Style="{StaticResource FlatButton}"
                Padding="30,8" MinHeight="44"
                IsCancel="True"
                Click="BtnCancel_Click"
                AutomationProperties.Name="Cancel without saving"/>
      </StackPanel>
    </Border>

    <!-- Resize grip — suite-canonical AccessibleResizeGrip (mouse + keyboard, focus ring, UIA Thumb). -->
    <sh:AccessibleResizeGrip/>
  </Grid>
</Window>
