<Window x:Class="NoteStation.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NoteStation.Controls"
        Title="About NoteStation"
        Width="540" Height="640" MinWidth="500" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="About NoteStation"
        AutomationProperties.HelpText="About information, version, links, and donation options for NoteStation">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,24,28,24">

      <!-- Logo / Title -->
      <TextBlock Style="{StaticResource DialogTitle}" Text="📋 NoteStation"
                 FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                 Foreground="{DynamicResource BrushBlueText}"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="Clipboard manager · Sticky notes · Task manager for Windows"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushMuted}"
                 HorizontalAlignment="Center" Margin="0,2,0,0"/>

      <Separator Margin="0,14,0,14"/>

      <!-- Info grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionLabel"
                   FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushText}"
                   AutomationProperties.Name="Application version number"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Created by"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Matthew Pittman"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushText}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Platform"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}"/>
        <TextBlock Grid.Row="4" Grid.Column="1"
                   Text="Windows · WPF · .NET 10"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushText}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Data folder"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}"/>
        <StackPanel Grid.Row="6" Grid.Column="1">
          <TextBlock x:Name="DataPathLabel"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap"/>
          <Button Content="📋  Copy path"
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3" MinHeight="44"
                  ToolTip="Copy data folder path to clipboard"
                  AutomationProperties.Name="Copy data folder path"
                  Click="CopyDataPathBtn_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Website"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
        <Button    Grid.Row="8" Grid.Column="1"
                   Content="🌐  oldgamerssoftware.com"
                   HorizontalAlignment="Left"
                   Style="{StaticResource FlatButton}"
                   FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" MinHeight="44"
                   ToolTip="https://oldgamerssoftware.com/"
                   AutomationProperties.Name="Open Old Gamers Software website"
                   AutomationProperties.HelpText="Opens https://oldgamerssoftware.com/ in your browser"
                   Click="WebsiteBtn_Click"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="GitHub"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
        <Button    Grid.Row="10" Grid.Column="1"
                   Content="🐙  GitHub"
                   HorizontalAlignment="Left"
                   Style="{StaticResource FlatButton}"
                   FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" MinHeight="44"
                   ToolTip="https://github.com/lordmaus/NoteStation"
                   AutomationProperties.Name="View NoteStation on GitHub"
                   Click="GitHubBtn_Click"/>

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Start with Windows"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
        <CheckBox  Grid.Row="12" Grid.Column="1" x:Name="ChkStartup"
                   Content="Launch at Windows startup"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center"
                   ToolTip="Add NoteStation to Windows startup"
                   AutomationProperties.Name="Launch NoteStation at Windows startup"
                   Click="ChkStartup_Click"/>

        <TextBlock Grid.Row="14" Grid.Column="0" Text="Updates"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
        <Button    Grid.Row="14" Grid.Column="1"
                   Content="&#x2197; Check for Updates"
                   HorizontalAlignment="Left"
                   Style="{StaticResource FlatButton}"
                   FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" MinHeight="44"
                   ToolTip="Opens the GitHub releases page in your browser"
                   AutomationProperties.Name="Check for updates on GitHub"
                   AutomationProperties.HelpText="Opens the GitHub releases page to check for a newer version"
                   Click="CheckUpdatesBtn_Click"/>

        <TextBlock Grid.Row="16" Grid.Column="0" Text="Help"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
        <Button    Grid.Row="16" Grid.Column="1"
                   Content="📄  Open README"
                   HorizontalAlignment="Left"
                   Style="{StaticResource FlatButton}"
                   FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" MinHeight="44"
                   ToolTip="Opens README.md in your default text editor"
                   AutomationProperties.Name="Open README help file"
                   AutomationProperties.HelpText="Opens README.md in your default text editor"
                   Click="ReadmeBtn_Click"/>
      </Grid>

      <Separator Margin="0,14,0,14"/>

      <!-- Description -->
      <TextBlock FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 TextWrapping="Wrap" TextAlignment="Center"
                 Text="NoteStation combines a clipboard history manager, floating sticky notes with per-note Low Vision font and color controls, and a drag-sortable task manager with TimerStudio integration. Built for gamers and power users who need accessibility."/>

      <Separator Margin="0,14,0,14"/>

      <!-- Donate -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="☕  Donate / Buy Me a Coffee"
                 FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushBlueText}"
                 HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock Text="If NoteStation is useful to you, consider a small donation!"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushMuted}"
                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="💙  Venmo"
                Style="{StaticResource FlatButton}"
                FontSize="12" Padding="20,9" Margin="0,0,12,0" MinHeight="44"
                ToolTip="Donate via Venmo: @Matthew-Pittman-80"
                AutomationProperties.Name="Donate via Venmo"
                Click="VenmoBtn_Click"/>
        <Button Content="💚  Cash App"
                Style="{StaticResource FlatButton}"
                FontSize="12" Padding="20,9" MinHeight="44"
                ToolTip="Donate via Cash App: $MatthewPittman80"
                AutomationProperties.Name="Donate via Cash App"
                Click="CashAppBtn_Click"/>
      </StackPanel>

      <Separator Margin="0,14,0,14"/>

      <!-- Privacy Notice -->
      <Border Background="{DynamicResource BrushSurf}"
              BorderBrush="{DynamicResource BrushBlue}"
              BorderThickness="0,0,0,2"
              CornerRadius="6" Padding="12,10" Margin="0,0,0,14"
              AutomationProperties.Name="Privacy notice">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="&#x1F512;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy — what this app does NOT do"
                       FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                     Text="NoteStation never: collects, stores, or transmits usage data · requires an account · makes network calls (no telemetry, no analytics, no update pings) · stores files outside %APPDATA%\NoteStation."/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"
                     Text="The only outbound network activity occurs when YOU click a link in this dialog. NoteStation itself makes no HTTP calls."/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}">
            <Run FontWeight="SemiBold">GDPR legal basis:</Run>
            <Run>Processing is based on your consent. You may delete all stored data at any time by removing the AppData\NoteStation folder.</Run>
          </TextBlock>
        </StackPanel>
      </Border>

    </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="1" Background="{DynamicResource BrushBar}" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Close" Style="{StaticResource PrimaryButton}"
                Padding="40,8" MinHeight="44"
                IsCancel="True" IsDefault="True"
                AutomationProperties.Name="Close About dialog"
                AutomationProperties.HelpText="Close this dialog and return to NoteStation"
                Click="CloseBtn_Click"/>
      </StackPanel>
    </Border>

    <!-- Resize grip — suite-canonical AccessibleResizeGrip (mouse + keyboard, focus ring, UIA Thumb). -->
    <ctl:AccessibleResizeGrip/>
  </Grid>
</Window>
