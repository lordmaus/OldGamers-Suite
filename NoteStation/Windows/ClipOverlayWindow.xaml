<Window x:Class="NoteStation.ClipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Width="300" Height="420"
        MinWidth="190" MinHeight="150"
        Left="60" Top="60"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

  <!-- Fixed-dark overlay palette: shared styles' DynamicResource brushes resolve here, not the app theme. -->
  <Window.Resources>
    <ResourceDictionary Source="/Theming/OverlayPalette.xaml"/>
  </Window.Resources>

  <!-- Outer Border -->
  <Border x:Name="OuterBorder"
          Background="#CC1A1B2E"
          BorderBrush="#5545475A"
          BorderThickness="1"
          CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- Row 0: header drag band -->
        <RowDefinition Height="Auto"/>   <!-- Row 1: filter chips -->
        <RowDefinition Height="Auto"/>   <!-- Row 2: search bar -->
        <RowDefinition Height="*"/>      <!-- Row 3: clip list -->
        <RowDefinition Height="44"/>     <!-- Row 4: resize grip gutter (44px AccessibleResizeGrip) -->
      </Grid.RowDefinitions>

      <!-- Row 0: Header / drag band -->
      <Border Grid.Row="0"
              x:Name="DragHandle"
              Background="#BB11111B"
              CornerRadius="8,8,0,0"
              Padding="10,0"
              MouseLeftButtonDown="DragHandle_MouseDown"
              Cursor="SizeAll"
              ToolTip="Drag to move — or Alt+Arrow keys; right-click for Move/Resize with keyboard">
        <!-- WCAG 2.5.5: 44px targets → two header rows (title/close, then text size + opacity) -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtInlineIcon}" VerticalAlignment="Center"/>
            <TextBlock Text="Clips"
                       FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1"
                       Margin="0,0,4,0"/>
            <Button x:Name="BtnGroupByApp"
                    Content="⊞"
                    Style="{StaticResource OvBtn}" Padding="0"
                    Click="BtnGroupByApp_Click"
                    ToolTip="Group by source app"
                    AutomationProperties.Name="Toggle group by source app"/>
          </StackPanel>

          <!-- Close button -->
          <Button Grid.Row="0" Grid.Column="2"
                  Content="✕"
                  Style="{StaticResource OvBtn}"
                  Click="BtnClose_Click"
                  ToolTip="Hide overlay (Escape)"
                  AutomationProperties.Name="Hide clipboard overlay"/>

          <!-- Font size control -->
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="-" Style="{StaticResource OvBtn}" Padding="0"
                    Click="BtnFontDec_Click" ToolTip="Smaller text"
                    AutomationProperties.Name="Decrease font size"/>
            <TextBlock x:Name="TxtOverlayFontSize" Text="12"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}"
                       VerticalAlignment="Center" Margin="2,0" MinWidth="20" TextAlignment="Center"
                       AutomationProperties.Name="Text size"/>
            <Button Content="+" Style="{StaticResource OvBtn}" Padding="0"
                    Click="BtnFontInc_Click" ToolTip="Larger text"
                    AutomationProperties.Name="Increase font size"/>
          </StackPanel>

          <!-- Opacity slider (implicit Slider style: 44px thumb area, overlay palette brushes) -->
          <Slider x:Name="SldOpacity"
                  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                  Minimum="0.3" Maximum="1.0" Value="0.9"
                  SmallChange="0.05" LargeChange="0.1"
                  MinWidth="88"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0"
                  ToolTip="Opacity — drag right for solid"
                  ValueChanged="SldOpacity_ValueChanged"
                  AutomationProperties.Name="Window opacity"/>
        </Grid>
      </Border>

      <!-- Row 1: Filter chips -->
      <Border Grid.Row="1"
              Background="#AA11111B"
              Padding="8,5">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RbRecent"
                       Style="{StaticResource OverlayFilterChip}"
                       GroupName="CFilter"
                       IsChecked="True"
                       Checked="FilterChanged"
                       AutomationProperties.Name="Show recent clips"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Recent}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Recent" VerticalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton x:Name="RbPinned"
                       Style="{StaticResource OverlayFilterChip}"
                       GroupName="CFilter"
                       Checked="FilterChanged"
                       AutomationProperties.Name="Show pinned clips"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Pin}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Pinned" VerticalAlignment="Center"/></StackPanel></RadioButton>
        </StackPanel>
      </Border>

      <!-- Row 2: Search bar -->
      <Border Grid.Row="2"
              Background="#AA11111B"
              Padding="8,4">
        <TextBox x:Name="TxtSearch"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 Background="#33FFFFFF"
                 BorderThickness="0"
                 Padding="6,4"
                 Text=""
                 TextChanged="SearchBox_TextChanged"
                 AutomationProperties.Name="Search clips"
                 AutomationProperties.HelpText="Filter clips by text">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
      </Border>

      <!-- Row 3: Clip list -->
      <ScrollViewer Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="4,2">
        <StackPanel x:Name="ClipsPanel"/>
      </ScrollViewer>

      <!-- Resize grip — suite-canonical AccessibleResizeGrip (mouse + keyboard, focus ring, UIA Thumb). -->
      <sh:AccessibleResizeGrip/>

    </Grid>
  </Border>
</Window>
