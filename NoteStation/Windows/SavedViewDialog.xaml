<Window x:Class="NoteStation.Windows.SavedViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:NoteStation.Controls"
        Title="Save View"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource BrushBg}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="360" MinHeight="200"
        ShowInTaskbar="False"
        AutomationProperties.Name="Save View dialog">

    <Border BorderBrush="{DynamicResource BrushBlue}" BorderThickness="1" CornerRadius="4">
      <Grid>
        <StackPanel Margin="16">

            <!-- Title bar -->
            <Grid Margin="0,0,0,12">
                <TextBlock x:Name="TxtDialogTitle" Text="Save View" Style="{StaticResource DialogTitle}" FontSize="15"
                           AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center"/>
                <Button x:Name="BtnClose" Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource FlatButton}" Padding="0"
                        Background="Transparent"
                        Click="BtnClose_Click"
                        AutomationProperties.Name="Close"/>
            </Grid>

            <!-- Name -->
            <TextBlock Text="View name:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtName" FontSize="13"
                     Padding="8,0" VerticalContentAlignment="Center"
                     AutomationProperties.Name="View name"
                     Margin="0,0,0,10"/>

            <!-- Scope -->
            <TextBlock Text="Switch to tab:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbScope" FontSize="13"
                      AutomationProperties.Name="Scope"
                      Margin="0,0,0,10">
                <ComboBoxItem Content="All (no tab switch)" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="Clips" Tag="Clips"/>
                <ComboBoxItem Content="Notes" Tag="Notes"/>
                <ComboBoxItem Content="Tasks" Tag="Tasks"/>
            </ComboBox>

            <!-- Filter expression -->
            <TextBlock Text="Filter expression:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtExpression" FontSize="13"
                     Padding="8,0" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Filter expression"
                     Margin="0,0,0,6"/>

            <!-- Help -->
            <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="Tokens: "/>
                <Run Text="folder:Name  priority:high  type:task  tag:work  overdue  starred  habit" FontFamily="Consolas"/>
            </TextBlock>

            <!-- OK / Cancel -->
            <Grid Margin="0,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancel" Grid.Column="0" Content="Cancel"
                        Style="{StaticResource FlatButton}"
                        Click="BtnCancel_Click" AutomationProperties.Name="Cancel"/>
                <Button x:Name="BtnOk" Grid.Column="2" Content="Save View"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnOk_Click" AutomationProperties.Name="Save view"/>
            </Grid>

        </StackPanel>

        <!-- Resize grip — suite-canonical AccessibleResizeGrip (WCAG 2.1.3/2.5.5); Ctrl+Alt+Arrow also resizes. -->
        <ctl:AccessibleResizeGrip/>
      </Grid>
    </Border>
</Window>
