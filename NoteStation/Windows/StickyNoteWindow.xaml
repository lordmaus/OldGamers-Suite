<Window x:Class="NoteStation.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoteStation"
        xmlns:ctl="clr-namespace:NoteStation.Controls"
        Title="Note"
        Width="320" Height="220"
        MinWidth="160" MinHeight="160"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

  <Window.Resources>
    <!-- Quick-colour swatch (WCAG 1.4.1/2.4.7/4.1.2): RadioButton so UIA exposes the selected colour
         (SelectionItem IsSelected); ✓ glyph with a dark halo shows selection on any swatch colour;
         2px FocusRingBrush ring on keyboard focus. Arrow keys move within the group, Space applies. -->
    <Style x:Key="QuickColorSwatch" TargetType="RadioButton">
      <Setter Property="Width"     Value="44"/>
      <Setter Property="Height"    Value="44"/>
      <Setter Property="Margin"    Value="0,0,6,0"/>
      <Setter Property="Cursor"    Value="Hand"/>
      <Setter Property="GroupName" Value="QuickColor"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Ellipse x:Name="Swatch" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="1" Margin="5"/>
              <Ellipse x:Name="SelRing" Stroke="#FFFFFF" StrokeThickness="2" Margin="2" Opacity="0"/>
              <Ellipse x:Name="SelRingOuter" Stroke="#000000" StrokeThickness="1" Margin="1" Opacity="0"/>
              <Path x:Name="Check" Data="M 0,6 L 5,11 L 14,1" Width="16" Height="13" Stretch="Uniform"
                    Stroke="#000000" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Opacity="0" IsHitTestVisible="False"/>
              <Path x:Name="CheckInner" Data="M 0,6 L 5,11 L 14,1" Width="16" Height="13" Stretch="Uniform"
                    Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Opacity="0" IsHitTestVisible="False"/>
              <Ellipse x:Name="FocusRing" Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2"
                       Margin="-1" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SelRing"      Property="Opacity" Value="1"/>
                <Setter TargetName="SelRingOuter" Property="Opacity" Value="1"/>
                <Setter TargetName="Check"        Property="Opacity" Value="1"/>
                <Setter TargetName="CheckInner"   Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Swatch" Property="StrokeThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    <KeyBinding Key="F2"     Modifiers="" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
    <KeyBinding Key="F3"     Modifiers="" Command="{x:Static SystemCommands.RestoreWindowCommand}"/>
  </Window.InputBindings>

  <!-- Root border — solid background so note is fully opaque -->
  <Border x:Name="RootBorder"
          CornerRadius="6"
          BorderThickness="1"
          MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Format…"         Click="CmdFormat_Click"  AutomationProperties.Name="Open format dialog"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Theme}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="CmdFormatToolbarItem"
                  Header="Aa Formatting toolbar"
                  IsCheckable="True"
                  Click="CmdFormatToolbarItem_Click"
                  AutomationProperties.Name="Toggle formatting toolbar"/>
        <MenuItem x:Name="CmdMarkdownItem"
                  Header="MD Markdown preview"
                  IsCheckable="True"
                  Click="CmdMarkdownItem_Click"
                  AutomationProperties.Name="Toggle Markdown preview"/>
        <MenuItem Header="Restore size"
                  Click="CmdRestoreSize_Click"
                  AutomationProperties.Name="Restore note to its normal size"/>
        <MenuItem x:Name="CmdPinItem"
                  Header="Pin on top"       Click="CmdPin_Click"     AutomationProperties.Name="Toggle pin on top"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Pin}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="CmdHideTitleBar"
                  Header="Hide title bar"
                  IsCheckable="True"
                  Click="CmdHideTitleBar_Click"
                  AutomationProperties.Name="Hide note title bar"/>
        <MenuItem x:Name="CmdShowOnStartup"
                  Header="Show on startup"
                  IsCheckable="True"
                  Click="CmdShowOnStartup_Click"
                  AutomationProperties.Name="Show this note on startup"/>
        <MenuItem x:Name="CmdShowInSidebar"
                  Header="Show in sidebar"
                  IsCheckable="True"
                  Click="CmdShowInSidebar_Click"
                  AutomationProperties.Name="Show this note in the notes sidebar"/>
        <MenuItem Header="Screenshot → OCR"
                  Click="BtnScreenshot_Click"
                  AutomationProperties.Name="Capture screen region to note"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Camera}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <Separator/>
        <MenuItem x:Name="CmdLockItem"
                  Header="Hide Note"
                  Click="CmdLock_Click"
                  AutomationProperties.Name="Hide note"
                  AutomationProperties.HelpText="Covers the note until its PIN is entered. Not encryption."><MenuItem.Icon><Image Source="{StaticResource JtIcon.EyeOff}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="CmdSetPinItem"
                  Header="Set / Change PIN…"
                  Click="CmdSetPin_Click"
                  AutomationProperties.Name="Set or change PIN"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Password}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="CmdRemovePinItem"
                  Header="Remove PIN"
                  Click="CmdRemovePin_Click"
                  AutomationProperties.Name="Remove PIN from note"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <Separator/>
        <MenuItem Header="Auto-blur after…"
                  AutomationProperties.Name="Auto-blur timer"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Recent}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon>
          <MenuItem Header="Off"        Tag="0"  Click="CmdAutoBlurSet_Click" AutomationProperties.Name="Auto-blur off"/>
          <MenuItem Header="1 minute"   Tag="1"  Click="CmdAutoBlurSet_Click" AutomationProperties.Name="Auto-blur 1 minute"/>
          <MenuItem Header="5 minutes"  Tag="5"  Click="CmdAutoBlurSet_Click" AutomationProperties.Name="Auto-blur 5 minutes"/>
          <MenuItem Header="10 minutes" Tag="10" Click="CmdAutoBlurSet_Click" AutomationProperties.Name="Auto-blur 10 minutes"/>
          <MenuItem Header="30 minutes" Tag="30" Click="CmdAutoBlurSet_Click" AutomationProperties.Name="Auto-blur 30 minutes"/>
        </MenuItem>
        <MenuItem x:Name="CmdExcludeAutoBlur"
                  Header="Exclude from auto-blur"
                  IsCheckable="True"
                  Click="CmdExcludeAutoBlur_Click"
                  AutomationProperties.Name="Exclude note from auto-blur"/>
        <Separator/>
        <MenuItem Header="Close note"        Click="BtnClose_Click"   AutomationProperties.Name="Close note (hide)"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Close}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
        <MenuItem Header="Delete Note…"    Click="CmdDelete_Click"  AutomationProperties.Name="Delete this note"><MenuItem.Icon><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtMenuIcon}"/></MenuItem.Icon></MenuItem>
      </ContextMenu>
    </Border.ContextMenu>
    <Border.BorderBrush>
      <SolidColorBrush x:Name="BorderBrushAnim" Color="#00000040"/>
    </Border.BorderBrush>
    <Border.Background>
      <SolidColorBrush x:Name="BgBrush" Color="#2A2A2A"/>
    </Border.Background>

    <Grid x:Name="NoteRootGrid">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="NoteScale" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- title bar  -->
        <RowDefinition Height="*"/>     <!-- content    -->
      </Grid.RowDefinitions>

      <!-- ── Title bar ── -->
      <Border Grid.Row="0"
              x:Name="TitleBar"
              CornerRadius="5,5,0,0"
              Padding="8,6"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              Cursor="SizeAll">
        <Border.Background>
          <SolidColorBrush x:Name="TitleBarBrush" Color="#1A1A1A" Opacity="0.5"/>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Title (editable inline) -->
          <TextBox x:Name="TitleBox"
                   Grid.Column="0"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="2,0"
                   MinHeight="32"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextChanged="TitleBox_TextChanged"
                   ToolTip="Click to edit note title — right-click title bar for more options"
                   AutomationProperties.Name="Note title"/>

          <!-- Word count -->
          <TextBlock x:Name="TxtWordCount"
                     Grid.Column="1"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center"
                     Margin="4,0"
                     AutomationProperties.Name="Word count"/>

          <!-- Screenshot + Close in title bar. Opacity lives in the bottom footer next to
               the quick-color swatches (see the footer Border below); Aa/MD moved to the
               right-click menu 2026-09-09. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- F13: Screenshot / OCR -->
            <Button x:Name="BtnScreenshot" Width="44" Height="44" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource BrushMuted}"
                    Click="BtnScreenshot_Click"
                    AutomationProperties.Name="Capture screen region to note"
                    ToolTip="Screenshot → OCR into note"><Image Source="{StaticResource JtIcon.Camera}" Style="{StaticResource JtSoloIcon}"/></Button>
            <Button x:Name="BtnFold" Content="▾" Width="44" Height="44" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource BrushMuted}"
                    Click="BtnFold_Click"
                    AutomationProperties.Name="Fold note to title bar only"
                    ToolTip="Fold note (show title only)"/>
            <Button x:Name="BtnClose"
                    Width="44" Height="44" MinHeight="44" MinWidth="44"
                    Padding="0" Margin="2,0,0,0"
                    Click="BtnClose_Click"
                    ToolTip="Close note (right-click for more options)"
                    AutomationProperties.Name="Close note">
              <Image Source="{StaticResource JtIcon.Close}" Style="{StaticResource JtSoloIcon}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Content area + undo toast overlay ── -->
      <Grid Grid.Row="1">
      <!-- F15: Texture overlay (drawn on top of background, below ContentBox) -->
      <Border x:Name="TextureOverlay"
              IsHitTestVisible="False"
              Opacity="0.12"
              Visibility="Collapsed">
          <Border.Background>
              <!-- Set programmatically from code-behind based on NoteTexture -->
              <DrawingBrush TileMode="Tile" Stretch="None"
                            ViewportUnits="Absolute" Viewport="0,0,20,20">
                  <DrawingBrush.Drawing>
                      <DrawingGroup>
                          <GeometryDrawing Brush="White">
                              <GeometryDrawing.Geometry>
                                  <LineGeometry StartPoint="0,19" EndPoint="200,19"/>
                              </GeometryDrawing.Geometry>
                          </GeometryDrawing>
                      </DrawingGroup>
                  </DrawingBrush.Drawing>
              </DrawingBrush>
          </Border.Background>
      </Border>
      <!-- F15b: Measured rule lines (Lined/Grid) — drawn at the actual rendered
           line positions (via TextPointer), so they always track real text rows
           regardless of font metrics, DPI, or scroll position. -->
      <Canvas x:Name="RuleCanvas"
              IsHitTestVisible="False"
              ClipToBounds="True"/>
      <RichTextBox x:Name="ContentBox"
               Background="Transparent"
               BorderThickness="0"
               Padding="10,8"
               Margin="0,0,0,88"
               MinHeight="0"
               AcceptsReturn="True"
               AcceptsTab="True"
               VerticalScrollBarVisibility="Auto"
               SpellCheck.IsEnabled="True"
               TextChanged="ContentBox_TextChanged"
               ToolTip="Note content — type here"
               AutomationProperties.Name="Note content"
               AutomationProperties.HelpText="Right-click anywhere for Format / Pin / Hide / Auto-blur / Delete. Ctrl+Z to undo."
               PreviewMouseRightButtonDown="ContentBox_PreviewMouseRightButtonDown">
        <RichTextBox.Resources>
          <!-- Remove default white paragraph background -->
          <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0"/>
          </Style>
        </RichTextBox.Resources>
        <RichTextBox.Effect>
          <BlurEffect x:Name="ContentBlur" Radius="0"/>
        </RichTextBox.Effect>
      </RichTextBox>

      <!-- F12: Markdown preview (shown when MD toggle is ON) -->
      <FlowDocumentScrollViewer x:Name="MarkdownViewer"
                                Visibility="Collapsed"
                                IsSelectionEnabled="True"
                                VerticalScrollBarVisibility="Auto"
                                Background="{DynamicResource BrushBg}"
                                Foreground="{DynamicResource BrushText}"
                                FontFamily="{Binding Note.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding Note.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>

      <!-- Undo toast — shown after significant text deletion. Lifetime = Settings "Show Undo prompt for"
           (0 = until dismissed); countdown pauses on hover/focus (WCAG 2.2.1/2.2.3). -->
      <Border x:Name="NoteUndoToast"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Margin="6,0,6,38"
              Padding="10,6"
              CornerRadius="4"
              Visibility="Collapsed"
              Panel.ZIndex="10"
              Background="{DynamicResource BrushSurf2}"
              BorderBrush="{DynamicResource BrushDivider}" BorderThickness="1"
              MouseEnter="NoteUndoToast_HoldChanged" MouseLeave="NoteUndoToast_HoldChanged"
              IsKeyboardFocusWithinChanged="NoteUndoToast_FocusChanged">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="Text deleted"
                     Foreground="{DynamicResource BrushText}" FontSize="{DynamicResource FontSizeCaption}"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Assertive"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Undo"
                    MinHeight="44" Padding="12,4" Margin="8,0,0,0"
                    Click="BtnNoteUndo_Click"
                    AutomationProperties.Name="Undo text deletion"/>
            <Button Content="✕" Margin="6,0,0,0"
                    Click="BtnNoteUndoDismiss_Click"
                    ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss undo prompt"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Quick color bar — always-visible footer strip, one click to recolor the note.
           Independent of the full Format… dialog (still available via right-click),
           which covers font/size/opacity/texture.
           Single 44px row: colors + palette button on the left, opacity slider on the
           right (2026-09-09 — collapsed from two stacked rows now that Aa/MD moved to
           the right-click menu freed up enough width for everything to share one row). -->
      <Border VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Height="44">
        <Border.Background>
          <SolidColorBrush Color="#000000" Opacity="0.28"/>
        </Border.Background>
        <Grid Margin="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      HorizontalAlignment="Left">
            <RadioButton x:Name="BtnQC1" Tag="#FFD700" Click="QuickColor_Click"
                         Style="{StaticResource QuickColorSwatch}"
                         Background="#FFD700" BorderBrush="#33000000"
                         ToolTip="Yellow" AutomationProperties.Name="Note color yellow"/>
            <RadioButton x:Name="BtnQC2" Tag="#90EE90" Click="QuickColor_Click"
                         Style="{StaticResource QuickColorSwatch}"
                         Background="#90EE90" BorderBrush="#33000000"
                         ToolTip="Green" AutomationProperties.Name="Note color green"/>
            <RadioButton x:Name="BtnQC3" Tag="#87CEEB" Click="QuickColor_Click"
                         Style="{StaticResource QuickColorSwatch}"
                         Background="#87CEEB" BorderBrush="#33000000"
                         ToolTip="Blue" AutomationProperties.Name="Note color blue"/>
            <RadioButton x:Name="BtnQC4" Tag="#FFB6C1" Click="QuickColor_Click"
                         Style="{StaticResource QuickColorSwatch}"
                         Background="#FFB6C1" BorderBrush="#33000000"
                         ToolTip="Pink" AutomationProperties.Name="Note color pink"/>
            <RadioButton x:Name="BtnQC5" Tag="#2A2A2A" Click="QuickColor_Click"
                         Style="{StaticResource QuickColorSwatch}"
                         Background="#2A2A2A" BorderBrush="#99FFFFFF"
                         ToolTip="Dark" AutomationProperties.Name="Note color dark gray"/>
            <Button Click="CmdFormat_Click"
                    Width="44" Height="44" Padding="0" Margin="4,0,0,0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="More colors and formatting..."
                    AutomationProperties.Name="Open format dialog for more colors">
              <Image Source="{StaticResource JtIcon.Theme}" Style="{StaticResource JtSoloIcon}"/>
            </Button>
          </StackPanel>

          <Slider x:Name="SldOpacity" Grid.Column="1"
                  Minimum="0.10" Maximum="1.00" SmallChange="0.05" LargeChange="0.10"
                  Width="100" Height="44" VerticalAlignment="Center"
                  HorizontalAlignment="Right" Margin="8,0,44,0"
                  ToolTip="Note opacity (10–100%)"
                  AutomationProperties.Name="Note opacity"
                  ValueChanged="SldOpacity_ValueChanged"/>
        </Grid>
      </Border>

      <!-- Floating rich-text formatting toolbar — shown via the right-click menu's
           "Aa Formatting toolbar" item (moved off the footer 2026-09-09).
           Overlays the top of ContentBox while editing; built lazily in code-behind. -->
      <Border x:Name="FormatToolbarHost"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch"
              Background="#DD1A1A1A"
              Visibility="Collapsed"
              Panel.ZIndex="8"/>

      <!-- Hide-note overlay (privacy screen, not encryption — NS-02 option C). Theme tokens, not literals. -->
      <Border x:Name="LockOverlay"
              Visibility="Collapsed"
              Background="{DynamicResource BrushSurf}"
              BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0"
              Panel.ZIndex="20"
              CornerRadius="0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
          <Image Source="{StaticResource JtIcon.EyeOff}" Width="32" Height="32" HorizontalAlignment="Center"
                 AutomationProperties.Name="Hidden note"/>
          <TextBlock Text="Hidden note" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushText}"
                     HorizontalAlignment="Center" Margin="0,4,0,2"/>
          <TextBlock Text="Enter PIN or master passphrase" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushMuted}"
                     HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <PasswordBox x:Name="PinBox"
                       MaxLength="128" Width="200" MinHeight="44"
                       VerticalContentAlignment="Center"
                       ToolTip="Enter 4–9 digit PIN or master passphrase"
                       AutomationProperties.Name="PIN or master passphrase"
                       KeyDown="PinBox_KeyDown"/>
          <Button x:Name="BtnUnlock"
                  Content="Show"
                  Style="{StaticResource PrimaryButton}"
                  Margin="0,8,0,0" MinHeight="44" MinWidth="96"
                  HorizontalAlignment="Center" Padding="16,0"
                  Click="BtnUnlock_Click"
                  AutomationProperties.Name="Show hidden note"/>
          <TextBlock x:Name="PinErrorText"
                     Text="" Foreground="{DynamicResource BrushRedText}" FontSize="{DynamicResource FontSizeCaption}"
                     Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="220"
                     AutomationProperties.LiveSetting="Assertive"
                     Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <!-- Move grip overlay (top-left) — only visible when the title bar is hidden,
           so a borderless note can still be dragged. -->
      <Border x:Name="MoveGrip"
              Width="44" Height="44"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="2,2,0,0"
              CornerRadius="6,0,6,0"
              Background="{DynamicResource BrushBlue}"
              Panel.ZIndex="6"
              Visibility="Collapsed"
              Cursor="SizeAll"
              MouseLeftButtonDown="MoveGrip_MouseLeftButtonDown"
              ToolTip="Drag to move note (title bar hidden) — or Alt+Arrow keys"
              AutomationProperties.Name="Move note handle">
        <TextBlock Text="✥" FontSize="16" Foreground="{DynamicResource BrushOnAccent}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Border>

      <!-- Resize grip overlay (bottom-right, floats above content) -->
      <!-- L-4: 44x44 hit area (WCAG 2.5.5 AAA min touch target) around the
           original 16x16 visible glyph, which stays anchored bottom-right so
           the note's visual footprint is unchanged. -->
      <Grid Width="44" Height="44"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Panel.ZIndex="5"
            Background="Transparent"
            Cursor="SizeNWSE"
            MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
            ToolTip="Drag to resize note"
            AutomationProperties.Name="Resize handle">
        <Path x:Name="ResizeGripGlyph" Width="16" Height="16"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,2,2"
              Fill="{DynamicResource BrushMuted}" IsHitTestVisible="False">
          <Path.Data>
            <PathGeometry>
              <PathFigure StartPoint="0,16" IsClosed="true">
                <LineSegment Point="16,16"/>
                <LineSegment Point="16,0"/>
              </PathFigure>
            </PathGeometry>
          </Path.Data>
        </Path>
      </Grid>
      </Grid>  <!-- /content overlay grid -->

    </Grid>
  </Border>
</Window>
