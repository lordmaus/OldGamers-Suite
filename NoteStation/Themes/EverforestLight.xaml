<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Everforest Light — soft forest (light) -->
  <SolidColorBrush x:Key="BrushBg"           Color="#FDF6E3"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#EADBBE"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#D5C9AA"/>
  <SolidColorBrush x:Key="BrushText"         Color="#333A3F"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#333A3F"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#3F4742"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#4B9ECA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F96461"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#8DA101"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#DFA000"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#F57D26"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#DFA000"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#DF69BA"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#DF69BA"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#35A77C"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#F4ECD8"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#B8BFC3"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#603E00"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#494949"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#738077"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#8E0806"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#1D4962"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#404900"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#5A4100"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
