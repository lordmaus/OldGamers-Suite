<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- CoffeeShop — warm dark coffee palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#2C1810"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3A2015"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#4A2A1C"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E8D5C8"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#D2BBB0"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#CAABA0"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80D8FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#66BB6A"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#A0673A"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F48FB1"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#1E0F09"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5A3020"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#956453"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F59896"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#80D8FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#77C27A"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
