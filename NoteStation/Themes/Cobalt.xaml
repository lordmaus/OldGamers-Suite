<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cobalt — vivid cobalt blue palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#001A33"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#002147"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#002E60"/>
  <SolidColorBrush x:Key="BrushText"         Color="#BBDEFB"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#94BDFF"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#7FB0DE"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#1258A8"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#B50023"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00E676"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF6D00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#AA00FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF4081"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#1DE9B6"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#001226"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#003060"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#AAAAAA"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#4C90D0"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF879E"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#76AFF0"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00E676"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
