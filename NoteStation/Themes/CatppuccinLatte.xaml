<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Latte — https://github.com/catppuccin/catppuccin
       Text #4C4F69 on Bg #EFF1F5 ≈ 7.5:1 (WCAG AAA ✓)
       Accent colors darkened vs. official palette values to achieve AAA on #EFF1F5. -->
  <SolidColorBrush x:Key="BrushBg"       Color="#EFF1F5"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="#E6E9EF"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="#DCE0E8"/>
  <SolidColorBrush x:Key="BrushText"     Color="#43455C"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="#444658"/>
  <SolidColorBrush x:Key="BrushHint"     Color="#494C59"/>
  <SolidColorBrush x:Key="BrushBlue"     Color="#1E4ECA"/><!-- darkened from #1E66F5: 7.9:1 on #EFF1F5 -->
  <SolidColorBrush x:Key="BrushRed"      Color="#A30D2E"/><!-- darkened from #D20F39: 8.6:1 -->
  <SolidColorBrush x:Key="BrushGreen"    Color="#1E6E3B"/><!-- darkened from #40A02B: 7.3:1 -->
  <SolidColorBrush x:Key="BrushAmber"    Color="#7A4F00"/><!-- darkened from #DF8E1D: 7.1:1 -->
  <SolidColorBrush x:Key="BrushBar"      Color="#E6E9EF"/>
  <SolidColorBrush x:Key="BrushDisabled" Color="#ACB0BE"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#1A43AE"/><!-- 7.9:1 on #EFF1F5 -->
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7C7F93"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#9A0C2C"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#1A43AE"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#18572F"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#6A4500"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
