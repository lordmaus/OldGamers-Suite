<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Obsidian — polished volcanic glass -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1B1B1F"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#25252A"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#36363C"/>
  <SolidColorBrush x:Key="BrushText"         Color="#DDDEE6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#C5C5CE"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#B0B0B6"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#5B9BF5"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#E2747C"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#56B6C2"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#D19A66"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#D19A66"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#E5C07B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#C678DD"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF79A8"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#56B6C2"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#131316"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5A5A65"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#75757F"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#EA9BA1"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#81B2F7"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#65BDC7"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#D7A779"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
