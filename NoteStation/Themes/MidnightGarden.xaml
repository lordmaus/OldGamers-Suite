<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Midnight Garden — dark botanical night -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D1B0F"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#12240F"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#1A3018"/>
  <SolidColorBrush x:Key="BrushText"         Color="#A8D8A8"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#9CC09C"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#8EB48E"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#EF9A9A"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#66BB6A"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFAB40"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F48FB1"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#081208"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#2A4A2A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#507850"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#EF9A9A"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#68BC6C"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
