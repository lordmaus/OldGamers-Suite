<Application x:Class="NoteStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoteStation"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Active theme — swapped at runtime by App.SetTheme() -->
        <ResourceDictionary Source="Themes/Dark.xaml"/>
        <!-- Fixed-color JT icon set (theme-independent). Must stay AFTER the theme slot (index 0). -->
        <ResourceDictionary Source="Theming/ColorIcons.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ── App-wide font family + size anchors (swappable at runtime) ── -->
      <!-- Editorial redesign 2026-09-04: Inter/Instrument Serif lead the
           fallback chain so the app picks them up the moment either font is
           installed or embedded, with zero code change and no risk if
           neither is present yet — WPF silently falls through the comma
           list to the next installed family. -->
      <FontFamily x:Key="AppFontFamily">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="DisplayFontFamily">Instrument Serif, Georgia, Times New Roman, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
      <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
      <sys:Double x:Key="UiTitleBase">17</sys:Double>
      <sys:Double x:Key="UiButtonBase">12</sys:Double>
      <sys:Double x:Key="UiBodyBase">13</sys:Double>

      <!-- ── WCAG 2.2 AAA type ramp (1.4.8, low-vision goal): 12px floor. Always DynamicResource;
           code uses Controls/TypeRamp. Ported from TimerStudio 2026-09-25. ── -->
      <sys:Double x:Key="FontSizeCaption">12</sys:Double>
      <sys:Double x:Key="FontSizeBody">14</sys:Double>
      <sys:Double x:Key="FontSizeTitle">18</sys:Double>

      <!-- ── Headings (2.4.10 Section Headings): section labels = Level2, dialog titles = Level1.
           Local FontSize/Foreground/Margin on an element still win; the style guarantees the UIA heading. ── -->
      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
      </Style>
      <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
      </Style>


      <!-- Fixed-color JT icons (Theming/ColorIcons.xaml). Never recolored per theme;
           always paired with a text label or AutomationProperties.Name. Disabled = faded. -->
      <Style x:Key="JtBtnIcon" TargetType="Image">
        <Setter Property="Width"             Value="18"/>
        <Setter Property="Height"            Value="18"/>
        <Setter Property="Stretch"           Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,7,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.4"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="JtSoloIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="JtInlineIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>
      <Style x:Key="JtMenuIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <!-- Converters -->
      <local:StringToVisibilityConverter   x:Key="StringToVisibilityConverter"/>
      <local:BoolToVisibilityConverter     x:Key="BoolToVis"/>
      <local:BoolToVisibilityConverter     x:Key="BoolToVisInvert" Invert="True"/>
      <local:StringToColorConverter        x:Key="StringToColorConverter"/>
      <local:BoolToStrikethroughConverter  x:Key="BoolToStrike"/>
      <local:BoolToVisibleTextConverter    x:Key="BoolToVisibleText"/>
      <local:CategoryToColorConverter      x:Key="CategoryToColor"/>
      <local:CategoryToTextColorConverter  x:Key="CategoryToTextColor"/>
      <local:FolderAccentBarConverter      x:Key="FolderAccentBar"/>
      <local:JtIconConverter               x:Key="JtIconConv"/>
      <local:ClipImageConverter            x:Key="ClipImageConv"/>
      <!-- D3-4: Priority converters -->
      <local:NonZeroToVisibilityConverter  x:Key="NonZeroToVis"/>
      <local:PriorityToColorConverter      x:Key="PriorityToColor"/>
      <local:PriorityToLabelConverter      x:Key="PriorityToLabel"/>
      <local:PriorityToGlyphConverter      x:Key="PriorityToGlyph"/>

      <!-- ── Tooltip style ── -->
      <Style TargetType="ToolTip">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
      </Style>

      <!-- ── Base flat button — WCAG AAA: 44px min target, 2px Gold/Cyan focus ring.
           TargetType ButtonBase so implicit Button AND ToggleButton styles can be BasedOn it.
           Hover/press keep full text contrast (no opacity dimming): hover = 1px BrushText outline,
           press = 97% scale (non-colour cues). Suite-canonical (TimerStudio 2026-09-25). ── -->
      <Style x:Key="FlatButton" TargetType="ButtonBase">
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="MinWidth"        Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ButtonBase">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="6"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RecognizesAccessKey="True"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Primary (accent) button ── -->
      <Style x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- ── Danger button ── -->
      <Style x:Key="DangerButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushRed}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- ── Implicit Button / ToggleButton (F6): no default OS chrome anywhere in the app.
           Opt out per element with Style="{x:Null}" (used by the ComboBox template's toggle). ── -->
      <Style TargetType="Button" BasedOn="{StaticResource FlatButton}"/>
      <Style x:Key="FlatToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource FlatButton}">
        <Style.Triggers>
          <!-- Checked = accent fill + OnAccent text + 1px text outline (shape cue, not colour-only) -->
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Background"  Value="{DynamicResource BrushBlue}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrushOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushText}"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="ToggleButton" BasedOn="{StaticResource FlatToggleButton}"/>

      <!-- ── Status-bar link button (transparent, underlines on hover) ── -->
      <Style x:Key="StatusLink" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <!-- L-4 pattern: 44px min hit area around a smaller visible glyph, same as the
             note window's resize grip — the pill stays compact, the click target doesn't. -->
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="MinWidth"        Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="3"
                        Margin="-2" Opacity="0"/>
                <TextBlock x:Name="Tb"
                           Text="{TemplateBinding Content}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Tb" Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── NavRow tab button — segmented pill, active = gold fill ── -->
      <Style x:Key="NavButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding"    Value="18,0"/>
        <Setter Property="MinHeight"  Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="24"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="22"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RecognizesAccessKey="True"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── ComboBox (full themed template — fixes contrast in dark themes) ── -->
      <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="ComboBoxItem">
              <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
              <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
              <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
              <Setter Property="FontSize"    Value="13"/>
              <Setter Property="Padding"     Value="8,6"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <!-- Highlight: Surf2 + 3px BrushText bar (non-colour cue) -->
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushSurf2}"/>
                        <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{DynamicResource BrushText}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushBlue}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsSelected"    Value="True"/>
                          <Condition Property="IsHighlighted" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource BrushBlue}"/>
                        <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{DynamicResource BrushOnAccent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="MainBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      TextElement.Foreground="{DynamicResource BrushText}"/>
                    <TextBox x:Name="PART_EditableTextBox"
                             Grid.Column="0" Visibility="Hidden"
                             AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                             Background="Transparent"
                             Foreground="{DynamicResource BrushText}"
                             BorderThickness="0"
                             Margin="{TemplateBinding Padding}"
                             VerticalAlignment="Center"
                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <Border Grid.Column="1" Background="Transparent" CornerRadius="0,3,3,0">
                      <TextBlock Text="∨" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushMuted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="Transparent" BorderThickness="0"
                                  Style="{x:Null}"/>
                  </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Slide">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1" CornerRadius="0,0,3,3"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer SnapsToDevicePixels="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing"  Property="Opacity"     Value="1"/>
                  <Setter TargetName="MainBorder" Property="BorderBrush"
                          Value="{DynamicResource FocusRingBrush}"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                  <Setter TargetName="MainBorder" Property="BorderBrush"
                          Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── TextBox ── -->
      <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource BrushBlue}"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- ── CheckBox (ported from TimerStudio 2026-09-25): 18px box + ✓ glyph (shape cue),
           44px row, 2px FocusRingBrush ring. ── -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground"              Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"              Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                Value="13"/>
        <Setter Property="MinHeight"               Value="44"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"        Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent" MinHeight="44" MinWidth="44">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4"
                        Margin="-2" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                  <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Border x:Name="CheckBorder"
                            BorderBrush="{DynamicResource BrushMuted}"
                            BorderThickness="1.5" CornerRadius="3"
                            Background="Transparent"/>
                    <TextBlock x:Name="CheckMark" Text="✓"
                               FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource BrushBlueText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" Opacity="0"/>
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="CheckMark"   Property="Opacity"      Value="1"/>
                  <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushBlueText}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── ScrollBar ── -->
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushSurf2}"/>
      </Style>

      <!-- ── ListBox (F5/F6: previously unstyled) ── -->
      <Style TargetType="ListBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
      </Style>

      <!-- ── ListBoxItem — text stays BrushText (7:1 on Surf2) in every state.
           Hover = Surf2 + 1px BrushText outline; Selected = Surf2 + 4px BrushBlueText bar;
           keyboard focus = 2px FocusRingBrush ring. Non-colour cues for every state (1.4.1). ── -->
      <Style TargetType="ListBoxItem">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="1"
                        SnapsToDevicePixels="True">
                  <Border x:Name="Bar" BorderBrush="Transparent" BorderThickness="4,0,0,0"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Border>
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd"  Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource BrushBlueText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Content font sizes (per-tab, swapped at runtime) ── -->
      <sys:Double x:Key="ClipFontBase">13</sys:Double>
      <sys:Double x:Key="NoteFontBase">13</sys:Double>
      <sys:Double x:Key="TaskFontBase">13</sys:Double>
      <sys:Double x:Key="FolderFontBase">12</sys:Double>
      <sys:Double x:Key="FolderAccentBarWidth">3</sys:Double>

      <!-- ── Separator ── -->
      <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BrushDivider}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,6"/>
      </Style>

      <!-- ── TreeView ── -->
      <Style TargetType="TreeView">
        <Setter Property="Background"   Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"      Value="2"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      </Style>

      <!-- ── Tree expand toggle button ── -->
      <Style x:Key="TreeExpanderBtn" TargetType="ToggleButton">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent" Width="16" Height="16"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path x:Name="Arrow"
                      Data="M6,4 L10,8 L6,12"
                      Stroke="{DynamicResource BrushMuted}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Arrow" Property="Data" Value="M4,6 L8,10 L12,6"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── TreeViewItem — full ControlTemplate for correct theme colours ── -->
      <Style TargetType="TreeViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="2"
                        MinHeight="44" Padding="4,0"
                        SnapsToDevicePixels="True">
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="Expander"
                                  Grid.Column="0"
                                  Style="{StaticResource TreeExpanderBtn}"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsExpanded,
                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Header"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                  </Grid>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <!-- Hover: Surf2 + 1px BrushText outline (non-colour cue) -->
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                  <Setter TargetName="Bd" Property="Padding"         Value="5,1,5,1"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                  <Setter TargetName="Bd" Property="Padding"         Value="2,0,4,0"/>
                  <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <!-- Multi-select highlight (Ctrl+click) — distinct from single-select blue -->
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                  <Setter TargetName="Bd" Property="Background"   Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource BrushBlueText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Overlay windows: header/close button ── -->
      <!-- Overlay windows merge Theming/OverlayPalette.xaml, so the DynamicResource brushes here
           resolve to the fixed-dark overlay palette there (and to the app theme anywhere else). -->
      <Style x:Key="OvBtn" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushMuted}"/>
        <Setter Property="BorderBrush"  Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="FontFamily"   Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Padding"      Value="6,2"/>
        <Setter Property="MinWidth"     Value="44"/>
        <Setter Property="MinHeight"    Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Fixed-dark overlay windows (ClipOverlayWindow/TaskOverlayWindow): filter chip RadioButton.
           These windows paint their own fixed #CC1A1B2E chrome regardless of app theme, so this
           style intentionally keeps hardcoded colors rather than following DynamicResource. ── -->
      <Style x:Key="OverlayFilterChip" TargetType="RadioButton">
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="Foreground"     Value="{DynamicResource BrushMuted}"/>
        <Setter Property="BorderBrush"    Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"         Value="Hand"/>
        <Setter Property="FontFamily"     Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"       Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Padding"        Value="8,3"/>
        <Setter Property="Margin"         Value="0,0,4,0"/>
        <!-- L-4 pattern: 44px min hit area around the compact visible pill, matching
             FlatButton/StatusLink and the note window's resize grip. Focus ring is the
             app's standard outer 2px FocusRingBrush ring, not a one-off inset border. -->
        <Setter Property="MinHeight"      Value="44"/>
        <Setter Property="MinWidth"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="12"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Checked: tint + 2px outline + SemiBold + full-strength text (not colour-only) -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushBlueText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                  <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── Theme-aware filter chip RadioButton (MainWindow, StickyNoteFormatDialog — anything that
           follows the active app theme). Foreground/BorderBrush route through DynamicResource so
           they stay AAA-contrast on light themes too; see App-standards review 2026-09-07 #3. ── -->
      <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="Foreground"     Value="{DynamicResource BrushMuted}"/>
        <Setter Property="BorderBrush"    Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"         Value="Hand"/>
        <Setter Property="FontFamily"     Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"       Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Padding"        Value="8,3"/>
        <Setter Property="Margin"         Value="0,0,4,0"/>
        <!-- L-4 pattern: 44px min hit area around the compact visible pill, matching
             FlatButton/StatusLink and the note window's resize grip. Focus ring is the
             app's standard outer 2px FocusRingBrush ring, not a one-off inset border. -->
        <Setter Property="MinHeight"      Value="44"/>
        <Setter Property="MinWidth"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="12"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Checked: tint + 2px outline + SemiBold + full-strength text (not colour-only) -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background"      Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource BrushBlueText}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                  <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>


      <!-- ── DatePicker — theme-aware ── -->
      <!-- Calendar popup background and foreground -->
      <Style TargetType="Calendar">
        <Setter Property="Background"   Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"   Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"     Value="12"/>
      </Style>

      <Style TargetType="CalendarDayButton">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="MinWidth"     Value="30"/>
        <Setter Property="MinHeight"    Value="30"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
          </Trigger>
          <Trigger Property="IsToday" Value="True">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBlueText}"/>
          </Trigger>
          <Trigger Property="IsInactive" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
          </Trigger>
          <!-- Selected today: BlueText on Blue fill would vanish — OnAccent wins -->
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True"/>
              <Condition Property="IsToday"    Value="True"/>
            </MultiTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="CalendarButton">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Style.Triggers>
          <!-- CalendarButton is the month/year nav header — only hover state needed -->
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="CalendarItem">
        <Setter Property="Background"   Value="{DynamicResource BrushSurf}"/>
        <Setter Property="BorderBrush"  Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>

      <Style TargetType="DatePicker">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="4,3"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
      </Style>

      <!-- ── DatePickerTextBox inside DatePicker ── -->
      <Style TargetType="DatePickerTextBox">
        <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"    Value="2,2"/>
      </Style>

      <!-- ── F6 implicit styles: PasswordBox / RichTextBox / ListView / RadioButton.
           Copied from TimerStudio/App.xaml (suite source for these; FileCopy has none). ── -->
      <Style TargetType="PasswordBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource BrushBlue}"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="RichTextBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource BrushBlue}"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RichTextBox">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ListViewItem: plain ContentPresenter template — NOT for GridView ListViews
           (those need a GridViewRowPresenter; give them a local ItemContainerStyle). -->
      <Style x:Key="ThemedListViewItem" TargetType="ListViewItem">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource BrushText}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"                    Value="6,4"/>
        <Setter Property="MinHeight"                  Value="44"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="4,0,0,0"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="-1" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Hover: Surf2 + Muted bar; Selected: Surf2 + accent bar. Text stays BrushText (7:1 on Surf2). -->
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ListView">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedListViewItem}"/>
      </Style>

      <!-- RadioButton (ported from BadgeOverlay/Themes/_Inputs.xaml): 18px ring + 10px dot,
           44px row, 2px FocusRingBrush ring like CheckBox. -->
      <Style TargetType="RadioButton">
        <Setter Property="Foreground"               Value="{DynamicResource BrushText}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="FontFamily"               Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="MinHeight"                Value="44"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent" MinHeight="44">
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4" Margin="-2" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                  <Border x:Name="OuterRing" Width="18" Height="18" CornerRadius="9"
                          BorderThickness="2" BorderBrush="{DynamicResource BrushMuted}"
                          Background="{DynamicResource BrushSurf}" Margin="0,0,8,0"
                          VerticalAlignment="Center">
                    <Ellipse x:Name="InnerDot" Width="10" Height="10"
                             Fill="{DynamicResource BrushBlueText}" Visibility="Collapsed"/>
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="InnerDot"  Property="Visibility"  Value="Visible"/>
                  <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushBlueText}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>


      <!-- GridView-safe ListViewItem (GridViewRowPresenter) — ListViews with a View="GridView"
           set this locally (the implicit ListView style's ThemedListViewItem is ContentPresenter-only). -->
      <Style x:Key="ThemedGridViewItem" TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="4,0,0,0"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                  <GridViewRowPresenter VerticalAlignment="Center"
                                        Columns="{TemplateBinding GridView.ColumnCollection}"/>
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="-1" Opacity="0" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlueText}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GridViewColumnHeader">
              <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrushDivider}"
                      BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── GroupBox (F6: previously default etched OS chrome) — header is text-strength, frame BrushDivider ── -->
      <Style TargetType="GroupBox">
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="GroupBox">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ContentPresenter Grid.Row="0" ContentSource="Header" RecognizesAccessKey="True"
                                  Margin="0,0,0,4" TextElement.FontWeight="SemiBold"
                                  TextElement.FontSize="{DynamicResource FontSizeCaption}"
                                  TextElement.Foreground="{DynamicResource BrushMuted}"/>
                <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}" CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ── ProgressBar (ported from FileCopy): BlueText fill ≥3:1, Divider outline ≥3:1 on Surf ── -->
      <Style TargetType="ProgressBar">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushBlueText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight"       Value="6"/>
      </Style>

      <!-- L-4: global Slider style — previously unstyled everywhere in the
           app (default WPF chrome: thin system-colour track, ~10px thumb).
           Fails WCAG AAA on two counts: contrast against dark themes and the
           44px minimum touch target. Track/thumb now use theme brushes and
           the thumb hit area is bumped to 20px inside a 44px-tall row. -->
      <Style TargetType="Slider">
        <Setter Property="Height"           Value="28"/>
        <Setter Property="MinHeight"        Value="44"/>
        <Setter Property="Focusable"        Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid Background="Transparent" VerticalAlignment="Center" MinHeight="44">
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="6"
                        Margin="0,10" Opacity="0"/>
                <Border x:Name="TrackBg"
                        Height="4" CornerRadius="2"
                        Background="{DynamicResource BrushMuted}"
                        VerticalAlignment="Center"/>
                <Track x:Name="PART_Track" VerticalAlignment="Center">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                  AutomationProperties.Name="Decrease value">
                      <RepeatButton.Style>
                        <Style TargetType="RepeatButton">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="RepeatButton">
                                <Border Height="4" CornerRadius="2"
                                        Background="{DynamicResource BrushBlue}"/>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </RepeatButton.Style>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                  AutomationProperties.Name="Increase value">
                      <RepeatButton.Style>
                        <Style TargetType="RepeatButton">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </RepeatButton.Style>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <!-- L-4 follow-up: hit area widened to 44x44 (WCAG SC 2.5.5/2.5.8)
                         via a transparent template root; the visible glyph stays a
                         20x20 Ellipse centered inside it, so the look is unchanged. -->
                    <Thumb x:Name="SliderThumb" Width="44" Height="44">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent">
                            <Ellipse Width="20" Height="20"
                                     Fill="{DynamicResource BrushBlue}"
                                     Stroke="{DynamicResource BrushBg}"
                                     StrokeThickness="2"/>
                          </Grid>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="TrackBg" Property="Opacity" Value="0.5"/>
                  <Setter TargetName="PART_Track" Property="Opacity" Value="0.5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>


      <!-- L-1 (code review) / A11y M2: implicit ContextMenu/MenuItem style —
           previously fully unstyled (OS-default light popup chrome behind
           dark/neon themes). Copied verbatim from TimerStudio's fix for
           cross-app consistency (2026-09-14 CodeSecA11y review). -->
      <Style TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="2"/>
        <Setter Property="HasDropShadow"   Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Background" Value="{DynamicResource BrushDivider}"/>
        <Setter Property="Margin"     Value="6,4"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="{TemplateBinding Background}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="MenuItem">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="MinHeight"        Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Grid x:Name="Root" Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="20"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto" MinWidth="14"/>
                </Grid.ColumnDefinitions>
                <!-- Hover/keyboard highlight bar: non-colour cue alongside the Surf2 fill -->
                <Border x:Name="HighlightBar" Grid.Column="0" Width="3"
                        HorizontalAlignment="Left" Background="{DynamicResource BrushText}"
                        Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                  Margin="4,0" VerticalAlignment="Center"/>
                <Path x:Name="CheckMark" Grid.Column="0" Data="M2,7 L6,11 L13,3"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" Margin="4,0"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource BrushMuted}"
                           Margin="12,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#9656;" FontSize="{DynamicResource FontSizeCaption}"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushMuted}"
                           Visibility="Collapsed"/>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="1" Opacity="0"
                        IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       Placement="Right" HorizontalOffset="-4" VerticalOffset="-2"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1" CornerRadius="4" Padding="2">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                  <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurf2}"/>
                  <Setter TargetName="HighlightBar" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
