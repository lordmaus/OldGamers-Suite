<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Platform-versioned TFM required for WinRT Windows.Media.Ocr (screenshot OCR in StickyNoteWindow). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>NoteStation</AssemblyName>
    <RootNamespace>NoteStation</RootNamespace>
    <!-- Embeds the icon as the native EXE icon so the taskbar / Alt-Tab show it (not just the window). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- DPI: PerMonitorV2 handled by .NET (modern replacement for manifest dpiAware). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version -->
    <Version>2026.10.12.0003</Version>
    <FileVersion>2026.10.12.0003</FileVersion>
    <AssemblyVersion>2026.10.12.3</AssemblyVersion>

    <Product>NoteStation</Product>
    <Company>Matthew Pittman</Company>
    <Copyright>Copyright 2026 Matthew Pittman</Copyright>
    <Description>Clipboard manager, sticky notes overlay, and task manager for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoteStation.Tests" />
  </ItemGroup>

  <!-- Suite (2026-10-13): shared library + canonical themes (Shared\Themes, linked so "Themes/X.xaml" URIs still resolve). -->
  <ItemGroup>
    <ProjectReference Include="..\Shared\OldGamers.Wpf.Shared\OldGamers.Wpf.Shared.csproj" />
    <Page Include="..\Shared\Themes\*.xaml" Link="Themes\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
