<Window x:Class="FileCopy.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FileCopy.Controls"
        xmlns:local="clr-namespace:FileCopy"
        Title="Scheduler"
        Width="980" Height="980" MinWidth="800" MinHeight="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="13">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    <local:InverseBoolConverter x:Key="InvBool"/>

    <!-- Job list item template -->
    <DataTemplate x:Key="JobItemTemplate" DataType="{x:Type local:SchedulerJobViewModel}">
      <StackPanel Margin="8,6,8,6"
                  AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding EnabledGlyph}" Width="16" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushBlueText}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushText}"/>
          <Image Source="{StaticResource JtIcon.EventLog}" Width="14" Height="14" Margin="6,0,0,0"
                 VerticalAlignment="Center"
                 ToolTip="Job log available" AutomationProperties.Name="Job log available"
                 Visibility="{Binding HasLog, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
        <TextBlock Text="{Binding FrequencyDisplay}" FontSize="{DynamicResource FontSizeCaption}" Margin="16,2,0,0"
                   Foreground="{DynamicResource BrushMuted}"/>
        <TextBlock Text="{Binding NextRunDisplay}" FontSize="{DynamicResource FontSizeCaption}" Margin="16,0,0,0"
                   Foreground="{DynamicResource BrushHint}"
                   />
        <ItemsControl ItemsSource="{Binding RecentHistory}" Margin="16,0,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                         Foreground="{DynamicResource BrushMuted}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Flat button style — WCAG AAA: 44px target, 2px cyan focus ring (SC 2.5.5 / 2.4.7) -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background"      Value="{DynamicResource BrushSurf2}"/>
      <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight"       Value="44"/>
      <Setter Property="MinWidth"        Value="80"/>
      <Setter Property="Padding"         Value="12,0"/>
      <Setter Property="Margin"          Value="4,4,0,4"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="FontFamily"      Value="Segoe UI"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                      BorderThickness="2" CornerRadius="4" Margin="-2" Opacity="0"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      CornerRadius="3" Padding="{TemplateBinding Padding}"
                      MinHeight="{TemplateBinding MinHeight}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                <Setter Property="Cursor"     Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section header style -->
    <Style x:Key="SectionHdr" TargetType="TextBlock">
      <Setter Property="Foreground"  Value="{DynamicResource BrushMuted}"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
      <Setter Property="Margin"      Value="0,14,0,6"/>
      <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <!-- Form field label -->
    <Style x:Key="FieldLbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <!-- Form textbox -->
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="MinHeight"       Value="44"/>
      <Setter Property="Padding"         Value="8,0"/>
      <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
      <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin"          Value="0,0,0,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <!-- Outer grid — resize grip lives outside scaled content -->
  <Grid>
  <DockPanel>

    <!-- ── Full-width toolbar ── -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBar}" MinHeight="44">
      <WrapPanel Orientation="Horizontal">
        <Button         Style="{StaticResource ToolBtn}" Command="{Binding AddCommand}"
                AutomationProperties.Name="Add new scheduled job"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.NewTask}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Add" VerticalAlignment="Center"/></StackPanel></Button>
        <Button         Style="{StaticResource ToolBtn}" Command="{Binding EditCommand}"
                AutomationProperties.Name="Edit selected job"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rename}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Edit" VerticalAlignment="Center"/></StackPanel></Button>
        <Button       Style="{StaticResource ToolBtn}" Command="{Binding DeleteCommand}"
                AutomationProperties.Name="Delete selected job"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
        <Button      Style="{StaticResource ToolBtn}" Command="{Binding RunNowCommand}"
                AutomationProperties.Name="Run selected job immediately"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.QueueNow}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Run now" VerticalAlignment="Center"/></StackPanel></Button>
        <Button      Style="{StaticResource ToolBtn}" Command="{Binding ExportCommand}"
                AutomationProperties.Name="Export all jobs to JSON file"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Export}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Export" VerticalAlignment="Center"/></StackPanel></Button>
        <Button      Style="{StaticResource ToolBtn}" Command="{Binding ImportCommand}"
                AutomationProperties.Name="Import jobs from JSON file"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Import" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource ToolBtn}" Command="{Binding ViewActivityLogCommand}"
                AutomationProperties.Name="View scheduler activity log"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.EventLog}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Activity log" VerticalAlignment="Center"/></StackPanel></Button>
      </WrapPanel>
    </Border>

    <!-- ── Content split ── -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── Left: job list ── -->
      <Grid Grid.Column="0">
        <!-- Job list — SC 2.4.7/2.4.11: 2px cyan focus ring on keyboard focus -->
        <ListBox x:Name="LstJobs"
                 ItemsSource="{Binding Jobs}"
                 SelectedItem="{Binding SelectedJob}"
                 ItemTemplate="{StaticResource JobItemTemplate}"
                 Background="{DynamicResource BrushSurf}"
                 Foreground="{DynamicResource BrushText}"
                 BorderThickness="0"
                 FocusVisualStyle="{x:Null}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Scheduled jobs list"
                 Visibility="{Binding HasJobs, Converter={StaticResource BoolVis}}">
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
                  <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
        </ListBox>

        <!-- Empty state -->
        <Border Background="{DynamicResource BrushSurf}"
                Visibility="{Binding HasJobs, Converter={StaticResource InvBoolVis}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
            <TextBlock Text="No scheduled jobs yet." TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushMuted}" FontSize="13"
                       TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Click ＋ Add to create your first job."
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource BrushMuted}" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Separator ── -->
      <Border Grid.Column="1" Background="{DynamicResource BrushSurf2}"/>

      <!-- ── Right: edit form ── -->
      <ScrollViewer Grid.Column="2"
                    VerticalScrollBarVisibility="Auto"
                    Padding="20,16,20,16">
        <StackPanel>

          <!-- JOB DETAILS -->
          <TextBlock Text="JOB DETAILS" Style="{StaticResource SectionHdr}"/>

          <TextBlock Text="Name" Style="{StaticResource FieldLbl}"/>
          <TextBox Text="{Binding EditLabel, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="Job name"
                   AutomationProperties.HelpText="Short descriptive name for this job"/>

          <!-- Source -->
          <TextBlock Text="Source folder" Style="{StaticResource FieldLbl}"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding EditSource, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}" Margin="0"
                     AutomationProperties.Name="Source folder path"/>
            <Button Grid.Column="1" Style="{StaticResource ToolBtn}"
                    Margin="6,0,0,0" MinWidth="44" MinHeight="44"
                    Click="BtnPickSource_Click"
                    AutomationProperties.Name="Browse for source folder"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtSoloIcon}"/></Button>
          </Grid>

          <!-- Dest -->
          <TextBlock Text="Dest folder" Style="{StaticResource FieldLbl}"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding EditDest, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}" Margin="0"
                     AutomationProperties.Name="Destination folder path"/>
            <Button Grid.Column="1" Style="{StaticResource ToolBtn}"
                    Margin="6,0,0,0" MinWidth="44" MinHeight="44"
                    Click="BtnPickDest_Click"
                    AutomationProperties.Name="Browse for destination folder"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtSoloIcon}"/></Button>
          </Grid>

          <CheckBox Content="Enabled" IsChecked="{Binding EditEnabled}"
                    Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"
                    AutomationProperties.Name="Job enabled"/>

          <!-- SCHEDULE -->
          <TextBlock Text="SCHEDULE" Style="{StaticResource SectionHdr}"/>

          <TextBlock Text="Frequency" Style="{StaticResource FieldLbl}"/>
          <ComboBox x:Name="CmbFreq" ItemsSource="{Binding FrequencyItemsSrc}"
                    SelectedIndex="{Binding EditFreqIndex}"
                    Background="{DynamicResource BrushSurf}"
                    Foreground="{DynamicResource BrushText}"
                    BorderBrush="{DynamicResource BrushSurf2}"
                    MinHeight="44" Margin="0,0,0,10"
                    AutomationProperties.Name="Schedule frequency"/>

          <!-- Interval (EveryMinutes / EveryHours) -->
          <Grid Margin="0,0,0,10"
                Visibility="{Binding ShowInterval, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Interval" Style="{StaticResource FieldLbl}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding EditInterval, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" MinHeight="44" Padding="6,0" HorizontalAlignment="Left"
                     Background="{DynamicResource BrushSurf}" Foreground="{DynamicResource BrushText}"
                     BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
                     AutomationProperties.Name="Interval value"/>
          </Grid>

          <!-- Time of day (Daily / Weekdays / Weekly) -->
          <Grid Margin="0,0,0,10"
                Visibility="{Binding ShowTime, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Time (HH:MM)" Style="{StaticResource FieldLbl}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding EditTime, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" MinHeight="44" Padding="6,0" HorizontalAlignment="Left"
                     Background="{DynamicResource BrushSurf}" Foreground="{DynamicResource BrushText}"
                     BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
                     AutomationProperties.Name="Time of day in 24-hour format"/>
          </Grid>

          <!-- Day of week (Weekly) -->
          <Grid Margin="0,0,0,10"
                Visibility="{Binding ShowDay, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Day" Style="{StaticResource FieldLbl}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      x:Name="CmbDay" ItemsSource="{Binding DayItemsSrc}"
                      SelectedIndex="{Binding EditDayIndex}"
                      Background="{DynamicResource BrushSurf}"
                      Foreground="{DynamicResource BrushText}"
                      BorderBrush="{DynamicResource BrushSurf2}"
                      MinHeight="44"
                      AutomationProperties.Name="Day of week"/>
          </Grid>

          <!-- Run once (Once) -->
          <Grid Margin="0,0,0,10"
                Visibility="{Binding ShowOnce, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Run at" Style="{StaticResource FieldLbl}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding EditOnceDate, UpdateSourceTrigger=PropertyChanged}"
                     Width="110" MinHeight="44" Padding="6,0"
                     Background="{DynamicResource BrushSurf}" Foreground="{DynamicResource BrushText}"
                     BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
                     AutomationProperties.Name="Run once date"/>
            <TextBox Grid.Column="2" Text="{Binding EditOnceTime, UpdateSourceTrigger=PropertyChanged}"
                     Width="70" MinHeight="44" Padding="6,0" Margin="8,0,0,0"
                     Background="{DynamicResource BrushSurf}" Foreground="{DynamicResource BrushText}"
                     BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
                     AutomationProperties.Name="Run once time"/>
          </Grid>

          <!-- FILE FILTER -->
          <TextBlock Text="FILE FILTER" Style="{StaticResource SectionHdr}"/>
          <TextBlock Text="Leave blank or *.* to copy all files. Separate multiple patterns with semicolons."
                     Foreground="{DynamicResource BrushMuted}" FontSize="{DynamicResource FontSizeCaption}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>

          <TextBlock Text="Include (e.g. *.docx;*.pdf)" Style="{StaticResource FieldLbl}"/>
          <TextBox Text="{Binding EditInclude, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="Include file mask"/>

          <TextBlock Text="Exclude (e.g. thumbs.db;*.tmp)" Style="{StaticResource FieldLbl}"/>
          <TextBox Text="{Binding EditExclude, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="Exclude file mask"/>

          <CheckBox Content="Include subfolders"
                    IsChecked="{Binding EditSubdirs}"
                    Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"
                    AutomationProperties.Name="Include subfolders"/>

          <!-- COPY OPTIONS -->
          <TextBlock Text="COPY OPTIONS" Style="{StaticResource SectionHdr}"/>
          <TextBlock Text="These settings override the main window when this job runs."
                     Foreground="{DynamicResource BrushMuted}" FontSize="{DynamicResource FontSizeCaption}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>

          <CheckBox Content="Verify with CRC32 after copy"
                    IsChecked="{Binding EditVerify}"
                    IsEnabled="{Binding EditMove, Converter={StaticResource InvBool}}"
                    IsThreeState="True"
                    Foreground="{DynamicResource BrushText}" Margin="0,0,0,8"
                    AutomationProperties.Name="Verify with CRC32 after copy"/>

          <CheckBox Content="Delete source after copy (Move)"
                    IsChecked="{Binding EditMove}"
                    IsThreeState="True"
                    Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"
                    AutomationProperties.Name="Delete source after copy"/>
          <StackPanel Orientation="Horizontal" Margin="26,0,0,10"
                      Visibility="{Binding EditMove, Converter={StaticResource BoolVis}}">
            <Image Source="{StaticResource JtIcon.Checksum}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Move always verifies (CRC32) before deleting the source."
                       Foreground="{DynamicResource BrushMuted}" FontSize="{DynamicResource FontSizeCaption}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="On conflict" Style="{StaticResource FieldLbl}"/>
          <ComboBox x:Name="CmbConflict" ItemsSource="{Binding ConflictItemsSrc}"
                    SelectedIndex="{Binding EditConflict}"
                    Background="{DynamicResource BrushSurf}"
                    Foreground="{DynamicResource BrushText}"
                    BorderBrush="{DynamicResource BrushSurf2}"
                    MinHeight="44" Margin="0,0,0,10"
                    AutomationProperties.Name="On conflict action"/>

          <!-- STATUS -->
          <TextBlock Text="STATUS" Style="{StaticResource SectionHdr}"/>

          <Grid Margin="0,2,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Next run:" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding NextRunDisplay}"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
          </Grid>
          <Grid Margin="0,2,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Last run:" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding LastRunDisplay}"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
          </Grid>

          <!-- Log buttons -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding ViewJobLogCommand}"
                    AutomationProperties.Name="View this job's run log"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.EventLog}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="View job log" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding ClearJobLogCommand}"
                    AutomationProperties.Name="Clear this job's run log"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.ClearAll}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Clear job log" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>

          <!-- Save / Cancel -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource ToolBtn}"
                    Command="{Binding SaveJobCommand}"
                    Background="{DynamicResource BrushBlue}"
                    Foreground="{DynamicResource BrushSelectedText}"
                    MinWidth="120"
                    AutomationProperties.Name="Save job"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Save}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Save job" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Content="Cancel" Style="{StaticResource ToolBtn}"
                    Command="{Binding CancelEditCommand}"
                    AutomationProperties.Name="Cancel editing"/>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
    <!-- WCAG: bottom-right drag handle — canonical accessible grip (same pattern as
         MainWindow.xaml / AboutDialog.xaml / HotkeysDialog.xaml / PresetSlotDialog.xaml):
         focusable, keyboard-resizable (WCAG 2.5.7), mouse-draggable via WM_NCLBUTTONDOWN
         through shared NativeMethods. Replaces native ResizeMode="CanResizeWithGrip",
         which drew a glyph with no keyboard path — converged 2026-09-15. -->
    <ctl:AccessibleResizeGrip/>
  </Grid>
</Window>
