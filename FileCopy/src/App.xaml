<Application x:Class="FileCopy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:FileCopy"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Dark theme loaded at runtime by App.ApplyTheme.
             Included here too so the Visual Studio designer has colours. -->
        <ResourceDictionary Source="Themes/Dark.xaml"/>
        <!-- Fixed-color JT icon set (theme-independent). AppTheme.ReplaceThemeDict only swaps "Themes/" entries. -->
        <ResourceDictionary Source="Theming/ColorIcons.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Fixed-color JT icons (Theming/ColorIcons.xaml). Never recolored per theme;
           always paired with a text label or AutomationProperties.Name. Disabled = faded. -->
      <local:JtIconConverter x:Key="JtIconConverter"/>
      <Style x:Key="JtBtnIcon" TargetType="Image">
        <Setter Property="Width"             Value="18"/>
        <Setter Property="Height"            Value="18"/>
        <Setter Property="Stretch"           Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,7,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.4"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="JtSoloIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="JtInlineIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
      <Style x:Key="JtMenuIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0"/>
      </Style>
      <Style x:Key="JtHeaderIcon" TargetType="Image" BasedOn="{StaticResource JtBtnIcon}">
        <Setter Property="Width"  Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
      </Style>

      <!-- ── Low-Vision: app-wide font family + size anchors (swappable at runtime) ── -->
      <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
      <sys:Double x:Key="UiTitleBase">17</sys:Double>
      <sys:Double x:Key="UiButtonBase">12</sys:Double>
      <sys:Double x:Key="UiBodyBase">13</sys:Double>
      <!-- WCAG AAA type ramp (2026-10-13, suite standard): nothing below 12 px. -->
      <sys:Double x:Key="FontSizeCaption">12</sys:Double>
      <sys:Double x:Key="FontSizeBody">14</sys:Double>
      <!-- Section heading: exposed to screen readers as a heading (SC 1.3.1 / 2.4.10). -->
      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
      </Style>

      <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,7"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="MinWidth"        Value="44"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="6" Margin="-2" Opacity="0"/>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
        <!-- BrushSelectedText: Dark=#000000 on #00BFFF=9.9:1; Light=#FFFFFF on #0050A0=7.9:1 — both AAA -->
        <Setter Property="Foreground" Value="{DynamicResource BrushSelectedText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style x:Key="DangerButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushRed}"/>
        <!-- BrushSelectedText: Dark=#000000 on #FF8080=8.65:1; Light=#FFFFFF on #B00000=7.38:1 — both AAA -->
        <Setter Property="Foreground" Value="{DynamicResource BrushSelectedText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Per spec: Gold focus on destructive controls; Cyan elsewhere -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource GoldFocusBrush}"
                        BorderThickness="2" CornerRadius="5" Margin="-2" Opacity="0"/>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="ComboBoxItem">
              <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
              <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
              <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
              <Setter Property="FontSize"    Value="13"/>
              <Setter Property="Padding"     Value="8,10"/>
              <Setter Property="MinHeight"   Value="44"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                      <TextBlock x:Name="Tb"
                                 Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                 Foreground="{DynamicResource BrushText}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <!-- No background change on hover or selection — text-only style -->
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                        <Setter TargetName="Tb" Property="TextDecorations" Value="Underline"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                        <Setter TargetName="Tb" Property="FontWeight" Value="SemiBold"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4"
                        Margin="-2" Opacity="0"/>
                <Border x:Name="MainBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        MinHeight="{TemplateBinding MinHeight}"
                        CornerRadius="3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False">
                      <ContentPresenter.Resources>
                        <!-- When the selected item is a ComboBoxItem, render its Content as plain text -->
                        <DataTemplate DataType="{x:Type ComboBoxItem}">
                          <TextBlock Text="{Binding Content}"
                                     Foreground="{DynamicResource BrushText}"
                                     FontFamily="{DynamicResource AppFontFamily}" FontSize="13"
                                     VerticalAlignment="Center"/>
                        </DataTemplate>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                    <Border Grid.Column="1" Background="Transparent" CornerRadius="0,3,3,0">
                      <TextBlock Text="∨" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                 Foreground="{DynamicResource BrushHint}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="Transparent" BorderThickness="0" Style="{x:Null}"/>
                  </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Slide">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1" CornerRadius="0,0,3,3"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer SnapsToDevicePixels="True"
                                  Background="{DynamicResource BrushSurf}">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing"  Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                  <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,0"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Medium #2 (FileCopy_Full_Review_2026-09-07): DatePicker/Calendar had no implicit
           style anywhere, so PickerDateFrom/PickerDateTo fell back to default Windows chrome
           (light background, dark text) regardless of the active theme, including the darkest
           custom themes. Simple property Setters only (no ControlTemplate override) — DatePicker's
           and Calendar's default templates already TemplateBind Background/Foreground/BorderBrush
           from these top-level properties down into PART_TextBox and the popup chrome, so this
           covers the always-visible text box and the calendar's header/background without the risk
           of re-wiring DatePicker's PART_TextBox/PART_Button/PART_Calendar parts by hand (get one of
           those parts' type wrong and the picker silently stops responding to clicks/typing).
           Known remaining gap, not fixed here: individual CalendarDayButton day-cell numerals render
           via OS SystemColors in the default day-cell template, not from these brushes — per
           wpf-shared-standards, a SystemColors.*BrushKey override is unverified until seen live, so
           it's left as a follow-up rather than claimed done. -->
      <Style TargetType="DatePicker">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,0"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="CalendarStyle">
          <Setter.Value>
            <Style TargetType="Calendar">
              <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
              <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BrushSurf2}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
              <Setter Property="FontSize"    Value="13"/>
            </Style>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Calendar can also appear outside a DatePicker's popup (none currently do in this app,
           but an implicit style keeps any future use themed instead of silently falling back). -->
      <Style TargetType="Calendar">
        <Setter Property="Background"  Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"  Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"  Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"    Value="13"/>
      </Style>

      <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource BrushBlue}"/>
        <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="MinHeight"  Value="44"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Grid>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4" Margin="-2" Opacity="0"/>
                <Track x:Name="PART_Track" Margin="0,10">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{x:Null}" Background="{DynamicResource BrushBlue}"
                                  Height="4" Focusable="False" BorderThickness="0"
                                  Command="Slider.DecreaseLarge"/>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{x:Null}" Background="{DynamicResource BrushSurf2}"
                                  Height="4" Focusable="False" BorderThickness="0"
                                  Command="Slider.IncreaseLarge"/>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="44" Height="44" Focusable="False">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent" Width="44" Height="44">
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource BrushBlue}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="Foreground"               Value="{DynamicResource BrushText}"/>
        <Setter Property="FontFamily"               Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="MinHeight"                Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent" MinHeight="44">
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" CornerRadius="4" Margin="-2" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                  <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border x:Name="CheckBorder" BorderBrush="{DynamicResource BrushMuted}"
                            BorderThickness="2" CornerRadius="3" Background="Transparent"/>
                    <TextBlock x:Name="CheckMark" Text="✓" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource BrushBlueText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-1,0,0" Opacity="0"/>
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="CheckMark"   Property="Opacity"     Value="1"/>
                  <Setter TargetName="CheckMark"   Property="Text"        Value="✓"/>
                  <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                </Trigger>
                <!-- SC 1.4.11 / SC 4.1.2: indeterminate state must be visually distinct from unchecked -->
                <Trigger Property="IsChecked" Value="{x:Null}">
                  <Setter TargetName="CheckMark"   Property="Text"        Value="—"/>
                  <Setter TargetName="CheckMark"   Property="Opacity"     Value="1"/>
                  <Setter TargetName="CheckMark"   Property="Foreground"  Value="{DynamicResource BrushMuted}"/>
                  <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BrushMuted}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="0,4"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="HasDropShadow"   Value="True"/>
      </Style>

      <!-- SC 2.5.5 / 2.5.8: 44px AAA target size for context menu items.
           ControlTemplate handles both SubmenuItem (leaf) and SubmenuHeader (flyout)
           roles so the theme picker's category submenus render correctly. -->
      <Style TargetType="MenuItem">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="MinHeight"       Value="44"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Grid>
                <!-- Visual row: header text + gesture/arrow column -->
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        MinHeight="{TemplateBinding MinHeight}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Fixed-color JT icon (MenuItem.Icon); collapsed when none -->
                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                      Width="16" Height="16" Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <!-- Leaf items: keyboard shortcut hint -->
                    <TextBlock x:Name="GestureText" Grid.Column="2"
                               Text="{TemplateBinding InputGestureText}"
                               Foreground="{DynamicResource BrushMuted}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <!-- Submenu headers: flyout arrow -->
                    <TextBlock x:Name="ArrowGlyph" Grid.Column="2"
                               Text="▶" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushMuted}"
                               Margin="8,0,4,0" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                  </Grid>
                </Border>
                <!-- Flyout popup for SubmenuHeader role -->
                <Popup x:Name="PART_Popup"
                       Placement="Right"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                  <Border Background="{DynamicResource BrushSurf}"
                          BorderBrush="{DynamicResource BrushSurf2}"
                          BorderThickness="1"
                          Padding="0,4">
                    <ItemsPresenter
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        KeyboardNavigation.TabNavigation="Cycle"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                  <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <!-- Show flyout arrow for category headers (direct ContextMenu children = TopLevelHeader) -->
                <Trigger Property="Role" Value="TopLevelHeader">
                  <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="ArrowGlyph"  Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- Also cover nested submenu-with-children case -->
                <Trigger Property="Role" Value="SubmenuHeader">
                  <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="ArrowGlyph"  Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- SC 2.4.11: BrushBlue bg + BrushSelectedText — same AAA-rated pair as DataGridRow -->
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBlue}"/>
                  <Setter Property="Foreground" Value="{DynamicResource BrushSelectedText}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="8,4"/>
      </Style>

      <!-- Expander: 44px header target (SC 2.5.5), 2px cyan focus ring (SC 2.4.7/2.4.11) -->
      <Style TargetType="Expander">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <StackPanel>
                  <!-- Header toggle — 44px target, FocusRing on keyboard focus -->
                  <ToggleButton x:Name="HeaderToggle"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                FocusVisualStyle="{x:Null}"
                                Background="Transparent" BorderThickness="0"
                                MinHeight="44" Cursor="Hand"
                                AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                AutomationProperties.HelpText="Expand or collapse this section">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                          <Border x:Name="FocusRing"
                                  BorderBrush="{DynamicResource FocusRingBrush}"
                                  BorderThickness="2" Margin="-1" Opacity="0"/>
                          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                  MinHeight="{TemplateBinding MinHeight}" Padding="8,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <!-- Header content from Expander.Header -->
                              <ContentPresenter Grid.Column="0"
                                  Content="{Binding Header,
                                      RelativeSource={RelativeSource AncestorType=Expander}}"
                                  ContentTemplate="{Binding HeaderTemplate,
                                      RelativeSource={RelativeSource AncestorType=Expander}}"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
                              <!-- Chevron indicator -->
                              <TextBlock x:Name="Chevron" Grid.Column="1"
                                         Text="▶" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                                         Foreground="{DynamicResource BrushMuted}"
                                         VerticalAlignment="Center" Margin="8,0,0,0"
                                         RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                  <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                              </TextBlock>
                            </Grid>
                          </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                          </Trigger>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="▼"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <!-- Expanded content -->
                  <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ProgressBar">
        <Setter Property="Background"  Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="Foreground"  Value="{DynamicResource BrushBlue}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="MinHeight"   Value="14"/>
      </Style>

      <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{DynamicResource BrushSurf}"/>
        <Setter Property="Foreground"               Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="RowBackground"            Value="{DynamicResource BrushSurf}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushBar}"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
        <Setter Property="RowHeight"                Value="32"/>
        <Setter Property="FontFamily"               Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"                 Value="12"/>
        <Setter Property="CanUserResizeRows"        Value="False"/>
        <Setter Property="AutoGenerateColumns"      Value="False"/>
        <Setter Property="SelectionMode"            Value="Extended"/>
        <Setter Property="SelectionUnit"            Value="FullRow"/>
      </Style>

      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{DynamicResource BrushBar}"/>
        <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
      </Style>

      <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
            <!-- M2 fix: BrushSelectedText per theme — Light=#FFFFFF (7.9:1), Dark=#000000 (9.9:1), HC=HighlightTextColor -->
            <Setter Property="Foreground" Value="{DynamicResource BrushSelectedText}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <!-- C1 fix: 2px focus ring on keyboard focus (SC 2.4.7 / 2.4.11 / 2.4.12) -->
              <Grid>
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="2" Margin="-1" Opacity="0"/>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
