<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palenight — Material Design Night variant -->
  <SolidColorBrush x:Key="BrushBg"           Color="#292D3E"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#34394F"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#444267"/>
  <SolidColorBrush x:Key="BrushText"         Color="#DBDDEB"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#DCDEE7"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#C7CBD4"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#82AAFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F07178"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#C3E88D"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFCB6B"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#F78C6C"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFCB6B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#C792EA"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF80E0"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#89DDFF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#212432"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#4B5263"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#7A839A"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#F8BCBF"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#B3CCFF"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#C3E88D"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FFCB6B"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
