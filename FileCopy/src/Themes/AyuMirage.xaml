<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ayu Mirage — WCAG AAA: BrushText/BrushMuted/FocusRingBrush ≥7:1 on BrushBg -->
  <SolidColorBrush x:Key="BrushBg"          Color="#1F2430"/>
  <SolidColorBrush x:Key="BrushSurf"        Color="#262D3D"/>
  <SolidColorBrush x:Key="BrushSurf2"       Color="#2E3649"/>
  <SolidColorBrush x:Key="BrushText"        Color="#CCCAC2"/>
  <SolidColorBrush x:Key="BrushMuted"       Color="#C8C6B9"/>
  <SolidColorBrush x:Key="BrushHint"        Color="#B4B9C6"/>
  <SolidColorBrush x:Key="BrushBlue"        Color="#73D0FF"/>
  <SolidColorBrush x:Key="BrushRed"         Color="#FF9D9D"/>
  <SolidColorBrush x:Key="BrushGreen"       Color="#D5FF80"/>
  <SolidColorBrush x:Key="BrushAmber"       Color="#FFCC66"/>
  <SolidColorBrush x:Key="BrushBar"         Color="#171E2C"/>
  <SolidColorBrush x:Key="BrushDisabled"    Color="#404755"/>
  <!-- Focus ring: #FFCC66 on #1F2430 = 9.4:1 — AAA -->
  <SolidColorBrush x:Key="FocusRingBrush"   Color="#FFCC66"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#FFCC66"/>
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6A768D"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF9F9F"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#73D0FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#D5FF80"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFCC66"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
