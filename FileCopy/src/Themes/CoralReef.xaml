<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Coral Reef — warm ocean marine palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A1A2E"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#222238"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#2E2E48"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFB3C1"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#EBADC1"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#D0A2B4"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5C8D"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFAB40"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF6B9D"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#4DD0E1"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#12122A"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#3A3A5A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#A55374"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#FF8AAD"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
