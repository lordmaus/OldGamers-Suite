<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Mocha — https://github.com/catppuccin/catppuccin -->
  <SolidColorBrush x:Key="BrushBg"          Color="#1E1E2E"/>
  <SolidColorBrush x:Key="BrushSurf"        Color="#313244"/>
  <SolidColorBrush x:Key="BrushSurf2"       Color="#45475A"/>
  <SolidColorBrush x:Key="BrushText"        Color="#DBE1F7"/>
  <SolidColorBrush x:Key="BrushMuted"       Color="#DEE1EF"/>
  <SolidColorBrush x:Key="BrushHint"        Color="#BEC1CD"/>
  <SolidColorBrush x:Key="BrushBlue"        Color="#89B4FA"/>
  <SolidColorBrush x:Key="BrushRed"         Color="#F38BA8"/>
  <SolidColorBrush x:Key="BrushGreen"       Color="#A6E3A1"/>
  <SolidColorBrush x:Key="BrushAmber"       Color="#F9E2AF"/>
  <SolidColorBrush x:Key="BrushBar"         Color="#181825"/>
  <SolidColorBrush x:Key="BrushDisabled"    Color="#6C7086"/>
  <SolidColorBrush x:Key="FocusRingBrush"   Color="#FFD700"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#FFD700"/>
  <!-- Dark text on bright BrushBlue selection = AAA -->
  <SolidColorBrush x:Key="BrushSelectedText" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#7F849C"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F7ADC1"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#A0C3FB"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#A6E3A1"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#F9E2AF"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
