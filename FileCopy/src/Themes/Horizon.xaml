<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Horizon — warm twilight dark theme -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1C1E26"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#232530"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#2E303E"/>
  <SolidColorBrush x:Key="BrushText"         Color="#D5D8DA"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#BCBEC0"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#ADAFC3"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#26BBD9"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#EC6B88"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#29D398"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FAB28E"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FAB28E"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FABF86"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#EE64AC"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F075B5"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#59E1E3"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#16181E"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#6C6F93"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#6C6F93"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#F196AB"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#34C0DC"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#29D398"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FAB28E"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
