<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Warm Light — Solarized-inspired -->
  <SolidColorBrush x:Key="BrushBg"          Color="#FDF6E3"/>
  <SolidColorBrush x:Key="BrushSurf"        Color="#EEE8D5"/>
  <SolidColorBrush x:Key="BrushSurf2"       Color="#D6D0BB"/>
  <SolidColorBrush x:Key="BrushText"        Color="#2C2B2A"/>
  <SolidColorBrush x:Key="BrushMuted"       Color="#3F3D3B"/>
  <SolidColorBrush x:Key="BrushHint"        Color="#404E54"/>
  <SolidColorBrush x:Key="BrushBlue"        Color="#0A5AA0"/>
  <SolidColorBrush x:Key="BrushRed"         Color="#AD1F1D"/>
  <SolidColorBrush x:Key="BrushGreen"       Color="#1A7A72"/>
  <SolidColorBrush x:Key="BrushAmber"       Color="#7A5C00"/>
  <SolidColorBrush x:Key="BrushBar"         Color="#E8E2D0"/>
  <SolidColorBrush x:Key="BrushDisabled"    Color="#888880"/>
  <SolidColorBrush x:Key="FocusRingBrush"   Color="#003DC2"/>
  <SolidColorBrush x:Key="GoldFocusBrush"   Color="#003DC2"/>
  <!-- White text on dark BrushBlue selection = AAA -->
  <SolidColorBrush x:Key="BrushSelectedText" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#657B83"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#951A19"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#084D89"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#125550"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#604800"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
