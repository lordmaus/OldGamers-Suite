<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Lavender Field — soft purple twilight -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A1030"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#221540"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#2E2050"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E8D8F8"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#C1AAE1"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#ADA2CB"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#81D4FA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#EF9A9A"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#A5D6A7"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFCC80"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9B59B6"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#120A24"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#3A2855"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#9080B8"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#EF9A9A"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#81D4FA"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#A5D6A7"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
