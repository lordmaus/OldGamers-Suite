<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- VaporWave — pastel neon aesthetic -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A0533"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3D1273"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#4E1F88"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F7B9F4"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#E7C1E4"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#C9B2D1"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF6EC7"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#05FFA1"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFFB96"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9B54"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFB96"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#B967FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF71CE"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#2D0B59"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5A2A7A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#9365A3"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#FF99D7"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#01CDFE"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#05FFA1"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FFFB96"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
