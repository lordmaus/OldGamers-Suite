<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Slate — cool dark blue-grey palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#12182B"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#1A2240"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#243050"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E8EAF6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#B6BDE3"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#A3ADD1"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#7790EE"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9C27B0"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#009688"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#0D1220"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#283060"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"        Color="#6070B0"/>
  <SolidColorBrush x:Key="BrushRedText"        Color="#F59391"/>
  <SolidColorBrush x:Key="BrushBlueText"       Color="#98ABF2"/>
  <SolidColorBrush x:Key="BrushGreenText"      Color="#6DC071"/>
  <SolidColorBrush x:Key="BrushAmberText"      Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#000000"/>
  <SolidColorBrush x:Key="BrushSelectedText"   Color="#000000"/>
  <SolidColorBrush x:Key="GoldFocusBrush"      Color="#FFD700"/>
</ResourceDictionary>
