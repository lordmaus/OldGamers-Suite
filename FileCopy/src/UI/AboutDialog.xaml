<Window x:Class="FileCopy.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="About File Copy Studio"
        Width="540" Height="640" MinWidth="500" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="About File Copy Studio"
        AutomationProperties.HelpText="About information, version, links, and donation options for File Copy Studio">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,28,24">

    <!-- Logo / Title -->
    <TextBlock Text="⊙ File Copy Studio"
               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
               Foreground="{DynamicResource BrushBlueText}"
               HorizontalAlignment="Center"/>
    <TextBlock Text="High-performance file copy with conflict resolution, CRC verification, and scheduling."
               FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" TextAlignment="Center"
               TextWrapping="Wrap" Margin="0,2,0,0"/>

    <Separator Margin="0,14,0,14"/>

    <!-- Info grid -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Version -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionLabel"
                 FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 AutomationProperties.Name="Application version number"/>

      <!-- Created by -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Created by"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Matthew Pittman"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <!-- Platform -->
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Platform"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="PlatformLabel"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"
                 AutomationProperties.Name="Platform and runtime information"/>

      <!-- Data files -->
      <TextBlock Grid.Row="6" Grid.Column="0" Text="Settings file"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical">
        <TextBlock x:Name="SettingsPathLabel"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Path to data folder"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3"
                  MinHeight="44"
                  ToolTip="Copy data folder path to clipboard"
                  AutomationProperties.Name="Copy data folder path to clipboard"
                  AutomationProperties.HelpText="Copies the data folder path to the clipboard"
                  Click="BtnCopyPath_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Copy path" VerticalAlignment="Center"/></StackPanel></Button>
          <Button
                  HorizontalAlignment="Left"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="6,3" Margin="6,0,0,0"
                  MinHeight="44"
                  ToolTip="Open data folder in Explorer"
                  AutomationProperties.Name="Open data folder in Explorer"
                  AutomationProperties.HelpText="Opens the data folder in Windows Explorer"
                  Click="BtnOpenFolder_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Open folder" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </StackPanel>

      <!-- Website -->
      <TextBlock Grid.Row="8" Grid.Column="0" Text="Website"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="8" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="https://oldgamerssoftware.com/"
                 AutomationProperties.Name="Open Old Gamers Software website"
                 AutomationProperties.HelpText="Opens oldgamerssoftware.com in your default browser"
                 Click="BtnWebsite_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Web}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="oldgamerssoftware.com" VerticalAlignment="Center"/></StackPanel></Button>

      <!-- GitHub -->
      <TextBlock Grid.Row="10" Grid.Column="0" Text="GitHub"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="10" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="https://github.com/lordmaus/FileCopyStudio"
                 AutomationProperties.Name="View File Copy Studio on GitHub"
                 AutomationProperties.HelpText="Opens the FileCopyStudio GitHub repository in your browser"
                 Click="BtnGitHub_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Link}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="GitHub" VerticalAlignment="Center"/></StackPanel></Button>

      <!-- Help -->
      <TextBlock Grid.Row="12" Grid.Column="0" Text="Help"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button    Grid.Row="12" Grid.Column="1"
                 HorizontalAlignment="Left"
                 Style="{StaticResource FlatButton}"
                 FontSize="{DynamicResource FontSizeCaption}" Padding="8,4"
                 MinHeight="44"
                 ToolTip="Opens today's log file in your default text editor"
                 AutomationProperties.Name="View today's application log file"
                 AutomationProperties.HelpText="Opens today's log file in your default text editor"
                 Click="BtnViewLog_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.EventLog}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="View app log" VerticalAlignment="Center"/></StackPanel></Button>

    </Grid>

    <Separator Margin="0,14,0,14"/>

    <!-- Description -->
    <TextBlock FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushText}"
               TextWrapping="Wrap" TextAlignment="Center"
               Text="File Copy Studio copies and moves files with conflict resolution, CRC32 verification, resume support, scheduled automation, per-job logging, and WCAG AAA accessibility."/>

    <Separator Margin="0,14,0,14"/>

    <!-- Donate -->
    <TextBlock Text="&#x2615;  Donate / Buy Me a Coffee"
               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
               Foreground="{DynamicResource BrushBlueText}"
               HorizontalAlignment="Center" Margin="0,0,0,8"/>
    <TextBlock Text="If File Copy Studio is useful to you, consider a small donation!"
               FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Venmo"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,9" Margin="0,0,12,0"
              MinHeight="44"
              ToolTip="Donate via Venmo: @Matthew-Pittman-80"
              AutomationProperties.Name="Donate via Venmo"
              AutomationProperties.HelpText="Opens the Venmo donation page in your browser"
              Click="BtnVenmo_Click"/>
      <Button Content="Cash App"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,9"
              MinHeight="44"
              ToolTip="Donate via Cash App: $MatthewPittman80"
              AutomationProperties.Name="Donate via Cash App"
              AutomationProperties.HelpText="Opens the Cash App donation page in your browser"
              Click="BtnCashApp_Click"/>
    </StackPanel>

    <Separator Margin="0,14,0,14"/>

    <!-- Privacy -->
    <Border Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushBlue}"
            BorderThickness="0,0,0,2"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="&#x1F512;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Privacy — what this app does NOT do"
                     FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6"
                   Text="File Copy Studio never: collects, stores, or transmits usage data · requires an account · makes network calls (no telemetry, no analytics, no update pings) · stores files outside %APPDATA%\FileCopyStudio."
                   AutomationProperties.Name="Privacy statement"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Text="The only outbound network activity occurs when YOU click a link in this dialog (website, GitHub, Venmo, Cash App). That opens your default browser — File Copy Studio itself makes no HTTP calls."/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}">
          <Run FontWeight="SemiBold">GDPR legal basis:</Run>
          <Run>Processing is based on your consent. You may delete all stored data at any time by removing the AppData\FileCopyStudio folder.</Run>
        </TextBlock>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>

  <!-- Sticky footer bar -->
  <Border Grid.Row="1" Background="{DynamicResource BrushBar}" Padding="16,10">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Close" Style="{StaticResource PrimaryButton}"
              Padding="40,8" MinHeight="44"
              IsCancel="True" IsDefault="True"
              AutomationProperties.Name="Close About dialog"
              AutomationProperties.HelpText="Close this dialog. Keyboard shortcut: Escape or Enter"
              Click="BtnClose_Click"/>
    </StackPanel>
  </Border>

  <!-- WCAG: Bottom-right drag handle (Bug #3, FileCopy_Full_Review_2026-09-07) — was a
       decorative, non-hit-testable Path; now the same accessible grip as MainWindow.xaml:
       focusable, keyboard-resizable (WCAG 2.5.7), mouse-draggable via WM_NCLBUTTONDOWN.
       Grid.RowSpan spans both rows so it sits at the window's true bottom-right corner. -->
  <sh:AccessibleResizeGrip/>
  </Grid>
</Window>
