<Window x:Class="FileCopy.PresetSlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Save to Preset Slot"
        Width="400" Height="240"
        MinWidth="340" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ResizeMode="CanResize" ShowInTaskbar="False">
  <!-- Outer grid — resize grip lives outside scaled content (UI Map rule) -->
  <Grid>
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Choose a preset slot to overwrite (1–5):"
                 FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource BrushText}"
                 Margin="0,0,0,10"/>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="1" Style="{StaticResource FlatButton}" Margin="2" MinHeight="44" Click="Slot_Click" Tag="1"
                AutomationProperties.Name="Save to preset slot 1"/>
        <Button Grid.Column="1" Content="2" Style="{StaticResource FlatButton}" Margin="2" MinHeight="44" Click="Slot_Click" Tag="2"
                AutomationProperties.Name="Save to preset slot 2"/>
        <Button Grid.Column="2" Content="3" Style="{StaticResource FlatButton}" Margin="2" MinHeight="44" Click="Slot_Click" Tag="3"
                AutomationProperties.Name="Save to preset slot 3"/>
        <Button Grid.Column="3" Content="4" Style="{StaticResource FlatButton}" Margin="2" MinHeight="44" Click="Slot_Click" Tag="4"
                AutomationProperties.Name="Save to preset slot 4"/>
        <Button Grid.Column="4" Content="5" Style="{StaticResource FlatButton}" Margin="2" MinHeight="44" Click="Slot_Click" Tag="5"
                AutomationProperties.Name="Save to preset slot 5"/>
      </Grid>
      <Button Grid.Row="2" Content="Cancel" Style="{StaticResource FlatButton}"
              HorizontalAlignment="Right" Padding="14,0" MinHeight="44" Margin="0,10,0,0"
              Click="Cancel_Click"/>
    </Grid>
    <!-- WCAG: bottom-right drag handle — canonical accessible grip (same pattern as
         MainWindow.xaml / AboutDialog.xaml / HotkeysDialog.xaml): focusable, keyboard-
         resizable (WCAG 2.5.7), mouse-draggable via WM_NCLBUTTONDOWN through shared
         NativeMethods. Was drag-only (WM_SYSCOMMAND, Focusable="False", no keyboard path)
         — converged onto the one canonical implementation, 2026-09-15. -->
    <sh:AccessibleResizeGrip/>
  </Grid>
</Window>
