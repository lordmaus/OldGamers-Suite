<Window x:Class="FileCopy.HotkeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FileCopy.Controls"
        Title="Keyboard Shortcuts — File Copy Studio"
        Width="520" Height="560"
        MinWidth="440" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="File Copy Studio Keyboard Shortcuts">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ── Header banner ── -->
    <Border Grid.Row="0"
            Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushBlue}"
            BorderThickness="0,0,0,3"
            Padding="20,14,20,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource JtIcon.Keyboard}" Style="{StaticResource JtHeaderIcon}"/>
          <TextBlock Text="Keyboard Shortcuts" VerticalAlignment="Center"
                     FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource BrushText}"/>
        </StackPanel>
        <TextBlock Text="All shortcuts are fixed and cannot be remapped."
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- ── Shortcut list ── -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20,12,20,12">
      <StackPanel>

        <!-- Operations -->
        <TextBlock Text="OPERATIONS" AutomationProperties.HeadingLevel="Level2"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
        <Border Background="{DynamicResource BrushSurf}" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+S" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Scan files" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="F5" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Start copy" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Escape" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Cancel operation" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+P" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Pause / Resume" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+D" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Dry run (preview actions)" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+J" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Open Scheduler" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Presets -->
        <TextBlock Text="PRESETS" AutomationProperties.HeadingLevel="Level2"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
        <Border Background="{DynamicResource BrushSurf}" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+1 … Ctrl+5" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Load preset slot 1–5" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Ctrl+Shift+1 … +5" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Save preset slot 1–5" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- File grid -->
        <TextBlock Text="FILE GRID" AutomationProperties.HeadingLevel="Level2"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
        <Border Background="{DynamicResource BrushSurf}" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Delete" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Skip selected rows" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Drag preset → preset" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Reorder preset slots" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource BrushText}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Help -->
        <TextBlock Text="HELP"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
        <Border Background="{DynamicResource BrushSurf}" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,4">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="F1" FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushBlueText}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Show keyboard shortcuts" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushText}"/>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Footer ── -->
    <Border Grid.Row="2"
            Background="{DynamicResource BrushBar}"
            BorderBrush="{DynamicResource BrushSurf2}"
            BorderThickness="0,1,0,0"
            Padding="20,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="Close"
                Style="{StaticResource PrimaryButton}"
                Padding="40,8" MinHeight="44"
                IsCancel="True" IsDefault="True"
                AutomationProperties.Name="Close keyboard shortcuts dialog"
                AutomationProperties.HelpText="Close this dialog. Keyboard shortcut: Escape or Enter"
                Click="BtnClose_Click"/>
      </StackPanel>
    </Border>

    <!-- WCAG: Bottom-right drag handle (Bug #3, FileCopy_Full_Review_2026-09-07) — was a
         decorative, non-hit-testable Path; now the same accessible grip as MainWindow.xaml:
         focusable, keyboard-resizable (WCAG 2.5.7), mouse-draggable via WM_NCLBUTTONDOWN. -->
    <ctl:AccessibleResizeGrip/>
  </Grid>
</Window>
