<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Oxocarbon — IBM Carbon-inspired dark -->
  <SolidColorBrush x:Key="BrushBg"           Color="#161616"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#393939"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#525252"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F4F4F4"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#CACACA"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#78A9FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF8389"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#42BE65"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#F1C21B"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF832B"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#F1C21B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BE95FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF7EB6"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#3DDBD9"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#262626"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#6F6F6F"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#8D8D8D"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFB7BA"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#ADCBFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#92DAA6"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#F2C524"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
