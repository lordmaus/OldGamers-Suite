<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ocean — deep sea blue palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0A1628"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0D1E38"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#142850"/>
  <SolidColorBrush x:Key="BrushText"         Color="#B3E5FC"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#81C8E8"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#7CAFCC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#03A9F4"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#26A69A"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFCA28"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFA726"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEE58"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#AB47BC"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#EC407A"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#26C6DA"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#071020"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1C3A5A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#4A90B8"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F48A87"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#10B3FC"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#2BBBAE"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFCA28"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
