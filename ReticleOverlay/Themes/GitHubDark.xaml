<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- GitHub Dark — official GitHub dark theme -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D1117"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#1C2128"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#30363D"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E6EDF3"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#C0C5C9"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#A6ABB3"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#58A6FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF7B72"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#3FB950"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#D29922"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#F0883E"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#E3B341"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BC8CFF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F778BA"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#39C5CF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#161B22"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#484F58"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6E7681"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF8880"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#68AEFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#4AC25B"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#DCA024"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
