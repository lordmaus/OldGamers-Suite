<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Solarized Dark — WCAG AAA: BrushText/BrushMuted/FocusRingBrush ≥7:1 on BrushBg -->
  <SolidColorBrush x:Key="BrushBg"        Color="#002B36"/>
  <SolidColorBrush x:Key="BrushSurf"      Color="#073642"/>
  <SolidColorBrush x:Key="BrushSurf2"     Color="#114555"/>
  <SolidColorBrush x:Key="BrushText"      Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrushMuted"     Color="#D4D4D4"/>
  <SolidColorBrush x:Key="BrushHint"      Color="#B2C1C9"/>
  <SolidColorBrush x:Key="BrushBlue"      Color="#5BC4F5"/>
  <SolidColorBrush x:Key="BrushRed"       Color="#FFA5A5"/>
  <SolidColorBrush x:Key="BrushGreen"     Color="#A8CC00"/>
  <SolidColorBrush x:Key="BrushAmber"     Color="#E0AC00"/>
  <SolidColorBrush x:Key="BrushBar"       Color="#001B23"/>
  <SolidColorBrush x:Key="BrushDisabled"  Color="#3D5560"/>
  <!-- Focus ring: #E0AC00 on #002B36 = 7.2:1 — AAA -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#EEB600"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#637D8D"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFA7A7"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#6ACAF6"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#A8CD00"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#EEB600"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
