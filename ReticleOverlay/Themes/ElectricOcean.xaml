<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Electric Ocean — bioluminescent deep sea -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000D1A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#002040"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#003060"/>
  <SolidColorBrush x:Key="BrushText"         Color="#00FFD4"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#00D4C0"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#00BEAE"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#2F98FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5B78"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FFD4"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8844"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#8844FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF44CC"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00E5D4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#001529"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#003050"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#007A70"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF839A"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#5DAFFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FFD4"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
