<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Everforest Dark — soft woodland palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#2D353B"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#343F44"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#3D484D"/>
  <SolidColorBrush x:Key="BrushText" Color="#E5DECC"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#DAE0DC"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#CDD1CC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#7FBBB3"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#E67E80"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#A7C080"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#DBBC7F"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#E69875"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#DBBC7F"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#D699B6"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#D699B6"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#7FBBB3"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#232A2E"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5C6A72"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#808A7E"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F4C5C5"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#B4D7D2"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#C5D6AC"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#E4CEA0"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
