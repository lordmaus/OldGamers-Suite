<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neon Purple — electric violet night -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0E0018"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#1F003B"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#300055"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E0B0FF"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#C496E3"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#B192CC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#44AAFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5B78"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#44FF88"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8844"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BF00FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF44BB"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44DDFF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#160025"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#380060"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#8050AA"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF6F89"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#44AAFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#44FF88"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
