<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Arctic Fox — cool blue-white palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0F1A2E"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#14233E"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#1C3050"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E0F0FF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#9CC0EA"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#93B0D3"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#4FC3F7"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9C27B0"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00BCD4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#0A1220"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A3050"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#5080B8"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F59290"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#4FC3F7"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#6DC070"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
