<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Sapphire — deep royal blue gemstone -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D0D33"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#121244"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#1C1C5A"/>
  <SolidColorBrush x:Key="BrushText"         Color="#C5CAE9"/>
  <SolidColorBrush x:Key="BrushMuted" Color="#A5ADD6"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#98A2CC"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#283593"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#B21310"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#7C4DFF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#009688"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#08082A"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1C1C5A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#5162A3"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F38381"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#96A0E2"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#5AB85E"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
