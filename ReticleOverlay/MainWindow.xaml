<Window x:Class="ReticleOverlay.MainWindow"
        ResizeMode="CanResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Reticle Overlay"
        Width="540" Height="840"
        MinWidth="480" MinHeight="600"
        Background="{DynamicResource BrushBg}"
        Closing="Window_Closing">

  <!-- WCAG 2.2 SC 3.2.6 — consistent help location: F1 opens Hotkeys dialog -->
  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Help" Key="F1"/>
  </Window.InputBindings>

  <Grid x:Name="RootGrid">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="UiScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
    </Grid.LayoutTransform>

    <DockPanel>

      <!-- ── Section 1: Identity & Scaling ── -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBar}"
              BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,0,0,1"
              Padding="14,0" MinHeight="52">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Reticle}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="Reticle Overlay"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnHotkeys"
                    Style="{StaticResource FlatButton}" Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    Click="BtnHotkeys_Click" ToolTip="Configure global hotkeys (F1)"
                    AutomationProperties.Name="Hotkeys"
                    AutomationProperties.AccessKey="H"
                    AutomationProperties.HelpText="Configure global hotkeys"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Keyboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Hotkeys" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnSettings"
                    Style="{StaticResource FlatButton}" Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    Click="BtnSettings_Click" ToolTip="Behaviour and startup options"
                    AutomationProperties.Name="Settings"
                    AutomationProperties.AccessKey="S"
                    AutomationProperties.HelpText="Behaviour and startup options"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Settings}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnTheme" Content="◑ Theme"
                    Style="{StaticResource FlatButton}" Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,4,0"
                    Click="BtnTheme_Click" ToolTip="Toggle dark / light theme"
                    AutomationProperties.Name="Theme"
                    AutomationProperties.AccessKey="T"
                    AutomationProperties.HelpText="Toggle dark / light theme"/>
            <Button x:Name="BtnAbout"
                    Style="{StaticResource FlatButton}" Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12" Margin="0,0,10,0"
                    Click="BtnAbout_Click" ToolTip="About Reticle Overlay"
                    AutomationProperties.Name="About"
                    AutomationProperties.AccessKey="A"
                    AutomationProperties.HelpText="About Reticle Overlay"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.About}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></Button>
            <!-- Divider -->
            <Rectangle Width="1" Height="24"
                       Fill="{DynamicResource BrushSurf2}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Button x:Name="BtnUiScale"
                    Content="⊞ Standard (1.0×)"
                    Style="{StaticResource FlatButton}" Padding="10,6" MinHeight="44" MinWidth="44"
                    FontSize="12"
                    AutomationProperties.Name="Cycle UI size"
                    AutomationProperties.AccessKey="U"
                    AutomationProperties.HelpText="Cycle through Standard, Medium, Large, and Xtra Large UI sizes"
                    Click="BtnUiScale_Click" ToolTip="Click to cycle UI size up — Shift+click to cycle down"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Section 2: Navigation — no app-specific nav buttons; Hotkeys/Settings/Theme/About are on identity bar ── -->

      <!-- ── Section 5 (Bottom): Presets ── -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushBar}"
              BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,1,0,0" Padding="8,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnPreset1" Grid.Column="0" Content="1" Style="{StaticResource FlatButton}" Margin="2,0" MinHeight="44" MinWidth="44" AutomationProperties.Name="Load Preset 1" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="5" Click="BtnPreset_Click" Tag="1" ToolTip="Load Preset 1"/>
          <Button x:Name="BtnPreset2" Grid.Column="1" Content="2" Style="{StaticResource FlatButton}" Margin="2,0" MinHeight="44" MinWidth="44" AutomationProperties.Name="Load Preset 2" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="5" Click="BtnPreset_Click" Tag="2" ToolTip="Load Preset 2"/>
          <Button x:Name="BtnPreset3" Grid.Column="2" Content="3" Style="{StaticResource FlatButton}" Margin="2,0" MinHeight="44" MinWidth="44" AutomationProperties.Name="Load Preset 3" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="5" Click="BtnPreset_Click" Tag="3" ToolTip="Load Preset 3"/>
          <Button x:Name="BtnPreset4" Grid.Column="3" Content="4" Style="{StaticResource FlatButton}" Margin="2,0" MinHeight="44" MinWidth="44" AutomationProperties.Name="Load Preset 4" AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="5" Click="BtnPreset_Click" Tag="4" ToolTip="Load Preset 4"/>
          <Button x:Name="BtnPreset5" Grid.Column="4" Content="5" Style="{StaticResource FlatButton}" Margin="2,0" MinHeight="44" MinWidth="44" AutomationProperties.Name="Load Preset 5" AutomationProperties.PositionInSet="5" AutomationProperties.SizeOfSet="5" Click="BtnPreset_Click" Tag="5" ToolTip="Load Preset 5"/>
          <Button x:Name="BtnSavePreset" Grid.Column="5"
                  Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,0" MinHeight="44"
                  AutomationProperties.Name="Save to preset slot"
                  Click="BtnSavePreset_Click" ToolTip="Save current profile to a preset slot"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Save}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Save Preset" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
      </Border>

      <!-- ── Scrollable body ── -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8,10,8">
        <StackPanel>

          <!-- ── Section 3: Enable + Preview ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="110"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="RETICLE OVERLAY" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"/>
                  <TextBlock x:Name="LblStatus" Text="Overlay active" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                             Foreground="{DynamicResource BrushText}"
                             AutomationProperties.LiveSetting="Polite"
                             AutomationProperties.Name="Overlay status"/>
                </StackPanel>
                <Button x:Name="BtnToggle" Grid.Column="1"
                        Style="{StaticResource PrimaryButton}" Padding="16,0" MinHeight="44" MinWidth="120"
                        FontSize="13"
                        AutomationProperties.Name="Toggle reticle overlay"
                        Click="BtnToggle_Click" ToolTip="Enable or disable the reticle overlay (F8)"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Overlay}" Style="{StaticResource JtBtnIcon}"/><TextBlock x:Name="BtnToggleText" Text="Overlay on" VerticalAlignment="Center"/></StackPanel></Button>
              </Grid>
              <Border Grid.Row="2" CornerRadius="6" ClipToBounds="True"
                      BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1">
                <Grid>
                  <Border x:Name="PreviewBg" CornerRadius="6" Background="#111"/>
                  <Canvas x:Name="PreviewCanvas" IsHitTestVisible="False"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4">
                    <Button Content="■" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44" MinWidth="44" Padding="0"
                            Style="{StaticResource FlatButton}" Margin="0,0,4,0"
                            AutomationProperties.Name="Dark preview background"
                            Tag="Dark" Click="BtnPreviewBg_Click" ToolTip="Dark background"/>
                    <Button Content="□" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44" MinWidth="44" Padding="0"
                            Style="{StaticResource FlatButton}" Margin="0,0,4,0"
                            AutomationProperties.Name="Light preview background"
                            Tag="Light" Click="BtnPreviewBg_Click" ToolTip="Light background"/>
                    <Button Content="▦" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44" MinWidth="44" Padding="0"
                            Style="{StaticResource FlatButton}"
                            AutomationProperties.Name="Checker preview background"
                            Tag="Checker" Click="BtnPreviewBg_Click" ToolTip="Checker background"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- ── Profiles ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
              <!-- Row 1: label + combo + primary actions -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Template}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Profile" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                           VerticalAlignment="Center"/></StackPanel>
                <ComboBox x:Name="CmbProfiles" Grid.Column="1" Margin="0,0,6,0"
                          AutomationProperties.Name="Profile selection"
                          SelectionChanged="CmbProfiles_SelectionChanged"
                          KeyDown="CmbProfiles_KeyDown"
                          TextSearch.TextPath="Name"
                          ToolTip="Select profile — press Enter to load">
                  <!-- Profiles bound to a game show the Rules icon + the .exe (the text carries it; the icon only helps scanning).
                       Unbound profiles keep an empty 16px column so names line up. -->
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image x:Name="BoundIcon" Source="{StaticResource JtIcon.Rules}" Style="{StaticResource JtInlineIcon}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BoundExe" Text="{Binding ProcessName}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource BrushMuted}"/>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ProcessName}" Value="">
                          <Setter TargetName="BoundIcon" Property="Visibility" Value="Hidden"/>
                          <Setter TargetName="BoundExe" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProcessName}" Value="{x:Null}">
                          <Setter TargetName="BoundIcon" Property="Visibility" Value="Hidden"/>
                          <Setter TargetName="BoundExe" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Style="{StaticResource FlatButton}"
                        Padding="10,0" MinHeight="44" Margin="0,0,4,0"
                        AutomationProperties.Name="Load selected profile" Click="BtnLoadProfile_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Load" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Grid.Column="3" Style="{StaticResource FlatButton}"
                        Padding="10,0" MinHeight="44"
                        AutomationProperties.Name="Save profile as new name" Click="BtnSaveProfile_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Save}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Save As…" VerticalAlignment="Center"/></StackPanel></Button>
              </Grid>
              <!-- Row 2: secondary actions (always visible, never overflow) -->
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Style="{StaticResource FlatButton}"
                        Padding="10,0" MinHeight="44" Margin="0,0,4,0"
                        AutomationProperties.Name="Rename profile"
                        Click="BtnRenameProfile_Click" ToolTip="Rename selected profile"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rename}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Rename" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource FlatButton}"
                        Padding="10,0" MinHeight="44" Margin="0,0,4,0"
                        AutomationProperties.Name="Duplicate profile"
                        Click="BtnDuplicateProfile_Click" ToolTip="Duplicate selected profile"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.CopyTask}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Duplicate" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Content="▲" Style="{StaticResource FlatButton}"
                        Padding="0" MinHeight="44" MinWidth="44" Margin="0,0,4,0"
                        AutomationProperties.Name="Move profile up" Click="BtnProfileUp_Click" ToolTip="Move up"/>
                <Button Content="▼" Style="{StaticResource FlatButton}"
                        Padding="0" MinHeight="44" MinWidth="44" Margin="0,0,4,0"
                        AutomationProperties.Name="Move profile down" Click="BtnProfileDown_Click" ToolTip="Move down"/>
                <Button Style="{StaticResource DangerButton}"
                        Padding="10,0" MinHeight="44"
                        AutomationProperties.Name="Delete profile" Click="BtnDeleteProfile_Click" ToolTip="Delete selected profile"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
              </StackPanel>
              <!-- Row 3: per-game auto-switch (Feature #1 / Bug #3, 2026-09-07 review) -->
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Rules}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Auto-switch .exe" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                           VerticalAlignment="Center"/></StackPanel>
                <TextBox x:Name="TxtProcessName" Grid.Column="1"
                         AutomationProperties.Name="Auto-switch process name for this profile"
                         TextChanged="TxtProcessName_TextChanged"
                         ToolTip="When this .exe is in the foreground (and auto-switch is enabled in Settings), automatically switch to this profile — e.g. game.exe"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ── Reticle Type (with icons #35) ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Type" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbReticleType" Grid.Column="1"
                          AutomationProperties.Name="Reticle type"
                          SelectionChanged="CmbReticleType_SelectionChanged"
                          ToolTip="Choose the reticle shape">
                  <!-- Feature #35: shape icons — fixed-color JtIcon.Reticle* via JtLabelItemTemplate (JtIcons.KeyForLabel) -->
                  <ComboBoxItem Content="Crosshair" ContentTemplate="{StaticResource JtLabelItemTemplate}"    Tag="Crosshair"/>
                  <ComboBoxItem Content="Dot" ContentTemplate="{StaticResource JtLabelItemTemplate}"           Tag="Dot"/>
                  <ComboBoxItem Content="Circle" ContentTemplate="{StaticResource JtLabelItemTemplate}"        Tag="Circle"/>
                  <ComboBoxItem Content="Cross + Dot" ContentTemplate="{StaticResource JtLabelItemTemplate}"  Tag="CrossDot"/>
                  <ComboBoxItem Content="T-Shape" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="T-Shape"/>
                  <ComboBoxItem Content="Chevron" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="Chevron"/>
                  <ComboBoxItem Content="Diamond" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="Diamond"/>
                  <ComboBoxItem Content="Arrow" ContentTemplate="{StaticResource JtLabelItemTemplate}"         Tag="Arrow"/>
                  <ComboBoxItem Content="Hexagon" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="Hexagon"/>
                  <ComboBoxItem Content="Octagon" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="Octagon"/>
                  <ComboBoxItem Content="Circle+Cross" ContentTemplate="{StaticResource JtLabelItemTemplate}" Tag="CircleCross"/>
                  <ComboBoxItem Content="Custom PNG" ContentTemplate="{StaticResource JtLabelItemTemplate}"   Tag="CustomPNG"/>
                </ComboBox>
              </Grid>
              <Grid x:Name="PanelCustomImage" Margin="0,6,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCustomPath" Grid.Column="0" Margin="0,0,6,0"
                         IsReadOnly="True" Text="No file selected"
                         AutomationProperties.Name="Custom PNG file path"/>
                <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                        Padding="10,0" MinHeight="44"
                        AutomationProperties.Name="Browse for custom PNG image"
                        Click="BtnBrowseImage_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Browse…" VerticalAlignment="Center"/></StackPanel></Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ── Size & Geometry ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition Height="6"/><RowDefinition/><RowDefinition Height="6"/><RowDefinition Height="44"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Column="0" Grid.Row="0">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Size}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Size" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblSize" Text="40 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrSize" Minimum="4" Maximum="200" Value="40" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Reticle size" AutomationProperties.HelpText="Size in pixels, 4 to 200"
                        ValueChanged="SldrSize_ValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="0">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Thickness}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Thickness" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblThick" Text="2 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrThick" Minimum="1" Maximum="20" Value="2" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Line thickness" AutomationProperties.HelpText="Thickness in pixels, 1 to 20"
                        ValueChanged="SldrThick_ValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="0" Grid.Row="2">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.CentreGap}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Centre Gap" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblGap" Text="8%" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrGap" Minimum="0" Maximum="49" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Centre gap" AutomationProperties.HelpText="Gap at centre as percentage, 0 to 49"
                        ValueChanged="SldrGap_ValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="2">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rotation}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Rotation" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblRotation" Text="0°" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource HudFontBase}" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrRotation" Minimum="0" Maximum="359" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Rotation angle"
                        AutomationProperties.HelpText="Rotation in degrees, 0 to 359. Slider wraps — 359° and 0° are adjacent."
                        ValueChanged="SldrRotation_ValueChanged"/>
              </StackPanel>
              <Button Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Style="{StaticResource FlatButton}"
                      HorizontalAlignment="Left" Padding="10,0" MinHeight="44" Click="BtnResetRotation_Click"
                    AutomationProperties.Name="Reset rotation to 0 degrees"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset Rotation to 0°" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
          </Border>

          <!-- ── Colors + Palette (#31) ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition MinHeight="44"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition MinHeight="44"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition MinHeight="44"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblReticleColor" Grid.Column="0" Grid.Row="0" Text="Reticle"
                           FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="SwatchMain" Grid.Column="1" Grid.Row="0"
                        Style="{StaticResource SwatchButton}" Background="#00FF00" MinHeight="44" MinWidth="44"
                        Tag="Open reticle color picker"
                        AutomationProperties.Name="Open reticle color picker"
                        Click="SwatchMain_Click" ToolTip="Click to pick reticle color"/>
                <TextBox x:Name="TxtMainColor" Grid.Column="2" Grid.Row="0" Text="#00FF00" MaxLength="9"
                         VerticalAlignment="Center"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblReticleColor}"
                         AutomationProperties.HelpText="Hex color value e.g. #00FF00"
                         TextChanged="TxtMainColor_TextChanged"
                         LostFocus="TxtColor_LostFocus"/>

                <TextBlock x:Name="LblVertArmColor" Grid.Column="4" Grid.Row="0" Text="Vert. Arm"
                           FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="SwatchColor2" Grid.Column="5" Grid.Row="0"
                        Style="{StaticResource SwatchButton}" Background="#00FF00" MinHeight="44" MinWidth="44"
                        Tag="Open vertical arm color picker"
                        AutomationProperties.Name="Open vertical arm color picker"
                        Click="SwatchColor2_Click" ToolTip="Click to pick vertical arm color"/>
                <TextBox x:Name="TxtColor2" Grid.Column="6" Grid.Row="0" Text="#00FF00" MaxLength="9"
                         VerticalAlignment="Center"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblVertArmColor}"
                         AutomationProperties.HelpText="Hex color value e.g. #00FF00"
                         TextChanged="TxtColor2_TextChanged"
                         LostFocus="TxtColor_LostFocus"/>

                <TextBlock x:Name="LblOutlineColor" Grid.Column="0" Grid.Row="2" Text="Outline"
                           FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="SwatchOutline" Grid.Column="1" Grid.Row="2"
                        Style="{StaticResource SwatchButton}" Background="#000000" MinHeight="44" MinWidth="44"
                        Tag="Open outline color picker"
                        AutomationProperties.Name="Open outline color picker"
                        Click="SwatchOutline_Click" ToolTip="Click to pick outline color"/>
                <TextBox x:Name="TxtOutlineColor" Grid.Column="2" Grid.Row="2" Text="#000000" MaxLength="9"
                         VerticalAlignment="Center"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblOutlineColor}"
                         AutomationProperties.HelpText="Hex color value e.g. #000000"
                         TextChanged="TxtOutlineColor_TextChanged"
                         LostFocus="TxtColor_LostFocus"/>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="7" Grid.Row="4"
                            Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ChkUseColor2" Margin="0,0,20,0"
                            AutomationProperties.Name="Enable dual arm color"
                            Checked="ChkUseColor2_Changed" Unchecked="ChkUseColor2_Changed"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.DualColor}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Dual arm color" VerticalAlignment="Center"/></StackPanel></CheckBox>
                  <CheckBox x:Name="ChkOutline"
                            AutomationProperties.Name="Show outline on reticle"
                            Checked="ChkOutline_Changed" Unchecked="ChkOutline_Changed"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Outline}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Show outline" VerticalAlignment="Center"/></StackPanel></CheckBox>
                </StackPanel>
              </Grid>

              <!-- Feature #31: Color palette row -->
              <Border Margin="0,8,0,0" BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Swatches}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Palette" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/></StackPanel>
                  <!-- 8 palette swatches as buttons, named PaletteBtn0..7 -->
                  <ItemsControl x:Name="PaletteRow" Grid.Column="1">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </Border>

            </StackPanel>
          </Border>

          <!-- ── Opacity + Monitor ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="50"/>
                <ColumnDefinition Width="44"/><ColumnDefinition Width="44"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Opacity}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Opacity" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                         VerticalAlignment="Center"/></StackPanel>
              <Slider x:Name="SldrOpacity" Grid.Column="1" Minimum="0.05" Maximum="1.0" Value="1.0"
                      TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,6,0"
                      AutomationProperties.Name="Reticle opacity" AutomationProperties.HelpText="Opacity from 5 to 100 percent"
                      ValueChanged="SldrOpacity_ValueChanged"/>
              <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="100%"
                         FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
              <Button Grid.Column="3" Content="−" FontSize="16" Padding="0" MinHeight="44" MinWidth="44"
                      Style="{StaticResource FlatButton}" Margin="2,0,0,0"
                      AutomationProperties.Name="Decrease opacity" Click="BtnOpacityDown_Click" ToolTip="Opacity −5%"/>
              <Button Grid.Column="4" Content="+" FontSize="16" Padding="0" MinHeight="44" MinWidth="44"
                      Style="{StaticResource FlatButton}" Margin="2,0,0,0"
                      AutomationProperties.Name="Increase opacity" Click="BtnOpacityUp_Click" ToolTip="Opacity +5%"/>
              <TextBlock Grid.Column="6" Text="Monitor" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="CmbMonitor" Grid.Column="7" Margin="0,0,6,0"
                        AutomationProperties.Name="Monitor selection"
                        SelectionChanged="CmbMonitor_SelectionChanged" ToolTip="Select monitor for the overlay"/>
              <Button Grid.Column="8" Style="{StaticResource FlatButton}"
                      Padding="0" MinHeight="44" MinWidth="44"
                      AutomationProperties.Name="Refresh monitor list"
                      Click="BtnRefreshMonitors_Click" ToolTip="Refresh monitor list"><Image Source="{StaticResource JtIcon.Refresh}" Style="{StaticResource JtSoloIcon}"/></Button>
            </Grid>
          </Border>

          <!-- ── Offset ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition Height="6"/>
                <RowDefinition Height="44"/><RowDefinition Height="6"/><RowDefinition Height="44"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Column="0" Grid.Row="0">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Offset}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="X Offset" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblOffsetX" Text="0 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrOffsetX" Minimum="-400" Maximum="400" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Horizontal offset" AutomationProperties.HelpText="X offset in pixels, minus 400 to 400"
                        ValueChanged="SldrOffsetX_ValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="0">
                <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Offset}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Y Offset" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock x:Name="LblOffsetY" Text="0 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                <Slider x:Name="SldrOffsetY" Minimum="-400" Maximum="400" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Vertical offset" AutomationProperties.HelpText="Y offset in pixels, minus 400 to 400"
                        ValueChanged="SldrOffsetY_ValueChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                <Button Content="◄" Padding="0" MinHeight="44" MinWidth="44" Style="{StaticResource FlatButton}" Margin="0,0,6,0" AutomationProperties.Name="Nudge left one pixel" Click="BtnNudgeXLeft_Click" ToolTip="X −1 px"/>
                <Button Content="►" Padding="0" MinHeight="44" MinWidth="44" Style="{StaticResource FlatButton}" AutomationProperties.Name="Nudge right one pixel" Click="BtnNudgeXRight_Click" ToolTip="X +1 px"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
                <Button Content="▲" Padding="0" MinHeight="44" MinWidth="44" Style="{StaticResource FlatButton}" Margin="0,0,6,0" AutomationProperties.Name="Nudge up one pixel" Click="BtnNudgeYUp_Click" ToolTip="Y −1 px"/>
                <Button Content="▼" Padding="0" MinHeight="44" MinWidth="44" Style="{StaticResource FlatButton}" AutomationProperties.Name="Nudge down one pixel" Click="BtnNudgeYDown_Click" ToolTip="Y +1 px"/>
              </StackPanel>
              <Button Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Style="{StaticResource FlatButton}"
                      HorizontalAlignment="Left" Padding="10,0" MinHeight="44" Click="BtnResetOffset_Click"
                    AutomationProperties.Name="Reset offset to centre"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Centre}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset Offset to Centre" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
          </Border>

          <!-- ── Feature #38: Layer 2 ── -->
          <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
              <!-- Enable toggle row — always active -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Layers}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Layer 2" AutomationProperties.HeadingLevel="Level2" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}"
                           VerticalAlignment="Center"/></StackPanel>
                <CheckBox x:Name="ChkLayer2" Grid.Column="1" Content="Enable second reticle layer"
                          AutomationProperties.Name="Enable second reticle layer"
                          VerticalAlignment="Center"
                          Checked="ChkLayer2_Changed" Unchecked="ChkLayer2_Changed"/>
              </Grid>
              <!-- All Layer 2 controls — dimmed and inert when disabled (WCAG #3, #4) -->
              <Grid x:Name="PanelLayer2" Margin="0,8,0,0" IsEnabled="False" Opacity="0.4" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition Height="6"/><RowDefinition/>
                  <RowDefinition Height="6"/><RowDefinition/><RowDefinition Height="6"/><RowDefinition Height="44"/>
                </Grid.RowDefinitions>
                <!-- Type -->
                <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Type" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                             Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="CmbLayer2Type" Grid.Column="1"
                            AutomationProperties.Name="Layer 2 reticle type"
                            SelectionChanged="CmbLayer2Type_SelectionChanged">
                    <ComboBoxItem Content="Crosshair" ContentTemplate="{StaticResource JtLabelItemTemplate}"   Tag="Crosshair"/>
                    <ComboBoxItem Content="Dot" ContentTemplate="{StaticResource JtLabelItemTemplate}"          Tag="Dot"/>
                    <ComboBoxItem Content="Circle" ContentTemplate="{StaticResource JtLabelItemTemplate}"       Tag="Circle"/>
                    <ComboBoxItem Content="Cross + Dot" ContentTemplate="{StaticResource JtLabelItemTemplate}" Tag="CrossDot"/>
                    <ComboBoxItem Content="Diamond" ContentTemplate="{StaticResource JtLabelItemTemplate}"      Tag="Diamond"/>
                    <ComboBoxItem Content="Hexagon" ContentTemplate="{StaticResource JtLabelItemTemplate}"      Tag="Hexagon"/>
                    <ComboBoxItem Content="Octagon" ContentTemplate="{StaticResource JtLabelItemTemplate}"      Tag="Octagon"/>
                    <ComboBoxItem Content="Circle+Cross" ContentTemplate="{StaticResource JtLabelItemTemplate}" Tag="CircleCross"/>
                  </ComboBox>
                </Grid>
                <!-- Color — now inside PanelLayer2 (WCAG #3) -->
                <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="LblLayer2Color" Grid.Column="0" Text="Color"
                             FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button x:Name="SwatchLayer2" Grid.Column="1"
                          Style="{StaticResource SwatchButton}" Background="#00FF00" MinHeight="44" MinWidth="44"
                          Tag="Open layer 2 color picker"
                          AutomationProperties.Name="Open layer 2 color picker"
                          Click="SwatchLayer2_Click" ToolTip="Layer 2 color"/>
                  <TextBox x:Name="TxtLayer2Color" Grid.Column="2" Text="#00FF00" MaxLength="9"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           AutomationProperties.LabeledBy="{Binding ElementName=LblLayer2Color}"
                           TextChanged="TxtLayer2Color_TextChanged"/>
                </Grid>
                <!-- Size / Thickness -->
                <StackPanel Grid.Column="0" Grid.Row="4">
                  <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Size}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Size" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="LblLayer2Size" Text="80 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                  <Slider x:Name="SldrLayer2Size" Minimum="4" Maximum="400" Value="80" TickFrequency="1" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="Layer 2 size" ValueChanged="SldrLayer2Size_ValueChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="4">
                  <Grid><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Thickness}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Thickness" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                  <TextBlock x:Name="LblLayer2Thick" Text="1.5 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right"/></Grid>
                  <Slider x:Name="SldrLayer2Thick" Minimum="1" Maximum="20" Value="1.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="Layer 2 thickness" ValueChanged="SldrLayer2Thick_ValueChanged"/>
                </StackPanel>
                <!-- Opacity -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"><Image Source="{StaticResource JtIcon.Opacity}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Opacity" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                             Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
                  <Slider x:Name="SldrLayer2Opacity" Grid.Column="1" Minimum="0.05" Maximum="1.0" Value="0.6"
                          TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,0"
                          AutomationProperties.Name="Layer 2 opacity" ValueChanged="SldrLayer2Opacity_ValueChanged"/>
                  <TextBlock x:Name="LblLayer2Opacity" Grid.Column="2" Text="60%"
                             FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>

          <Border Height="6"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Resize handle — drag OR keyboard (WCAG 2.5.7 dragging-movements alternative) -->
    <sh:AccessibleResizeGrip/>

  </Grid>
</Window>
