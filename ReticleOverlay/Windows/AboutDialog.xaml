<Window x:Class="ReticleOverlay.AboutDialog"
        ResizeMode="CanResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ReticleOverlay.Controls"
        Title="About Reticle Overlay"
        AutomationProperties.Name="About Reticle Overlay"
        AutomationProperties.HelpText="About information, version, links, and donation options for Reticle Overlay"
        Width="540" Height="640" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
  <!-- ScrollViewer guards against clipping at low DPI-scaled resolutions (WACK 800×600 test) -->
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,28,24">

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource JtIcon.Reticle}" Style="{StaticResource JtHeaderIcon}" Width="32" Height="32"/><TextBlock Text="Reticle Overlay"
               FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
               Foreground="{DynamicResource BrushBlueText}" VerticalAlignment="Center"/></StackPanel>
    <TextBlock Text="Always-on-top crosshair overlay for Windows gaming"
               FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,2,0,0"/>

    <Separator Margin="0,14,0,14"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionLabel"
                 FontFamily="Segoe UI Mono" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Created by"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="Matthew Pittman"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <TextBlock Grid.Row="4" Grid.Column="0" Text="Platform"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <TextBlock Grid.Row="4" Grid.Column="1"
                 Text="Windows · WPF · .NET 10"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                 Foreground="{DynamicResource BrushText}"/>

      <TextBlock Grid.Row="6" Grid.Column="0" Text="Settings file"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}"/>
      <StackPanel Grid.Row="6" Grid.Column="1">
        <TextBlock x:Name="SettingsPathLabel"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button x:Name="BtnCopyPath"
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44"
                  ToolTip="Copy settings folder path to clipboard"
                  AutomationProperties.Name="Copy settings folder path to clipboard"
                  AutomationProperties.HelpText="Copies the settings folder path to the clipboard"
                  Click="BtnCopyPath_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock x:Name="BtnCopyPathText" Text="Copy path" VerticalAlignment="Center"/></StackPanel></Button>
          <Button
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44" Margin="4,0,0,0"
                  ToolTip="Export profiles to a JSON file"
                  AutomationProperties.Name="Export profiles to a JSON file"
                  AutomationProperties.HelpText="Saves all profiles to a JSON backup file"
                  Click="BtnExport_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Export}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Export" VerticalAlignment="Center"/></StackPanel></Button>
          <Button
                  Style="{StaticResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44" Margin="4,0,0,0"
                  ToolTip="Import profiles from a previously exported JSON file"
                  AutomationProperties.Name="Import profiles from a JSON file"
                  AutomationProperties.HelpText="Restores profiles from a previously exported JSON file"
                  Click="BtnImport_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Import" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="8" Grid.Column="0" Text="Website"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button Grid.Row="8" Grid.Column="1"
              HorizontalAlignment="Left"
              Style="{StaticResource FlatButton}"
              FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44"
              AutomationProperties.Name="Open Old Gamers Software website"
              AutomationProperties.HelpText="Opens oldgamerssoftware.com in your default browser"
              ToolTip="https://oldgamerssoftware.com/"
              Click="BtnWebsite_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Web}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="oldgamerssoftware.com" VerticalAlignment="Center"/></StackPanel></Button>

      <TextBlock Grid.Row="10" Grid.Column="0" Text="GitHub"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button Grid.Row="10" Grid.Column="1"
              HorizontalAlignment="Left"
              Style="{StaticResource FlatButton}"
              FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44"
              AutomationProperties.Name="View Reticle Overlay on GitHub"
              AutomationProperties.HelpText="Opens the Reticle-Overlay GitHub repository in your browser"
              ToolTip="https://github.com/lordmaus/Reticle-Overlay"
              Click="BtnGitHub_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Link}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="GitHub" VerticalAlignment="Center"/></StackPanel></Button>

      <TextBlock Grid.Row="12" Grid.Column="0" Text="Help"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushHint}" VerticalAlignment="Center"/>
      <Button Grid.Row="12" Grid.Column="1"
              HorizontalAlignment="Left"
              Style="{StaticResource FlatButton}"
              FontSize="{DynamicResource FontSizeCaption}" Padding="8,0" MinHeight="44"
              ToolTip="Opens README.md in your default text editor"
              AutomationProperties.Name="Open README help file"
              AutomationProperties.HelpText="Opens README.md in your default text editor"
              Click="BtnReadme_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.File}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Open README" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Row="14" Grid.Column="1"
              HorizontalAlignment="Left"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="8,0" MinHeight="44"
              ToolTip="Opens the folder that holds crash.log (errors only — no screen content)"
              AutomationProperties.Name="Open crash log folder"
              Click="BtnCrashLog_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.File}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Open crash log folder" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>

    <Separator Margin="0,14,0,14"/>

    <TextBlock FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushText}"
               TextWrapping="Wrap" TextAlignment="Center"
               Text="Reticle Overlay draws a fully customizable crosshair on top of any game or application. Supports multiple reticle types, custom PNG images, per-game offset profiles, global hotkeys, and system-tray operation."/>

    <Separator Margin="0,14,0,14"/>

    <TextBlock Text="Donate / Buy Me a Coffee"
               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
               Foreground="{DynamicResource BrushBlueText}"
               HorizontalAlignment="Center" Margin="0,0,0,6"/>
    <TextBlock Text="If Reticle Overlay is useful to you, consider a small donation!"
               FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}"
               HorizontalAlignment="Center" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Venmo"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,0" MinHeight="44" Margin="0,0,12,0"
              ToolTip="Donate via Venmo: @Matthew-Pittman-80"
              AutomationProperties.Name="Donate via Venmo"
              AutomationProperties.HelpText="Opens the Venmo donation page in your browser"
              Click="BtnVenmo_Click"/>
      <Button Content="Cash App"
              Style="{StaticResource FlatButton}"
              FontSize="12" Padding="20,0" MinHeight="44"
              ToolTip="Donate via Cash App: $MatthewPittman80"
              AutomationProperties.Name="Donate via Cash App"
              AutomationProperties.HelpText="Opens the Cash App donation page in your browser"
              Click="BtnCashApp_Click"/>
    </StackPanel>

    <Separator Margin="0,14,0,14"/>

    <!-- Privacy -->
    <Border Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushBlue}"
            BorderThickness="0,0,0,2"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Image Source="{StaticResource JtIcon.Lock}" Style="{StaticResource JtInlineIcon}"/>
          <TextBlock Text="Privacy — what this app does NOT do"
                     FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Margin="0,0,0,6"
                   Text="Reticle Overlay never: collects, stores, or transmits usage data · requires an account · makes network calls (no telemetry, no analytics, no update pings) · stores files outside %APPDATA%\ReticleOverlay."
                   AutomationProperties.Name="Privacy statement"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"
                   Text="The only outbound network activity occurs when YOU click a link in this dialog (website, GitHub, Venmo, Cash App). That opens your default browser — Reticle Overlay itself makes no HTTP calls."/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}">
          <Run FontWeight="SemiBold">GDPR legal basis:</Run>
          <Run>Processing is based on your consent. You may delete all stored data at any time by removing the AppData\ReticleOverlay folder.</Run>
        </TextBlock>
      </StackPanel>
    </Border>

  </StackPanel>
  </ScrollViewer>

  <!-- Sticky footer bar -->
  <Border Grid.Row="1" Background="{DynamicResource BrushBar}" Padding="16,10">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Close" Style="{StaticResource PrimaryButton}"
              Padding="40,8" MinHeight="44"
              IsCancel="True" IsDefault="True"
              AutomationProperties.Name="Close About dialog"
              AutomationProperties.HelpText="Close this dialog. Keyboard shortcut: Escape or Enter"
              Click="BtnClose_Click"/>
    </StackPanel>
  </Border>

  <!-- WCAG 2.5.7: canonical accessible resize grip (see FileCopy's SettingsDialog.xaml) —
       focusable, keyboard-resizable, mouse-draggable via WM_NCLBUTTONDOWN. Replaces the
       prior decorative-only Path (IsHitTestVisible="False", no drag/keyboard handlers). -->
  <ctl:AccessibleResizeGrip/>
  </Grid>
</Window>
