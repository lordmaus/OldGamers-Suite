<Window x:Class="ReticleOverlay.SettingsDialog"
        ResizeMode="CanResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Settings"
        Width="540" SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        Closing="Window_Closing">

  <Grid>
  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBar}"
            BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,0,0,1" Padding="14,0" MinHeight="52">
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Settings}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="Settings" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/></StackPanel>
        <TextBlock Text="Behaviour and startup options"
                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushBar}"
            BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,1,0,0" Padding="14,0" MinHeight="52">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="LblSaved" Text="" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushGreenText}" VerticalAlignment="Center"/>
        <Button Content="Close" Style="{StaticResource PrimaryButton}"
                Grid.Column="1" Padding="24,0" MinHeight="44"
                IsCancel="True" Click="BtnClose_Click"/>
      </Grid>
    </Border>

    <!-- ScrollViewer guards against clipping at low DPI-scaled resolutions (WACK 800×600 test) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12,14,12">

      <TextBlock Text="DISPLAY &amp; FONTS"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
      <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="App font family:" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                     Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
          <ComboBox x:Name="CboAppFontFamily" MinHeight="44" Margin="0,0,0,10"
                    AutomationProperties.Name="App font family"
                    AutomationProperties.HelpText="Choose the font used throughout the application UI"
                    ToolTip="Choose the font used throughout the application UI"
                    SelectionChanged="CboAppFontFamily_SelectionChanged"/>
          <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="HUD label size:" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                       Foreground="{DynamicResource BrushText}"/>
            <TextBlock x:Name="LblHudFontSize" Grid.Column="1" Text="12 px"
                       FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                       Foreground="{DynamicResource BrushMuted}"/>
          </Grid>
          <Slider x:Name="SldHudFontSize" Minimum="8" Maximum="72" Value="12"
                  TickFrequency="2" IsSnapToTickEnabled="True"
                  AutomationProperties.Name="HUD label size"
                  AutomationProperties.HelpText="Range 8 to 72 px"
                  ToolTip="HUD label size in pixels (8 to 72)"
                  ValueChanged="SldHudFontSize_ValueChanged"/>
        </StackPanel>
      </Border>

      <TextBlock Text="BEHAVIOUR" AutomationProperties.HeadingLevel="Level2"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
      <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="12,6" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox x:Name="ChkMinToTray"
                    MinHeight="44"
                    AutomationProperties.Name="Minimize to system tray on close"
                    Checked="ChkMinToTray_Changed" Unchecked="ChkMinToTray_Changed"
                    ToolTip="Overlay keeps running in the tray when the control window is closed"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Minimize to system tray on close" VerticalAlignment="Center"/></StackPanel></CheckBox>
          <CheckBox x:Name="ChkHideFromCapture"
                    MinHeight="44"
                    AutomationProperties.Name="Hide overlay from screen capture and OBS"
                    Checked="ChkHideFromCapture_Changed" Unchecked="ChkHideFromCapture_Changed"
                    ToolTip="Uses SetWindowDisplayAffinity — invisible to OBS and capture cards (Windows 10 2004+)"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.EyeOff}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Hide overlay from screen capture / OBS" VerticalAlignment="Center"/></StackPanel></CheckBox>
          <!-- Feature #1 / Bug #3 (2026-09-07 review): real per-game auto-switching.
               Per-profile match string is set in the Profiles panel on the main window. -->
          <CheckBox x:Name="ChkAutoSwitch"
                    MinHeight="44"
                    AutomationProperties.Name="Automatically switch profiles based on the foreground game"
                    Checked="ChkAutoSwitch_Changed" Unchecked="ChkAutoSwitch_Changed"
                    ToolTip="Checks the foreground window every couple seconds and switches to any profile whose auto-switch .exe matches"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rules}" Style="{StaticResource JtInlineIcon}"/><TextBlock Text="Automatically switch profiles based on the foreground game" VerticalAlignment="Center"/></StackPanel></CheckBox>
        </StackPanel>
      </Border>

      <TextBlock Text="STARTUP" AutomationProperties.HeadingLevel="Level2"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
      <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="12,6" Margin="0,0,0,12">
        <CheckBox x:Name="ChkStartup"
                  Content="Launch Reticle Overlay at Windows startup"
                  MinHeight="44"
                  AutomationProperties.Name="Launch Reticle Overlay at Windows startup"
                  Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"
                  ToolTip="Adds a registry Run key so the overlay starts with Windows"/>
      </Border>

      <!-- Polish #6: Reset all to defaults -->
      <TextBlock Text="RESET" AutomationProperties.HeadingLevel="Level2"
                 FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
      <Border Background="{DynamicResource BrushSurf}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
        <StackPanel>
          <TextBlock Text="Resets all reticle settings (size, color, type, opacity, offset) to factory defaults. Does not delete saved profiles."
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button x:Name="BtnResetDefaults"
                  Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                  Padding="14,0" MinHeight="44"
                  AutomationProperties.Name="Reset all settings to factory defaults"
                  Click="BtnResetDefaults_Click"
                  ToolTip="Resets all reticle settings to factory defaults"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset All to Defaults" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </Border>

    </StackPanel>
    </ScrollViewer>
  </DockPanel>
  <sh:AccessibleResizeGrip/>
  </Grid>
</Window>
