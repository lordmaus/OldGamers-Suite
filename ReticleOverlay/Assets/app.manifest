<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ReticleOverlay.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share GUID {8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a} -->
      <!-- WACK requires this to be present for store / certification submission -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
    <!-- DPI awareness is set via <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
         in the csproj, which injects the correct dpiAwareness manifest fragment at build time.
         Do NOT duplicate it here — duplicate declarations cause a manifest merge conflict. -->
  </compatibility>
</assembly>
