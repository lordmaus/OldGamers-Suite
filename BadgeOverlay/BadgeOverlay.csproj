<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BadgeOverlay</AssemblyName>
    <RootNamespace>BadgeOverlay</RootNamespace>
    <AssemblyTitle>Badge Overlay</AssemblyTitle>
    <Product>Badge Overlay</Product>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Version: from version.txt via ..\Directory.Build.props (S-03); build.bat bumps it. -->
    <Optimize>true</Optimize>
    <!-- portable PDB next to the exe → crash stacks get file/line (S-08). build.bat stages it in Builds\<ver>\, not the installer. -->
    <DebugType>portable</DebugType>
    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-monitor DPI v2 (replaces manifest dpiAware). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Background GC for the 30 Hz overlay loop; App.OnStartup also sets SustainedLowLatency (BO-06: keep until measured). -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BadgeOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\app.manifest" />
    <None Update="Assets\app.ico" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- System.Speech (SAPI TTS for Screen Reader Mode). Pinned 9.0.0 deliberately: re-test SAPI on Win10 LTSC / Win11 N before bumping; never use a float range. -->
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <!-- Suite (2026-10-13): shared library + canonical themes (Shared\Themes, linked so "Themes/X.xaml" URIs still resolve). -->
  <ItemGroup>
    <ProjectReference Include="..\Shared\OldGamers.Wpf.Shared\OldGamers.Wpf.Shared.csproj" />
    <Page Include="..\Shared\Themes\*.xaml" Link="Themes\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
