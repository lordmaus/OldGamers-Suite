<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Laser Grid — retro vector grid -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0A0020"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#180050"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#220070"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FF80FF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#DE90DE"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#DF7CDF"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#5593FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#44FF88"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF00AA"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF80FF"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFEE"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#100030"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#2A0055"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#CF3DCF"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7676"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#6AA0FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#44FF88"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFDD00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
