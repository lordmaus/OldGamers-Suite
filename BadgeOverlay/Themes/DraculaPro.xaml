<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dracula Pro — enhanced Dracula variant -->
  <SolidColorBrush x:Key="BrushBg"           Color="#22212C"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#2B2A38"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#3D3C4E"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F8F8F2"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#D0D0D9"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#B6B6C1"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#9783FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF9580"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#8AFF80"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFCA80"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9580"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFF80"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9580FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF79C6"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80FFEA"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#1A1924"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#6B697E"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#9190A2"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF9D8A"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#BAADFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#8AFF80"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFCA80"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
