<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Sepia — warm parchment tone -->
  <SolidColorBrush x:Key="BrushBg"           Color="#F4ECD8"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#DDD0B8"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#C8BAA0"/>
  <SolidColorBrush x:Key="BrushText"         Color="#3A2C22"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#392D1F"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#4A3B2D"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#465C69"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#9C372A"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4A7C59"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#C0845A"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#B8612A"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#BF9B30"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#7B5EA7"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#A05060"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#3D7868"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#EAE0C8"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#BEB0A0"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#573718"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6B5641"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#6D271D"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#314049"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#294431"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#563721"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
