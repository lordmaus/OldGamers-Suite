<!--
  Themes/_Indicators.xaml

  Non-interactive "indicator" styles extracted from App.xaml.

  Contains:
    • FrameworkElement text rendering — app-wide ClearType + Display mode
    • ToolTip                        — surface colours, AAA hover delay
    • Separator                      — divider line
    • SectionLabel                   — ALL-CAPS small heading style key

  Theme brushes (BrushSurf, BrushBlue, BrushSurf2, etc.) are defined in
  Themes/Dark.xaml / Light.xaml / HighContrast.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ════════════════════════════════════════════════════════════════
       ACCESSIBILITY — Text rendering (WCAG 1.4.8 Visual Presentation)
       Display-mode formatting snaps glyphs to pixel grid for sharper
       small-size text, especially critical for body copy and UI
       labels at 10–12 pt on standard-DPI monitors. Applied app-wide
       via implicit Style on FrameworkElement.
       ════════════════════════════════════════════════════════════════ -->
  <Style TargetType="{x:Type FrameworkElement}">
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
    <Setter Property="TextOptions.TextHintingMode"    Value="Fixed"/>
  </Style>

  <!-- ── ToolTip ── -->
  <Style TargetType="ToolTip">
    <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="8,5"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="12"/>
    <!-- WCAG 1.4.13: content on hover must be persistent and dismissable -->
    <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
    <!-- WCAG 2.2 — long tooltip duration for motor-impaired users who
         hover-dwell slowly. 60 s is Microsoft's recommended maximum. -->
    <Setter Property="ToolTipService.ShowDuration"     Value="60000"/>
  </Style>

  <!-- ── Separator ── -->
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource BrushSurf2}"/>
    <Setter Property="Margin"     Value="0,6"/>
    <Setter Property="Height"     Value="1"/>
  </Style>

  <!-- ── Section label (ALL-CAPS small heading) ──
       SectionLabel: BrushBlueText (>= 7:1 on Bg/Surf in every theme, checker-enforced) -->
  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize"   Value="{DynamicResource FontSizeCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushBlueText}"/>
    <Setter Property="Margin"     Value="0,10,0,0"/>
  </Style>

  <!-- ── SectionHeader (WCAG 2.4.10 Section Headings, 2026-09-25) ──
       Same look as SectionLabel + UIA HeadingLevel 2, so screen-reader heading
       navigation (H key) lands on every settings section. SectionLabel alone is
       kept for non-heading captions (e.g. CustomRules column headers).
       Dialog titles carry AutomationProperties.HeadingLevel="Level1" inline. -->
  <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
  </Style>

</ResourceDictionary>
