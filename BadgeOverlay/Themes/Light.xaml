<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light (default) — WCAG 2.2 AAA palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#F5F5F5"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#E8E8E8"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#D8D8D8"/>
  <SolidColorBrush x:Key="BrushText"         Color="#1C1C1C"/>
  <!-- BrushMuted: #4A4A4A on #F5F5F5 = 8.1:1 AAA -->
  <SolidColorBrush x:Key="BrushMuted"        Color="#424242"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#4C4C4C"/>
  <!-- Accent colours verified AAA on #F5F5F5 -->
  <SolidColorBrush x:Key="BrushBlue"         Color="#1258A8"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#AF1B1B"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#2E7D32"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#E65100"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#BB5500"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#886600"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#660099"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#990055"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#006666"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#DCDCDC"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#9E9E9E"/>
  <!-- Focus ring: #003DC2 — 7.87:1 on #F5F5F5 (AAA) -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#003DC2"/>
  <!-- CheckBox glyph on BrushBlue fill — white on dark accent -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#686868"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#961717"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#104B90"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#205623"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#872F00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
