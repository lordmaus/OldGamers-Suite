<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Abyss — deep ocean darkness -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000C18"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#001222"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#06253A"/>
  <SolidColorBrush x:Key="BrushText"         Color="#98B0C6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#97B0C7"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#81A1BE"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#1D54B6"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#9F332E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4EC994"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#DC9B21"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#BE7E3C"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#DC9B21"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#7C5295"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#9B4F8E"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#1C8A97"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#00070F"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#2A3F52"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#00FFFF"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#AAAAAA"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#5580A6"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#DB8782"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#729EE9"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#4EC994"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#DC9B21"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
