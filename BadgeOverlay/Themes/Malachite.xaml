<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Malachite — deep emerald mineral palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0A1A12"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0F2418"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#183020"/>
  <SolidColorBrush x:Key="BrushText"         Color="#A8F0C0"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#70D090"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#5BBD7B"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80D8FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00C853"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#EA80FC"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF80AB"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00BCD4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#061210"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A3A28"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#40A060"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F48D8B"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#80D8FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00C853"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD740"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
