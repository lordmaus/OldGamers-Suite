<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Indigo Night — deep indigo dark palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D0D2E"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#121240"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#1C1C58"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E8EAF6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#A4ACDC"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#96A0D7"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#A180FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#AA00FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#1DE9B6"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#080826"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1E1E5A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6E7CC7"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F3827F"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#AE92FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#58B75C"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
