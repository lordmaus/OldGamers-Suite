<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cyberpunk — neon-soaked dystopian palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0D0208"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#1A0A1E"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#2A1030"/>
  <SolidColorBrush x:Key="BrushText"         Color="#00FF9F"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#00CC80"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#00B46F"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#00B4FF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF588C"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FF9F"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD300"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF6B00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD300"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF00FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF2A6D"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#05D9E8"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#120313"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#332244"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#008E58"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF6A99"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#00B4FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FF9F"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD300"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
