<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ayu Dark — https://github.com/ayu-theme/ayu-colors -->
  <!-- WCAG AAA: BrushText/BrushMuted/FocusRingBrush ≥7:1 on BrushBg -->
  <SolidColorBrush x:Key="BrushBg"           Color="#0A0E14"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0D1117"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#17202E"/>
  <!-- BrushText:  #E6E1CF on #0A0E14 — AAA -->
  <SolidColorBrush x:Key="BrushText"         Color="#E6E1CF"/>
  <!-- BrushMuted: #B8B5AE on #0A0E14 — AAA -->
  <SolidColorBrush x:Key="BrushMuted"        Color="#B8B5AE"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#959EAF"/>
  <!-- BrushBlue:  #59C2FF on #0A0E14 = 10.5:1 — AAA -->
  <SolidColorBrush x:Key="BrushBlue"         Color="#59C2FF"/>
  <!-- BrushRed:   #FF6060 on #0A0E14 = 7.0:1 — AAA -->
  <SolidColorBrush x:Key="BrushRed"          Color="#FF6060"/>
  <!-- BrushGreen: #AAD94C on #0A0E14 = 12.4:1 — AAA -->
  <SolidColorBrush x:Key="BrushGreen"        Color="#AAD94C"/>
  <!-- BrushAmber: #FF8F40 on #0A0E14 = 9.2:1 — AAA (Ayu orange) -->
  <SolidColorBrush x:Key="BrushAmber"        Color="#FF8F40"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8F40"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD173"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#D2A6FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F07178"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#73EAEA"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#060A10"/>
  <SolidColorBrush x:Key="BrushDisabled"     Color="#3D4756"/>
  <!-- Focus ring: #FF8F40 on #0A0E14 = 9.2:1 — AAA -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FF8F40"/>
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#717C93"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7070"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#59C2FF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#AAD94C"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FF8F40"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
