<!--
  Themes/_Inputs.xaml

  Form-input control styles extracted from App.xaml. Imported via
  MergedDictionaries in Application.Resources.

  Contains:
    • CheckBox        — implicit style with custom check glyph + focus ring
    • SliderFocusVisual — keyboard focus indicator (3px Cyan/Gold + halo)
    • Slider          — implicit style binding the focus visual
    • RadioButton     — custom 18×18 ring + 10×10 inner dot
    • TextBox         — implicit style with focus border swap
    • ListBox / ListBoxItem — implicit (suite-canonical, NoteStation 2026-09-25)

  Theme brushes (BrushSurf, BrushBlue, FocusRingBrush, etc.) are defined
  in Themes/Dark.xaml / Light.xaml / HighContrast.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── CheckBox ── -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground"               Value="{DynamicResource BrushText}"/>
    <Setter Property="FontFamily"               Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"                 Value="12"/>
    <Setter Property="Margin"                   Value="0,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- WCAG 2.5.5 Target Size (Enhanced): 44 × 44 px hit
               area. The visual indicator is still 16 × 16 — the
               ContentPresenter padding pads up the *click target* to
               44 px without making the rendered control look bulky. -->
          <Grid Background="Transparent" MinHeight="44">
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" CornerRadius="4"
                    Margin="-2" Opacity="0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,10">
              <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                <Border x:Name="CheckBorder"
                        BorderBrush="{DynamicResource BrushMuted}"
                        BorderThickness="1.5" CornerRadius="2"
                        Background="Transparent"/>
                <TextBlock x:Name="CheckMark" Text="✓"
                           FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                           Foreground="{DynamicResource BrushBgForChecked}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-1,0,0" Opacity="0"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark"   Property="Opacity"      Value="1"/>
              <Setter TargetName="CheckMark"   Property="Foreground"   Value="{DynamicResource BrushBgForChecked}"/>
              <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushBlue}"/>
              <Setter TargetName="CheckBorder" Property="Background"   Value="{DynamicResource BrushBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CheckBorder" Property="BorderBrush"  Value="{DynamicResource BrushHint}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
              <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BrushDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Slider focus ring (WCAG 2.4.7 / 2.4.11) ──
       Cyan in dark theme, Gold (#8B5A00) in light theme via
       FocusRingBrush dynamic resource. AAA-compliant 7:1 contrast
       against both surface colours. Margin -4 + 3px stroke + drop
       shadow halo gives strong visibility against any track colour
       (sliders sit on Surface and Surface2 backgrounds in different
       sections; a single thickness/colour wouldn't pass on both).
       SnapsToDevicePixels keeps the stroke crisp at 100%/125%/150%
       DPI without sub-pixel blur. -->
  <Style x:Key="SliderFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4"
                     StrokeThickness="3"
                     Stroke="{DynamicResource FocusRingBrush}"
                     RadiusX="5" RadiusY="5"
                     SnapsToDevicePixels="True">
            <Rectangle.Effect>
              <DropShadowEffect Color="Black" BlurRadius="6"
                                ShadowDepth="0" Opacity="0.55"/>
            </Rectangle.Effect>
          </Rectangle>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Foreground"       Value="{DynamicResource BrushBlue}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource SliderFocusVisual}"/>
  </Style>

  <!-- ── RadioButton ──
       Custom template — default WPF radios on dark theme have a tiny
       inner dot (≈4 px) that's hard to see. We use a 18×18 outer ring
       + 10×10 inner fill in the accent colour for clear "checked"
       legibility. Focus ring on the outer border doubles as keyboard
       highlight. -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"   Value="12"/>
    <!-- WCAG 2.5.5 Target Size (Enhanced) — 44 px hit row.
         Padding accommodates the AAA target without growing the
         visible 18 px outer ring. -->
    <Setter Property="MinHeight"  Value="44"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Outer ring — name allows focus-ring trigger to address it -->
            <Border x:Name="OuterRing"
                    Width="18" Height="18"
                    CornerRadius="9"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource BrushSurf2}"
                    Background="{DynamicResource BrushSurf}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
              <!-- Inner fill — visible only when IsChecked=True -->
              <Ellipse x:Name="InnerDot"
                       Width="10" Height="10"
                       Fill="{DynamicResource BrushBlue}"
                       Visibility="Collapsed"/>
            </Border>

            <ContentPresenter Grid.Column="1"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="InnerDot"  Property="Visibility"  Value="Visible"/>
              <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
            </Trigger>
            <!-- IsFocused catches programmatic focus (radio.Focus()) so the ring
                 appears regardless of whether focus arrived via keyboard or code.
                 Mirrors the pattern used on CheckBox and all Button-family controls. -->
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── TextBox ── -->
  <Style TargetType="TextBox">
    <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BrushSurf2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="4,3"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="CaretBrush"      Value="{DynamicResource BrushText}"/>
    <Setter Property="MinHeight"       Value="44"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush"     Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ── ComboBox ──
       Custom FocusVisualStyle gives the AAA focus ring (FocusRingBrush
       2 px + drop-shadow halo) that matches sliders / buttons. Default
       WPF ComboBox focus is a 1 px dotted black-on-dark rectangle that
       fails 1.4.11 Non-text Contrast and 2.4.7 Focus Visible AAA. -->
  <Style x:Key="ComboBoxFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3"
                     StrokeThickness="2"
                     Stroke="{DynamicResource FocusRingBrush}"
                     RadiusX="3" RadiusY="3"
                     SnapsToDevicePixels="True">
            <Rectangle.Effect>
              <DropShadowEffect Color="Black" BlurRadius="4"
                                ShadowDepth="0" Opacity="0.45"/>
            </Rectangle.Effect>
          </Rectangle>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background"       Value="{DynamicResource BrushSurf}"/>
    <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush"      Value="{DynamicResource BrushSurf2}"/>
    <Setter Property="MinHeight"        Value="44"/>
    <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"         Value="12"/>
    <Setter Property="BorderThickness"  Value="1"/>
    <Setter Property="Padding"          Value="8,5"/>
    <!-- Focus ring drawn by the template (2px FocusRingBrush) -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Full template: the default Aero2 template paints its own light chrome
         (closed box + white popup) and ignores Background, so BrushText
         rendered light-on-light in every dark theme. Ported from the suite
         (TimerStudio/FileCopy) ComboBox template. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" CornerRadius="4"
                    Margin="-2" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="MainBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <TextBox x:Name="PART_EditableTextBox"
                         Grid.Column="0" Visibility="Hidden"
                         Background="Transparent"
                         Foreground="{TemplateBinding Foreground}"
                         CaretBrush="{DynamicResource BrushText}"
                         BorderThickness="0" MinHeight="0"
                         Margin="{TemplateBinding Padding}"
                         VerticalAlignment="Center"
                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <TextBlock Grid.Column="1" Text="&#x2228;" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                           Foreground="{DynamicResource BrushHint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent"/>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None">
              <Border Background="{DynamicResource BrushSurf}"
                      BorderBrush="{DynamicResource BrushSurf2}"
                      BorderThickness="1" CornerRadius="0,0,3,3"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      TextElement.Foreground="{DynamicResource BrushText}">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBoxItem — the per-row focus highlight. Default WPF item
       focus is a thin dotted box; replace with a solid border using
       the focus brush so dropdown navigation is keyboard-visible. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding"          Value="8,6"/>
    <Setter Property="MinHeight"        Value="44"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background"       Value="Transparent"/>
    <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
    <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent" BorderThickness="2"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Selected: surface + semibold + accent edge (not color alone);
                 text stays BrushText so contrast matches normal rows (AAA). -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurf2}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurf2}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── ListBox / ListBoxItem (WCAG 2.2 AAA, 2026-09-25) ──
       Suite-canonical (NoteStation App.xaml). Hover = Surf2 + BrushText outline;
       selected = Surf2 + 4px BlueText bar (not colour alone, text stays BrushText);
       keyboard focus = 2px FocusRingBrush ring; rows >= 44px. -->
  <Style TargetType="ListBox">
    <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BrushDivider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="13"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
    <Setter Property="Padding"         Value="8,6"/>
    <Setter Property="MinHeight"       Value="44"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment"   Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Border x:Name="Bar" BorderBrush="Transparent" BorderThickness="4,0,0,0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Border>
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BrushSurf2}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd"  Property="Background"  Value="{DynamicResource BrushSurf2}"/>
              <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource BrushBlueText}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Flat GroupBox ──
       WCAG 1.3.1 — GroupBox is the canonical WPF container with UIA
       Group semantics + a Header that screen readers announce as a
       label for the contained controls. The default visual chrome
       (etched border + rounded corners) clashes with the flat panel
       layout used throughout BadgeOverlay; this style strips the
       border and renders the Header as a small muted-caption above
       the content, while keeping the UIA semantics intact.

       Used to wrap radio groups so screen readers announce e.g.
       "When to speak, group, Immediately on hover, radio button,
       1 of 2" rather than reading each radio as an unrelated
       sibling. -->
  <Style TargetType="GroupBox">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushMuted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0"
                              ContentSource="Header"
                              TextBlock.FontSize="12"
                              TextBlock.Foreground="{TemplateBinding Foreground}"
                              Margin="0,0,0,4"/>
            <ContentPresenter Grid.Row="1"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
