<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ZX Spectrum — Sinclair 8-color palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000000"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#252525"/>
  <SolidColorBrush x:Key="BrushText"         Color="#CDCDCD"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#B0B0B0"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#A5A5A5"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#0000CD"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#B60000"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00CD00"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#CDCD00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#CD6600"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#CDCD00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CD00CD"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#CD88CD"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00CDCD"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#111111"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#333333"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#CDCD00"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#828282"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7D7D"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#9B9BFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00CD00"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#CDCD00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
