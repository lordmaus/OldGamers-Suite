<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Synthwave — 80s retro neon aesthetic -->
  <SolidColorBrush x:Key="BrushBg"           Color="#2B213A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3D2B5C"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#4E3570"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F5E6FF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#E0D1EC"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#CBBEDB"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#6BD3F3"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FE5E68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#72F1B8"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF500"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF901F"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF500"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BD93F9"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF2D87"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#6BD3F3"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#1A1326"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5A3F7A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#A993C4"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FFAEB3"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#6BD3F3"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#72F1B8"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFF500"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
