<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Panda — playful black-white contrast -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1E2127"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#272B34"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#333840"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E6E6E6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#C8C8C8"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#B4B6BF"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#45A9F9"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF588B"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#19F9D8"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFB86C"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9AC1"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#B084EB"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF75B5"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#19F9D8"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#191C22"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#676B79"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#8D919E"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF98B7"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#71BEFA"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#19F9D8"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFB86C"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
