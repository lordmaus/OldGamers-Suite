<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paper White — clean neutral light -->
  <SolidColorBrush x:Key="BrushBg"           Color="#F5F5F0"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#E0E0DA"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#CCCCCA"/>
  <SolidColorBrush x:Key="BrushText"         Color="#333333"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#3A3A3A"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#474747"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#5899DC"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#DE786D"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#27AE60"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#E67E22"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#D35400"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#F39C12"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#8E44AD"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E8C"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#16A085"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#EBEBEB"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#BBBBBB"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#0F4686"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#494949"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#636363"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#82271D"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#1A487A"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#12512D"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#6D3A0C"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
