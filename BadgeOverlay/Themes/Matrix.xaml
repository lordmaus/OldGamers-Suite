<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Matrix — green code rain terminal -->
  <SolidColorBrush x:Key="BrushBg"           Color="#000000"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#002400"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#003600"/>
  <SolidColorBrush x:Key="BrushText"         Color="#00FF41"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#00D736"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#00C330"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FF41"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8833"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF44FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF4488"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#001200"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#005500"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#009A26"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF8282"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FF41"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFFF44"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
