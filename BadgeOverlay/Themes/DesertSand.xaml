<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Desert Sand — warm arid dunes -->
  <SolidColorBrush x:Key="BrushBg"           Color="#3D2B1F"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#4E3828"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#614A38"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F9EBD0"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#F3ECE2"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#D8CEBF"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#87CEEB"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#D77B7B"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#8FBC8F"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#DAA520"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#D2691E"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#DAA520"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BA8FA8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#C8907A"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#5F9EA0"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#2E1F14"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#6A503A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#B7A489"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#EDC6C6"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#9ED8EF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#BBD6BB"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#ECCC7B"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
