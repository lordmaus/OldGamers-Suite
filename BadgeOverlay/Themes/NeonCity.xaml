<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neon City — urban night skyline -->
  <SolidColorBrush x:Key="BrushBg"           Color="#080C14"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0F1A2E"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#162438"/>
  <SolidColorBrush x:Key="BrushText"         Color="#E0F0FF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#92B1D0"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#90A7BF"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#00BFFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5B76"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FFB3"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8C00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#BF5FFF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF60B2"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#00E5CC"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#0A0F1C"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1E3050"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#6585A7"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7B91"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#00BFFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FFB3"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
