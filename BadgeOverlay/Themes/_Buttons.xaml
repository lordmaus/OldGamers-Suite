<!--
  Themes/_Buttons.xaml

  Button-family styles extracted from App.xaml. Imported via
  MergedDictionaries in Application.Resources.

  Contains:
    • FlatButton      — base style used for nav, action, and dialog buttons
    • (implicit)      — every Button without an explicit Style is a FlatButton
    • PrimaryButton   — emphasized (BasedOn FlatButton)
    • DangerButton    — destructive action (BasedOn FlatButton)
    • IconButton      — transparent-background, icon-only
    • ChipTemplate    — rounded pill (used for status chips, etc.)

  These styles depend on theme brushes (BrushSurf, BrushText, FocusRingBrush
  etc.) defined in Themes/Dark.xaml / Light.xaml / HighContrast.xaml. Keep
  this file purely structural — no theme colours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Base flat button ── -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Background"      Value="{DynamicResource BrushSurf}"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushText}"/>
    <Setter Property="BorderBrush"     Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="14,7"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="13"/>
    <!-- Cursor setter removed — WPF Cursor="Hand" forces WM_SETCURSOR which
         overrides YoloMouse and other 3rd-party cursor hooks. The OS
         inherits the class cursor instead. -->
    <!-- WCAG 2.5.5: minimum 44×44 px touch/click target -->
    <Setter Property="MinHeight"       Value="44"/>
    <Setter Property="MinWidth"        Value="44"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" CornerRadius="6"
                    Margin="-2" Opacity="0"/>
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Hover/press never dim content (WCAG 1.4.6 — text keeps its 7:1):
                 hover = BrushText outline, press = slight scale. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd"   Property="Opacity"    Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Implicit Button (WCAG 2.2 AAA, 2026-09-25) ──
       Unstyled Buttons (CrashLog, code-built rows) previously fell back to the
       OS Aero chrome: light-on-light text in dark themes, dotted focus, 23px.
       InfoOverlay's fixed-dark title-bar buttons use their own local style. -->
  <Style TargetType="Button" BasedOn="{StaticResource FlatButton}"/>

  <!-- ── Primary (blue) button ── -->
  <Style x:Key="PrimaryButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- ── Danger (red) button ── -->
  <Style x:Key="DangerButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource BrushRed}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- ── Icon / transparent button ── -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Background"       Value="Transparent"/>
    <Setter Property="Foreground"       Value="{DynamicResource BrushHint}"/>
    <Setter Property="BorderThickness"  Value="0"/>
    <Setter Property="MinHeight"        Value="44"/>
    <Setter Property="MinWidth"         Value="44"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" CornerRadius="4"
                    Margin="-2" Opacity="0"/>
            <Border x:Name="Bd" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Chip / pill button template (rounded) ── -->
  <ControlTemplate x:Key="ChipTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="FocusRing"
              BorderBrush="{DynamicResource FocusRingBrush}"
              BorderThickness="2" CornerRadius="18"
              Margin="-2" Opacity="0"/>
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="Transparent" BorderThickness="1"
              CornerRadius="16"
              Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushText}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="RenderTransform">
          <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsFocused" Value="True">
        <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ── Preset slot buttons (Section 5) ──
       Three visual states driven by code-behind style assignment:
         PresetButton       — empty slot (muted text, no indicator)
         PresetButtonSaved  — slot has data (full text, ◆ dot shown)
         PresetButtonActive — currently selected slot (blue bg, white fg)

       All share MinHeight=44 for WCAG 2.5.5 target size.
       Non-color differentiation: ◆ glyph satisfies WCAG 1.4.1
       (saved state conveyed by shape, not color alone).
       -->
  <Style x:Key="PresetButton" BasedOn="{StaticResource FlatButton}" TargetType="Button">
    <Setter Property="Foreground"   Value="{DynamicResource BrushMuted}"/>
    <Setter Property="MinWidth"     Value="48"/>
    <Setter Property="Padding"      Value="4,4"/>
  </Style>

  <Style x:Key="PresetButtonSaved" BasedOn="{StaticResource FlatButton}" TargetType="Button">
    <Setter Property="Foreground"   Value="{DynamicResource BrushText}"/>
    <Setter Property="FontWeight"   Value="SemiBold"/>
    <Setter Property="MinWidth"     Value="48"/>
    <Setter Property="Padding"      Value="4,4"/>
  </Style>

  <Style x:Key="PresetButtonActive" BasedOn="{StaticResource FlatButton}" TargetType="Button">
    <Setter Property="Background"   Value="{DynamicResource BrushBlue}"/>
    <Setter Property="Foreground"   Value="{DynamicResource BrushOnAccent}"/>
    <Setter Property="FontWeight"   Value="Bold"/>
    <Setter Property="MinWidth"     Value="48"/>
    <Setter Property="Padding"      Value="4,4"/>
  </Style>

  <!-- ── Section help button ──
       Small "?" icon next to each section header so users don't have
       to know about F1. Reachable by keyboard (Tab order) and surfaces
       a clear AutomationProperties.Name describing which section the
       help relates to. WCAG 3.3.5 (Help, AAA) — context-sensitive help
       on every input form section. Tooltips alone fail because they
       vanish on cursor movement and aren't keyboard-reachable;
       a tab-stop button is the conformant pattern.

       Default 28×28 visual but 44×44 click target via padding, per
       2.5.5 Target Size (Enhanced). Tag holds the section anchor so
       click handler can scroll the cheat-sheet to the right anchor.
       -->
  <Style x:Key="SectionHelpButton" TargetType="Button">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{DynamicResource BrushBlueText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="FontWeight"      Value="SemiBold"/>
    <Setter Property="MinWidth"        Value="44"/>
    <Setter Property="MinHeight"       Value="44"/>
    <Setter Property="Padding"         Value="0"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusRingBrush}"
                    BorderThickness="2" CornerRadius="14"
                    Margin="-2" Opacity="0"/>
            <Border x:Name="Bd"
                    Width="28" Height="28"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BrushBlueText}"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <TextBlock Text="?"
                         FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurf2}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
