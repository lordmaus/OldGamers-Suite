<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Catppuccin Latte — https://github.com/catppuccin/catppuccin
       Accent colours darkened vs official values to meet WCAG AAA on #EFF1F5. -->
  <SolidColorBrush x:Key="BrushBg"           Color="#EFF1F5"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#E6E9EF"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#DCE0E8"/>
  <SolidColorBrush x:Key="BrushText"         Color="#43455C"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#444659"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#4A4B59"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#1E4ECA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#A30D2E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#1E6E3B"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#7A4F00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#7A4F00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#7A4F00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#5B21B6"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#9D174D"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#0D6E6E"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#E6E9EF"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#ACB0BE"/>
  <!-- Focus ring: #1A43AE — 7.56:1 on #EFF1F5 (AAA) -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#1A43AE"/>
  <!-- CheckBox glyph on BrushBlue fill — white on dark accent -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#66687B"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#9A0C2C"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#1A43AE"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#18572F"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#6A4500"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
