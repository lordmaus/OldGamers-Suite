<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Gruvbox Dark — https://github.com/morhetz/gruvbox -->
  <SolidColorBrush x:Key="BrushBg"           Color="#282828"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3C3836"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#504945"/>
  <SolidColorBrush x:Key="BrushText"         Color="#F0E5C6"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#ECE5D5"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#CFC8C1"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#83A598"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FC6250"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#B8BB26"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FABD2F"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FE8019"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FABD2F"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#D3869B"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#D3869B"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#8EC07C"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#1D2021"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#928374"/>
  <!-- Focus ring: yellow #FAC13A — 8.95:1 on #282828 -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FAC13A"/>
  <!-- CheckBox glyph on BrushBlue fill — dark on bright accent -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#ABA094"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FDB9B0"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#BBCEC6"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#CDD12A"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FAC13A"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
