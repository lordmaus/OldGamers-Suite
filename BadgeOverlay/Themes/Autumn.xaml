<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Autumn — warm fall foliage palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#2B1810"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#3C2218"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#4E2E20"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFD7A8"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#E7BE93"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#D5AC8C"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#87CEEB"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16782"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#6B8E23"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#D2691E"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF6D00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFD700"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9370DB"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#DB7093"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#2E8B57"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#1F0F08"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#5A3520"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#C08151"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F699AB"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#87CEEB"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#93C330"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#EBA471"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
