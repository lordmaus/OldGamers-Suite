<Window x:Class="BadgeOverlay.CrashLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Crash log — Badge Overlay"
        Width="720" Height="600"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + status -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Diagnostic log" AutomationProperties.HeadingLevel="Level1"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}"/>
            <TextBlock x:Name="LblPath"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushMuted}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="Full path to the log file"/>
            <TextBlock x:Name="LblStats"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushMuted}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Log body (read-only, monospace, word-wrap off for stack traces) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushSurf}"
                BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     IsUndoEnabled="False"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="{DynamicResource BrushText}"
                     BorderThickness="0"
                     Padding="8"
                     AcceptsReturn="False"
                     AcceptsTab="False"
                     AutomationProperties.Name="Crash log contents"
                     AutomationProperties.HelpText="Read-only document view of the most recent crash log entries"/>
        </Border>

        <!-- Status line (last action result) -->
        <TextBlock Grid.Row="2"
                   x:Name="LblStatus"
                   Margin="0,8,0,8"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushMuted}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,40,0">
            <Button x:Name="BtnRefresh"
                    Padding="12,6" MinHeight="44" Margin="0,0,6,0"
                    AutomationProperties.Name="Refresh log"
                    AutomationProperties.HelpText="Reload the log file contents"
                    Click="BtnRefresh_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Refresh}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Refresh" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnCopy"
                    Padding="12,6" MinHeight="44" Margin="0,0,6,0"
                    AutomationProperties.Name="Copy log to clipboard"
                    AutomationProperties.HelpText="Copy the entire log contents to the clipboard"
                    Click="BtnCopy_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Clipboard}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Copy all" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnOpenFolder"
                    Padding="12,6" MinHeight="44" Margin="0,0,6,0"
                    AutomationProperties.Name="Open log folder"
                    AutomationProperties.HelpText="Open the containing folder in Windows Explorer"
                    Click="BtnOpenFolder_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Open}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Open folder" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnClear"
                    Padding="12,6" MinHeight="44" Margin="0,0,6,0"
                    AutomationProperties.Name="Clear log"
                    AutomationProperties.HelpText="Delete all entries from the crash log"
                    Click="BtnClear_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.ClearAll}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Clear log" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="BtnClose" Content="Close"
                    Padding="14,6" MinHeight="44"
                    IsCancel="True"
                    AutomationProperties.Name="Close viewer"
                    Click="BtnClose_Click"/>
        </StackPanel>

        <!-- WCAG 2.2 AAA grip: 44px, focusable, arrow-key resize, 2px focus ring (suite-canonical) -->
        <sh:AccessibleResizeGrip Margin="0,0,-12,-12"/>
    </Grid>
</Window>
