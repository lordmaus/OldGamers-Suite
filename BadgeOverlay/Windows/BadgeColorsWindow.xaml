<Window x:Class="BadgeOverlay.BadgeColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Badge Detection Colours"
        Width="540" Height="560"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBar}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Badge Detection Colours" AutomationProperties.HeadingLevel="Level1"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource BrushBlueText}"/>
                <TextBlock Text="Set the colour for each button category. Click a swatch to change it."
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Colour rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,8">
                <!-- Colour-vision presets — applies a curated palette
                     in one click. Each preset is a Daltonization-friendly
                     re-mapping that preserves WCAG AAA badge contrast.
                     "Default" restores the factory palette; "Custom" is
                     the marker that the user has edited individual rows
                     and is auto-selected when any swatch differs from
                     a known preset. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Palette preset"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushMuted}"
                               ToolTip="Apply a colour-blind-friendly palette in one click. Choose Custom to edit individual swatches."/>
                    <ComboBox Grid.Column="1" x:Name="CboPalettePreset"
                              MinHeight="44"
                              AutomationProperties.Name="Palette preset"
                              AutomationProperties.HelpText="Apply a colour-blind-friendly palette: Default, Deuteranopia, Protanopia, Tritanopia, or Custom"
                              SelectionChanged="CboPalettePreset_Changed"/>
                </Grid>
                <Separator Margin="0,0,0,4"/>
                <StackPanel x:Name="ColorRows"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBar}" Padding="16,10,52,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                        Style="{StaticResource FlatButton}"
                        Padding="12,6" MinHeight="44" Margin="0,0,8,0"
                        Click="BtnReset_Click"
                    AutomationProperties.Name="Reset to Defaults"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset to Defaults" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,6" MinHeight="44"
                        IsCancel="True"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- WCAG 2.2 AAA grip: 44px, focusable, arrow-key resize, 2px focus ring (suite-canonical) -->
        <sh:AccessibleResizeGrip/>
</Grid></Window>
