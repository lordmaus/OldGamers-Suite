<Window x:Class="BadgeOverlay.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Keyboard Shortcuts — Badge Overlay"
        Width="540" Height="640"
        MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}"
        AutomationProperties.Name="Keyboard shortcuts reference"
        KeyDown="Window_KeyDown">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Keyboard Shortcuts" FontSize="20" AutomationProperties.HeadingLevel="Level1" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushBlueText}"/>
            <TextBlock Text="All Badge Overlay shortcuts in one place. Press Esc or F1 again to close."
                       FontSize="12" Foreground="{DynamicResource BrushMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Global hotkeys -->
                <TextBlock Text="GLOBAL (work in any app)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel x:Name="GlobalHotkeysPanel"/>
                </Border>

                <!-- Main window mnemonics -->
                <TextBlock Text="MAIN WINDOW (Alt + key)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+B" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open Badge Colours dialog"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+R" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open Custom Rules editor"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+H" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open Hotkeys editor"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+S" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open Startup &amp; Settings"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+A" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open About dialog"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+T" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Cycle theme (Dark / Light)"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+Z" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Cycle UI scale (Standard / Medium / Large / Xtra Large)"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="F1" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Open this cheat-sheet"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Info Overlay -->
                <TextBlock Text="INFO OVERLAY (when focused)" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Arrow keys" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Move overlay 20 px"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Alt+Arrow" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Move overlay 10 px (works from any control)"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ctrl+Alt+Arrow" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Resize overlay 10 px"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Shift+Arrow" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Move 1 px (precise)"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ctrl+Arrow" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Move 100 px (large)"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ctrl+Home" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Centre on primary monitor"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="+ / −" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Increase / decrease font size"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Esc" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Hide overlay"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Standard nav -->
                <TextBlock Text="STANDARD NAVIGATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Tab / Shift+Tab" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Move keyboard focus forward / backward"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Space / Enter" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Activate focused button or toggle"/>
                        </Grid>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Esc" FontFamily="Consolas" Foreground="{DynamicResource BrushBlueText}"/>
                            <TextBlock Grid.Column="1" Text="Close current dialog"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,32,0">
            <Button Content="Close" Style="{StaticResource FlatButton}"
                    MinWidth="80" Padding="14,6"
                    IsCancel="True" IsDefault="True"
                    Click="BtnClose_Click"/>
        </StackPanel>

        <!-- WCAG 2.2 AAA grip: 44px, focusable, arrow-key resize, 2px focus ring (suite-canonical) -->
        <sh:AccessibleResizeGrip Margin="0,0,-20,-16"/>
    </Grid>
</Window>
