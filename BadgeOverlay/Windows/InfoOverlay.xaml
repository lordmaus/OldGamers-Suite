<Window x:Class="BadgeOverlay.InfoOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info Overlay"
        Width="360" Height="180"
        MinWidth="260" MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Title-bar buttons use the Overlay* palette (Core/OverlayPalette.cs: Badge style Dark/Light/
             MatchTheme, Windows High Contrast): text ≥7:1, focus ring ≥3:1, hover = text-colour outline,
             44x44 targets (WCAG 2.2 AAA 1.4.6 / 2.4.13 / 2.5.5). -->
        <Style x:Key="OverlayTitleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OverlayText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Ring" BorderBrush="{DynamicResource OverlayFocus}" BorderThickness="2"
                                    CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OverlayText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OverlayPill}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="14"
                BorderThickness="3"
                Background="{DynamicResource OverlayBg}"
                Margin="4">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.60"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Title bar ─────────────────────────────────────── -->
                <Border Grid.Row="0"
                        x:Name="DragBar"
                        CornerRadius="12,12,0,0"
                        Padding="12,0,4,0"
                        ToolTip="Drag to move · Alt+Arrow keys · right-click or Shift+F10 for keyboard move/resize"
                        MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                    <Border.Background>
                        <SolidColorBrush x:Name="DragBarBrush" Color="#20FFFFFF"/>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x25C9;  Badge Overlay &#x2014; Info"
                                   FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource OverlayText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="A-" Style="{StaticResource OverlayTitleButton}"
                                    AutomationProperties.Name="Decrease text size"
                                    ToolTip="Decrease font size (-)"
                                    Click="BtnFontDec_Click"/>
                            <Button Content="A+" Style="{StaticResource OverlayTitleButton}"
                                    AutomationProperties.Name="Increase text size"
                                    ToolTip="Increase font size (+)"
                                    Click="BtnFontInc_Click"/>
                            <Button Content="&#x2715;" Style="{StaticResource OverlayTitleButton}"
                                    AutomationProperties.Name="Close"
                                    AutomationProperties.HelpText="Hide the info overlay (Esc)"
                                    ToolTip="Hide info overlay (Esc)"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Content ───────────────────────────────────────── -->
                <!-- ── Detection health (BO-02) — shown when reads keep failing (e.g. elevated app) ── -->
                <Border Grid.Row="1" x:Name="DegradedBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource OverlayBar}"
                        BorderBrush="{DynamicResource OverlayWarn}" BorderThickness="0,1,0,1"
                        Padding="14,8,14,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#x26A0;" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{DynamicResource OverlayWarn}" VerticalAlignment="Top"
                                   AutomationProperties.Name="Warning"/>
                        <TextBlock x:Name="DegradedText" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource OverlayWarn}"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Padding="14,10,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconPill"
                                Grid.Column="0"
                                CornerRadius="8" Padding="8,4"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush x:Name="IconPillBg" Color="#33FFFFFF"/>
                            </Border.Background>
                            <TextBlock x:Name="InfoIcon"
                                       x:FieldModifier="private"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="&#x25C9;"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="InfoLabel"
                                       FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                       FontWeight="Bold"
                                       FontSize="24"
                                       Foreground="{DynamicResource OverlayText}"
                                       TextWrapping="Wrap"
                                       Text="Hover a button"/>
                            <TextBlock x:Name="InfoCategory"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="14"
                                       Foreground="{DynamicResource OverlayMuted}"
                                       Text="Move me anywhere"/>
                            <!-- Extended metadata: keyboard shortcut, value,
                                 toggle state, selection, link URL, item type,
                                 process name. Each line only renders when
                                 the corresponding field is populated —
                                 see InfoOverlay.UpdateContent. -->
                            <TextBlock x:Name="InfoMeta"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource OverlayMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Font size indicator ───────────────────────────── -->
                <Border Grid.Row="3" Padding="14,4,14,8">
                    <TextBlock x:Name="FontSizeLabel"
                               Text="24 pt"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource OverlayMuted}"
                               HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </Border>

        <!-- Interactive resize thumb.
             Because the window is WindowStyle=None + AllowsTransparency,
             the native window-edge resize handles are inactive. A WPF
             Thumb with a custom DragDelta handler provides the same
             bottom-right resize affordance users expect. The visible
             ResizeGrip above is purely decorative. -->
        <!-- Interactive resize thumb. Larger hit area (28×28) to meet
             WCAG 2.5.5 partially (pure drag handles are exempt from
             the 44 px rule but we still make them reasonably large).
             ToolTip teaches discoverability — many users don't know
             bottom-right grips exist on borderless windows. -->
        <Thumb x:Name="ResizeThumb"
               Width="44" Height="44"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,0,0"
               Cursor="SizeNWSE"
               Background="Transparent"
               ToolTip="Drag to resize this panel"
               AutomationProperties.Name="Resize panel"
               AutomationProperties.HelpText="Drag the bottom-right corner to resize the Info Overlay panel"
               DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <ResizeGrip HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,6,6"
                    IsHitTestVisible="False"
                    Opacity="0.5"/>
    </Grid>
</Window>
