<Window x:Class="BadgeOverlay.CustomRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Custom Button Rules"
        Width="720" Height="600"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBar}" Padding="18,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Rules}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="Custom Button Rules" AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource BrushBlueText}"/></StackPanel>
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Add rules to detect buttons in specialist apps. Match on button text (contains) or Win32 class name (exact). Rules are checked before built-in patterns."/>
            </StackPanel>
        </Border>

        <!-- Rule list -->
        <Border Grid.Row="1" Margin="16,12,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Column headers -->
                <Grid Grid.Row="0" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TYPE"   Style="{StaticResource SectionLabel}" Margin="0"/>
                    <TextBlock Grid.Column="1" Text="MATCH"  Style="{StaticResource SectionLabel}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="LABEL"  Style="{StaticResource SectionLabel}" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="CATEGORY" Style="{StaticResource SectionLabel}" Margin="4,0,0,0" FontSize="{DynamicResource FontSizeCaption}"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="RuleList"
                         AutomationProperties.Name="Custom button rules"
                         AutomationProperties.HelpText="Select a rule to edit it below"
                         SelectionChanged="RuleList_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="2" x:Name="EditorPanel"
                Margin="16,10,16,0" Padding="14,12"
                Background="{DynamicResource BrushSurf}"
                BorderBrush="{DynamicResource BrushSurf2}"
                BorderThickness="1" CornerRadius="8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Match type" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbMatchType" Padding="8,4"
                              AutomationProperties.Name="Match type"
                              SelectionChanged="CmbMatchType_Changed">
                        <ComboBoxItem Content="Button Text" Tag="text"/>
                        <ComboBoxItem Content="Win32 Class" Tag="class"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Match value (contains)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtMatch" Padding="8,4"
                             AutomationProperties.Name="Match value (contains)"
                             ToolTip="Text: substring match on button label. Class: exact Win32 class name."/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Display label" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLabel" Padding="8,4"
                             AutomationProperties.Name="Display label"
                             ToolTip="Label shown in the badge tooltip"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Category" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbCategory" Padding="8,4"
                              AutomationProperties.Name="Category">
                        <ComboBoxItem Content="Action"/>
                        <ComboBoxItem Content="Nav"/>
                        <ComboBoxItem Content="Control"/>
                        <ComboBoxItem Content="Danger"/>
                        <ComboBoxItem Content="Chrome"/>
                        <ComboBoxItem Content="Browser"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource BrushBar}" Padding="16,10,52,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="14,6" MinHeight="44" Margin="0,0,8,0"
                            Click="BtnAdd_Click"
                    AutomationProperties.Name="Add Rule"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.NewTask}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Add Rule" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="BtnSave"
                            Style="{StaticResource FlatButton}"
                            Padding="14,6" MinHeight="44" Margin="0,0,8,0"
                            IsEnabled="False" Click="BtnSave_Click"
                    AutomationProperties.Name="Save"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Save}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Save" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="BtnDelete"
                            Style="{StaticResource DangerButton}"
                            Padding="14,6" MinHeight="44" Margin="0,0,16,0"
                            IsEnabled="False" Click="BtnDelete_Click"
                    AutomationProperties.Name="Delete"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Delete}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button
                            Style="{StaticResource FlatButton}"
                            Padding="12,6" MinHeight="44" Margin="0,0,6,0"
                            ToolTip="Save all rules to a .bo-rules.json file"
                            AutomationProperties.Name="Export rules"
                            Click="BtnExport_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Export}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Export…" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button
                            Style="{StaticResource FlatButton}"
                            Padding="12,6" MinHeight="44"
                            ToolTip="Load rules from a .bo-rules.json file (appends to existing list)"
                            AutomationProperties.Name="Import rules"
                            Click="BtnImport_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Import}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Import…" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <Button Grid.Column="1" Content="Close"
                        Style="{StaticResource FlatButton}"
                        Padding="14,6" MinHeight="44"
                        IsCancel="True"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- WCAG 2.2 AAA grip: 44px, focusable, arrow-key resize, 2px focus ring (suite-canonical) -->
        <sh:AccessibleResizeGrip/>
</Grid></Window>
