<Window x:Class="BadgeOverlay.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:OldGamers.Wpf.Shared.Controls;assembly=OldGamers.Wpf.Shared"
        Title="Hotkeys — Badge Overlay"
        Width="720" Height="640"
        MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header bar -->
            <RowDefinition Height="Auto"/>   <!-- Instruction bar -->
            <RowDefinition Height="*"/>      <!-- Hotkey rows -->
            <RowDefinition Height="Auto"/>   <!-- Fixed shortcuts legend -->
            <RowDefinition Height="Auto"/>   <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- Header bar — BrushBar adapts to Dark (#141414) / Light (#DCDCDC) themes.
             BrushText provides AAA contrast in both (dark on light, light on dark). -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBar}" Padding="20,16">
            <StackPanel>
                <!-- Breadcrumb -->
                <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6">
                    <Run Text="Badge Overlay"/>
                    <Run Text=" › "/>
                    <Run Text="Keyboard Shortcuts" FontWeight="SemiBold"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource JtIcon.Keyboard}" Style="{StaticResource JtHeaderIcon}" Margin="0,0,12,0"/>
                    <TextBlock Text="Keyboard Shortcuts" FontSize="18" AutomationProperties.HeadingLevel="Level1" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Remappable shortcuts are listed below. Click a button to capture a new key combination. Press Escape to unbind."
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Instruction bar -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurf}" Padding="16,10">
            <TextBlock Text="Click any button on the right to begin capturing a new shortcut."
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
        </Border>

        <!-- Hotkey rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="HotkeyRowsPanel" Margin="0"/>
        </ScrollViewer>

        <!-- Fixed shortcuts legend — tray entries only; preset shortcuts are now
             remappable and appear in the scrollable hotkey rows above. -->
        <Border Grid.Row="3" Background="{DynamicResource BrushSurf}" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Fixed shortcuts  (always active, not remappable)" AutomationProperties.HeadingLevel="Level2"
                           FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushMuted}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="Tray icon" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Width="110"/>
                    <TextBlock Text="Show / hide panel" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="Tray → Exit" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Width="110"/>
                    <TextBlock Text="Quit application" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource BrushBar}" Padding="16,10,52,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource FlatButton}"
                        Padding="14,7" MinHeight="44" Click="BtnResetAll_Click"
                    AutomationProperties.Name="Reset All to Defaults"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset All to Defaults" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource FlatButton}"
                        Padding="14,7" MinHeight="44" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Grid.Column="3" Content="Apply" Style="{StaticResource PrimaryButton}"
                        Padding="18,7" MinHeight="44" Click="BtnApply_Click"/>
            </Grid>
        </Border>

        <!-- WCAG 2.2 AAA grip: 44px, focusable, arrow-key resize, 2px focus ring (suite-canonical) -->
        <sh:AccessibleResizeGrip/>
    </Grid>
</Window>
