<Window x:Class="BadgeOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Badge Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        Focusable="False">

    <Canvas x:Name="RootCanvas" Background="Transparent">

        <!-- ══ Button badge — only element on the overlay ═══════════════════
             Accessibility note: the badge is a screen-reader "live region"
             announcing the control currently under the cursor. LiveSetting
             is Polite rather than Assertive so rapid cursor movement does
             not overwhelm the user with announcements. Name is refreshed
             by OverlayWindow.ApplyBadgeContent on every label change. -->
        <Border x:Name="BadgeBorder"
                Background="{DynamicResource OverlayBg}"
                Visibility="Collapsed"
                CornerRadius="10"
                BorderThickness="2"
                Padding="12,8,14,8"
                MinWidth="130"
                MaxWidth="300"
                IsHitTestVisible="False"
                AutomationProperties.IsOffscreenBehavior="Onscreen"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Badge Overlay"
                AutomationProperties.HelpText="Announces the name of the button or control currently under the cursor">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="22"
                                  ShadowDepth="4" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Coloured icon pill -->
                <Border x:Name="IconPill"
                        Grid.Column="0"
                        CornerRadius="7"
                        Padding="6,3"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush x:Name="IconPillBg" Color="#33FFFFFF"/>
                    </Border.Background>
                    <TextBlock x:Name="BadgeIcon"
                               FontSize="15"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="◉"/>
                </Border>

                <!-- Label + category stack -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeLabel"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource BadgeFontBase}"
                               Foreground="{DynamicResource OverlayText}"
                               TextTrimming="CharacterEllipsis"
                               Text="Button"/>
                    <!-- BO-03: was 10px @ 60% white (≈6.5:1). Now 12px, full opacity, ≥7:1 token. -->
                    <TextBlock x:Name="BadgeCategory"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource OverlayMuted}"
                               Text="Control"/>
                </StackPanel>
            </Grid>
        </Border>

    </Canvas>
</Window>
