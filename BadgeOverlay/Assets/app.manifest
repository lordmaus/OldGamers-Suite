<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BadgeOverlay.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          uiAccess="false" — standard setting for unsigned builds.
          The overlay uses HWND_TOPMOST and WinEvent hooks to stay on top of
          normal application windows. Start Menu / Shell chrome windows use a
          higher Z-band that requires uiAccess=true + code signing to overlay.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <!-- DPI awareness is now declared via the <ApplicationHighDpiMode> csproj
       property (PerMonitorV2). WPF on .NET 10 with WinForms interop reads
       that property and sets the process DPI mode at startup, which avoids
       a WFO0003 build warning when the manifest also declares dpiAware /
       dpiAwareness elements. Single source of truth — keep it in csproj. -->
</assembly>
