<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 6 (2026-10-12): regression tests for Skills Review fixes.
       Kept OUTSIDE TimerStudio\ so the app's default **/*.cs glob never picks these up.
       Run:  dotnet test TimerStudio.Tests\TimerStudio.Tests.csproj  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- the app is a self-contained WinExe; allow referencing it from the test host -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimerStudio\TimerStudio.csproj" />
  </ItemGroup>

</Project>
