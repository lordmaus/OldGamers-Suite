<Project Sdk="Microsoft.NET.Sdk">

  <!-- 2026-10-12: regression tests for BadgeOverlay Skills Review fixes.
       Kept OUTSIDE BadgeOverlay\ so the app's **/*.cs glob never picks these up.
       Run:  dotnet test BadgeOverlay.Tests\BadgeOverlay.Tests.csproj  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- don't bump the app's version.txt when the test project builds it -->
    <SkipBumpBuildCounter>true</SkipBumpBuildCounter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BadgeOverlay\BadgeOverlay.csproj" />
  </ItemGroup>

</Project>
