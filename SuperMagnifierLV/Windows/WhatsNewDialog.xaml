<Window x:Class="SuperMagnifier.WhatsNewDialog"
        ResizeMode="CanResizeWithGrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New — Super Magnifier LV"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False">

  <StackPanel Margin="28,24,28,24">

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource JtIcon.GettingStarted}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="What's New" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
               Foreground="{DynamicResource BrushBlueText}"/></StackPanel>
    <TextBlock x:Name="VersionLabel" FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Center"
               Margin="0,2,0,0"/>

    <Separator Margin="0,14,0,14"/>

    <!-- Changelog entries -->
    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="2026.10.13 — Hotkeys, data fixes &amp; accessibility" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <StackPanel Margin="12,0,0,10">
          <TextBlock Text="• Hotkeys now use Ctrl+Alt (Ctrl+Alt+M on/off, Ctrl+Alt+F freeze, Ctrl+Alt+= / - zoom …) so Ctrl+F, Ctrl+T, Ctrl+P, Ctrl+L, Ctrl+R and Ctrl+1–5 work in your other apps again. Custom shortcuts you set are kept."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Ctrl+Shift+Arrow resizes the lens only while Super Magnifier is the active window — text selection works everywhere again. A global resize key can be set in Hotkeys."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Preset and colour-cycle hotkeys can now be remapped."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Presets and per-app lens positions save correctly on every language setting (was losing decimals on e.g. German Windows); damaged files are repaired."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Status messages: choose 5 s, 10 s or until dismissed in Settings; they pause while hovered, Esc dismisses, and the tray menu has Recent messages."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Crash log: About → Open crash log folder."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Larger text throughout (minimum 12 px) and 44 px controls; theme colours meet 7:1 contrast."
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
        </StackPanel>


        <TextBlock Text="2026.3.16 — Layout, Compliance &amp; Smart Defaults" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <StackPanel Margin="12,0,0,10">
          <TextBlock Text="• Two-column control panel — Magnification and Quick Toggles side-by-side"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens title bar drag fixed — was broken due to WS_EX_NOACTIVATE interaction"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Voice title-bar buttons fixed — TTS now initialises independently of Zoom TTS setting"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Voice now announces Windows Explorer, UWP, and browser tab buttons via UI Automation"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Startup Defaults — set Follow Mode, Snap-to-Word, Reticle, and Voice as default startup state in Settings"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens toolbar — Tab key now cycles through all toolbar buttons (WCAG 2.1.1)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Escape closes About, App Preset, Input, and First-Run Wizard dialogs (WCAG 2.1.2)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• All buttons meet 44×44px minimum touch target (WCAG 2.5.5)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Disabled controls use BrushDisabled colour token instead of opacity collapse (WCAG 1.4.3)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Animations respect Windows Reduce Motion preference (WCAG 2.3.3)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Status toasts can be clicked to dismiss (WCAG 2.2.1); auto-extended on reduced-motion systems"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Colour swatches are now proper Buttons — keyboard-accessible and announced by screen readers"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Bug fix — Settings not saved on first launch; tour and What's New no longer repeat"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens title bar size cycles all 5 sizes correctly; separator lines scale with bar height"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
        </StackPanel>

        <TextBlock Text="Session 45 — Compliance &amp; Features" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,4,0,6"/>
        <StackPanel Margin="12,0,0,10">
          <TextBlock Text="• WCAG 1.4.3 — BrushRed in Light theme now passes contrast ratio (4.98:1)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• WCAG 2.1.1 — Zoom slider arrow-key step now matches your chosen zoom step"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• WCAG 2.4.7 — Slider focus ring: real visible adorner replaces invisible BorderBrush trigger"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• WCAG 2.4.11 — Focus ring colour adapts automatically when you switch Dark ↔ Light theme"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Bug fix — Colour picker now samples correct pixel on high-DPI secondary monitors"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Bug fix — Colour pick failure (clipboard locked) now shows an error toast"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Colour history palette — last 10 picked colours shown as swatches in colour pick mode"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Sleep/hibernate resume — magnifier engine auto-reinitialises after system wake"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• About dialog — 📋 Copy Path button copies settings file location to clipboard"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Ctrl+Shift+C hotkey cycles through all colour modes (Normal → Greyscale → Invert → …)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Settings dialog — ↺ Reset to Defaults button restores factory settings with confirmation"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens title bar right-click context menu — Freeze, Colour Picker, Snapshot, Click-Through, Close"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Control panel screen position is now remembered between sessions"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• WCAG 1.3.1 — Tooltips now visible on disabled buttons and controls"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
        </StackPanel>

        <TextBlock Text="Session 44" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,4,0,6"/>
        <StackPanel Margin="12,0,0,10">
          <TextBlock Text="• Wider, shorter Settings dialog — two-column layout"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Live zoom shown in lens title bar (e.g. 🔍 2.5×)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Colour picker shows hex + RGB in a toast after picking"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Tray menu now includes quick-load for named presets"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Preset load hotkeys (Ctrl+1–5, Ctrl+Shift+1–5) now shown in Hotkey Remap dialog"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens restored off-screen after monitor disconnect is now clamped into view"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Settings dialog zoom field now accepts locale decimal separator (, or .)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• WordTracker.TryGetWordFocus() runs on background thread with 200ms timeout"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• About dialog now has a keyboard shortcut (F1) and links to readme"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Silent catch{} blocks now log to Debug output in debug builds"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• README fully updated with all features from sessions 1–44"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
        </StackPanel>

        <TextBlock Text="Session 43" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,4,0,6"/>
        <StackPanel Margin="12,0,0,10">
          <TextBlock Text="• Single-instance mutex — second launch shows a friendly message"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Hotkey conflict detection — toast names each failing hotkey"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Windows shutdown now saves settings (logoff / restart safe)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Status toasts announced to screen readers (WCAG 4.1.3)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• PNG snapshots (lossless) replacing JPEG"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Lens toolbar keyboard accessible via Alt+H (WCAG 2.1.1)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Inline field validation in Settings dialog (WCAG 3.3.1)"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Hotkey conflict in Remap dialog now blocks Save button"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
          <TextBlock Text="• Dynamic version read from assembly at runtime"
                     FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushText}" TextWrapping="Wrap" Margin="0,2"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Separator Margin="0,14,0,14"/>

    <Button Content="Got it!" Style="{DynamicResource PrimaryButton}"
            HorizontalAlignment="Center" Padding="40,8" IsDefault="True"
            Click="GotItBtn_Click"/>


  </StackPanel>
</Window>
