<Window x:Class="SuperMagnifier.SettingsDialog"
        ResizeMode="CanResizeWithGrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Magnifier LV — Settings"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        Width="540" Height="720"
        MinWidth="460" MinHeight="420"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BrushBg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Settings"
        AutomationProperties.HelpText="Configure default startup values for Super Magnifier LV">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
    <StackPanel Margin="0,0,0,16">

    <!-- Header -->
    <StackPanel Orientation="Horizontal" Margin="20,14,20,1"><Image Source="{StaticResource JtIcon.Settings}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="Settings" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold"
               Foreground="{DynamicResource BrushText}"/></StackPanel>
    <TextBlock x:Name="FilePathLabel" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
               Foreground="{DynamicResource BrushMuted}" Margin="20,0,20,8"/>

    <Separator/>

    <!-- ROW 1: Lens Size (left) + Zoom + Zoom Step (right) -->
    <Grid Margin="16,8,16,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Lens Size -->
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock x:Name="HeadLensSize" Text="Lens Size"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" Margin="0,3"/>
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LensWBox" Text="520"
                     Width="72" MinHeight="44" FontSize="{DynamicResource FontSizeBody}" Padding="4,2"
                     HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                     Margin="0,3" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Lens width in pixels"
                     ToolTip="Lens width (200–3840 px)"
                     TextChanged="LensWBox_TextChanged" InputScope="Number"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="px"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center" Margin="4,3"/>
          <TextBlock x:Name="LensWError" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                     Text="✗ 200–3840 px" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushRedText}"
                     Margin="0,-1,0,2" Visibility="Collapsed"
                     AutomationProperties.Name="Lens width validation error: value must be 200 to 3840 pixels"
                     AutomationProperties.LiveSetting="Assertive"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Height:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" Margin="0,3"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="LensHBox" Text="360"
                     Width="72" MinHeight="44" FontSize="{DynamicResource FontSizeBody}" Padding="4,2"
                     HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                     Margin="0,3" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Lens height in pixels"
                     ToolTip="Lens height (150–2160 px)"
                     TextChanged="LensHBox_TextChanged" InputScope="Number"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="px"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center" Margin="4,3"/>
          <TextBlock x:Name="LensHError" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                     Text="✗ 150–2160 px" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushRedText}"
                     Margin="0,-1,0,2" Visibility="Collapsed"
                     AutomationProperties.Name="Lens height validation error: value must be 150 to 2160 pixels"
                     AutomationProperties.LiveSetting="Assertive"/>

          <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                  x:Name="SnapSizeBtn" Content="← Use current"
                  HorizontalAlignment="Left" Style="{DynamicResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" Margin="0,4,0,0"
                  AutomationProperties.Name="Use current lens size"
                  Click="SnapSizeBtn_Click"/>
        </Grid>
      </StackPanel>

      <!-- Divider -->
      <Rectangle Grid.Column="1" Fill="{DynamicResource BrushSurf}" Width="1" VerticalAlignment="Stretch"/>

      <!-- Right: Zoom + Zoom Step -->
      <StackPanel Grid.Column="2" Margin="16,0,0,0">
        <TextBlock x:Name="HeadZoom" Text="Zoom"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Zoom:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" Margin="0,3"/>
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ZoomBox" Text="2.00"
                     Width="72" MinHeight="44" FontSize="{DynamicResource FontSizeBody}" Padding="4,2"
                     HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                     Margin="0,3" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Default zoom level"
                     ToolTip="Starting zoom (1.25–20×)"
                     TextChanged="ZoomBox_TextChanged" InputScope="Number"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="×"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center" Margin="4,3"/>
          <TextBlock x:Name="ZoomError" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                     Text="✗ 1.25–20× required" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushRedText}"
                     Margin="0,-1,0,2" Visibility="Collapsed"
                     AutomationProperties.Name="Zoom validation error: value must be between 1.25 and 20"
                     AutomationProperties.LiveSetting="Assertive"/>
          <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                  x:Name="SnapZoomBtn" Content="← Use current"
                  HorizontalAlignment="Left" Style="{DynamicResource FlatButton}"
                  FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" Margin="0,4,0,0"
                  AutomationProperties.Name="Use current zoom level"
                  Click="SnapZoomBtn_Click"/>
        </Grid>

        <TextBlock x:Name="HeadZoomStep" Text="Zoom Step"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,12,0,4"/>
        <WrapPanel>
          <RadioButton x:Name="Step01"  Content="0.1×"  GroupName="DlgStep" Margin="0,0,10,0"
                       AutomationProperties.Name="Zoom step 0.1 times"/>
          <RadioButton x:Name="Step025" Content="0.25×" GroupName="DlgStep" IsChecked="True" Margin="0,0,10,0"
                       AutomationProperties.Name="Zoom step 0.25 times"/>
          <RadioButton x:Name="Step05"  Content="0.5×"  GroupName="DlgStep" Margin="0,0,10,0"
                       AutomationProperties.Name="Zoom step 0.5 times"/>
          <RadioButton x:Name="Step1"   Content="1×"    GroupName="DlgStep" Margin="0,0,10,0"
                       AutomationProperties.Name="Zoom step 1 times"/>
          <RadioButton x:Name="Step2"   Content="2×"    GroupName="DlgStep"
                       AutomationProperties.Name="Zoom step 2 times"/>
        </WrapPanel>
      </StackPanel>
    </Grid>

    <Separator/>

    <!-- ROW 2: Rendering + Lens Appearance -->
    <Grid Margin="16,8,16,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Rendering Quality -->
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock x:Name="HeadRendering" Text="Rendering Quality"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <RadioButton x:Name="SmoothRadio" GroupName="Render" IsChecked="True" Margin="0,2"
                     AutomationProperties.Name="Smooth bilinear rendering">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Smooth (bilinear)" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                       Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="  — text &amp; UI" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="CrispRadio" GroupName="Render" Margin="0,4"
                     AutomationProperties.Name="Crisp nearest-pixel rendering">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Crisp (nearest)" FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                       Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="  — pixel art" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>

      <Rectangle Grid.Column="1" Fill="{DynamicResource BrushSurf}" Width="1" VerticalAlignment="Stretch"/>

      <!-- Right: Lens Appearance -->
      <StackPanel Grid.Column="2" Margin="16,0,0,0">
        <TextBlock x:Name="HeadLensAppearance" Text="Lens Appearance"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="44"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Opacity:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
          <Slider    Grid.Row="0" Grid.Column="1" x:Name="OpacitySlider"
                     Minimum="0.2" Maximum="1.0" Value="1.0"
                     IsSnapToTickEnabled="False" VerticalAlignment="Center"
                     AutomationProperties.Name="Lens opacity"
                     ToolTip="Lens opacity (20%–100%)"/>
          <TextBlock Grid.Row="0" Grid.Column="2" x:Name="OpacityLabel"
                     Text="100%" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" TextAlignment="Right"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Theme:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
          <ComboBox  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                     x:Name="ThemeCombo" FontSize="{DynamicResource FontSizeCaption}" MinHeight="44"
                     AutomationProperties.Name="Select UI theme"
                     ToolTip="Choose colour theme"
                     SelectionChanged="ThemeCombo_SelectionChanged">
            <!-- ── Dark themes ────────────────────────────────── -->
            <ComboBoxItem Content="Dark"              Tag="Dark"/>
            <ComboBoxItem Content="One Dark"          Tag="OneDark"/>
            <ComboBoxItem Content="Gruvbox Dark"      Tag="GruvboxDark"/>
            <ComboBoxItem Content="Tokyo Night"       Tag="TokyoNight"/>
            <ComboBoxItem Content="Nord"              Tag="Nord"/>
            <ComboBoxItem Content="Dracula"           Tag="Dracula"/>
            <ComboBoxItem Content="Mocha (Catppuccin)" Tag="Mocha"/>
            <ComboBoxItem Content="Rosé Pine"         Tag="RosePine"/>
            <ComboBoxItem Content="Ayu Dark"          Tag="AyuDark"/>
            <ComboBoxItem Content="Ayu Mirage"        Tag="AyuMirage"/>
            <ComboBoxItem Content="Cobalt 2"          Tag="Cobalt2"/>
            <ComboBoxItem Content="Monokai"           Tag="Monokai"/>
            <ComboBoxItem Content="Solarized Dark"    Tag="SolarizedDark"/>
            <!-- ── Light themes ───────────────────────────────── -->
            <ComboBoxItem Content="Light"             Tag="Light"/>
            <ComboBoxItem Content="Warm Light"        Tag="WarmLight"/>
            <ComboBoxItem Content="Catppuccin Latte"  Tag="CatppuccinLatte"/>
            <ComboBoxItem Content="GitHub Light"      Tag="GitHubLight"/>
            <ComboBoxItem Content="Ayu Light"         Tag="AyuLight"/>
            <ComboBoxItem Content="Solarized Light"   Tag="SolarizedLight"/>
          </ComboBox>
        </Grid>
      </StackPanel>
    </Grid>

    <Separator/>

    <!-- ROW 3: Behaviour (left 2-col grid) + Smooth Panning + Dim When Idle (right) -->
    <Grid Margin="16,8,16,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Behaviour in 2-column grid -->
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock x:Name="HeadBehaviour" Text="Behaviour"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <CheckBox x:Name="AotCheck" Grid.Row="0" Grid.Column="0"
                    Content="Always on Top" IsChecked="True" Margin="0,3"
                    AutomationProperties.Name="Always on Top"
                    ToolTip="Keep the magnifier window above all other windows"/>
          <CheckBox x:Name="HotkeyCheck" Grid.Row="0" Grid.Column="2"
                    Content="Global Hotkeys" IsChecked="True" Margin="0,3"
                    AutomationProperties.Name="Global hotkeys enabled"
                    ToolTip="Allow keyboard shortcuts to work from any application"/>
          <CheckBox x:Name="AutoStartCheck" Grid.Row="1" Grid.Column="0"
                    Content="Start with Windows" IsChecked="False" Margin="0,3"
                    AutomationProperties.Name="Start with Windows"
                    ToolTip="Launch automatically when Windows starts"/>
          <CheckBox x:Name="InvertScrollCheck" Grid.Row="1" Grid.Column="2"
                    Content="Invert Scroll" IsChecked="False" Margin="0,3"
                    AutomationProperties.Name="Invert scroll wheel zoom direction"
                    ToolTip="Reverse scroll-wheel: scroll down = zoom in"/>
          <CheckBox x:Name="SessionRestoreCheck" Grid.Row="2" Grid.Column="0"
                    Content="Resume session" IsChecked="True" Margin="0,3"
                    AutomationProperties.Name="Resume last session on startup"
                    ToolTip="Restore zoom and lens position from the previous session"/>
          <CheckBox x:Name="ZoomAnimateCheck" Grid.Row="3" Grid.Column="0"
                    Content="Smooth zoom" IsChecked="True" Margin="0,3"
                    AutomationProperties.Name="Smooth zoom animation"
                    ToolTip="Animate zoom changes with a smooth ease-in-out curve"/>
          <CheckBox x:Name="OpacityFollowZoomCheck" Grid.Row="3" Grid.Column="2"
                    Content="Opacity → zoom" IsChecked="False" Margin="0,3"
                    AutomationProperties.Name="Opacity fades with lower zoom"
                    ToolTip="Gradually reduce lens opacity as zoom level decreases"/>
        </Grid>
      </StackPanel>

      <Rectangle Grid.Column="1" Fill="{DynamicResource BrushSurf}" Width="1" VerticalAlignment="Stretch"/>

      <!-- Right: Smooth Panning + Dim When Idle -->
      <StackPanel Grid.Column="2" Margin="16,0,0,0">
        <TextBlock x:Name="HeadSmoothPanning" Text="Smooth Panning"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,4"/>
        <CheckBox x:Name="SmoothPanCheck" Content="Enable smooth follow"
                  IsChecked="False" Margin="0,0,0,4"
                  AutomationProperties.Name="Enable smooth panning"
                  ToolTip="Lens glides to follow cursor instead of jumping instantly"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="52"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Lag:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
          <Slider    Grid.Column="1" x:Name="PanLagSlider"
                     Minimum="0.03" Maximum="0.45" Value="0.15"
                     IsSnapToTickEnabled="False" VerticalAlignment="Center"
                     AutomationProperties.Name="Smooth panning lag"
                     ToolTip="Lower = tighter follow   Higher = looser follow"/>
          <TextBlock Grid.Column="2" x:Name="PanLagLabel"
                     Text="Medium" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>

        <TextBlock x:Name="HeadDimWhenIdle" Text="Dim When Idle"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}" Margin="0,14,0,4"/>
        <CheckBox x:Name="DimWhenIdleCheck" Content="Dim lens when cursor is still"
                  IsChecked="False" Margin="0,0,0,4"
                  AutomationProperties.Name="Dim lens when cursor is still"
                  ToolTip="Fades lens out when cursor stops — restores instantly on movement"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="34"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Delay (sec):"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
          <Slider    Grid.Row="0" Grid.Column="1" x:Name="DimDelaySlider"
                     Minimum="2" Maximum="30" Value="5"
                     SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                     AutomationProperties.Name="Dim delay in seconds"
                     ToolTip="Seconds of cursor stillness before dimming (2–30s)"/>
          <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DimDelayLabel"
                     Text="5s" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" TextAlignment="Right"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Dim opacity:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
          <Slider    Grid.Row="2" Grid.Column="1" x:Name="DimOpacitySlider"
                     Minimum="0.05" Maximum="0.9" Value="0.15"
                     IsSnapToTickEnabled="False" VerticalAlignment="Center"
                     AutomationProperties.Name="Dim target opacity"
                     ToolTip="Target opacity when dimmed (5%–90%)"/>
          <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DimOpacityLabel"
                     Text="15%" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
      </StackPanel>
    </Grid>

    <Separator/>

    <!-- ROW 4: Startup Defaults -->
    <StackPanel Margin="16,8,16,4">
      <TextBlock x:Name="HeadStartupDefaults" Text="Startup Defaults"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"
                 ToolTip="These settings are applied every time the app launches"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Follow Mode default -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,3">
          <TextBlock Text="Follow mode on start:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,3"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="DefaultFollowMouseRadio" Content="Mouse"
                         GroupName="DefaultFollow" IsChecked="True"
                         Margin="0,0,12,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Default follow mouse cursor"
                         AutomationProperties.HelpText="Start in Follow Mouse Cursor mode on every launch"
                         ToolTip="Start in Follow Mouse Cursor mode"/>
            <RadioButton x:Name="DefaultFollowCaretRadio" Content="Caret"
                         GroupName="DefaultFollow"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Default follow text caret"
                         AutomationProperties.HelpText="Start in Follow Text Caret mode on every launch"
                         ToolTip="Start in Follow Text Caret mode"/>
          </StackPanel>
        </StackPanel>

        <!-- Snap-to-Word default -->
        <CheckBox x:Name="DefaultSnapToWordCheck" Grid.Row="1" Grid.Column="0"
                  Content="Snap-to-Word on start" IsChecked="False" Margin="0,6,0,3"
                  AutomationProperties.Name="Snap to word enabled on startup"
                  AutomationProperties.HelpText="Enable Snap-to-Word automatically on each launch — centres the lens on the nearest word under the cursor"
                  ToolTip="Enable Snap-to-Word automatically on each launch"/>

        <!-- Reticle default -->
        <CheckBox x:Name="DefaultReticleCheck" Grid.Row="0" Grid.Column="2"
                  Content="Show reticle on start" IsChecked="False" Margin="0,3"
                  AutomationProperties.Name="Show reticle in lens on startup"
                  AutomationProperties.HelpText="Show the reticle overlay in the lens automatically on each launch"
                  ToolTip="Show the reticle overlay in the lens automatically on each launch"/>

        <!-- UI Size default -->
        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,3">
          <TextBlock Text="UI size on start:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,3"/>
          <ComboBox x:Name="DefaultUiSizeCombo" FontSize="{DynamicResource FontSizeCaption}"
                    AutomationProperties.Name="Default UI size on startup"
                    AutomationProperties.HelpText="Choose the control panel size to use on each launch. Remember Last uses whichever size was active when the app closed."
                    ToolTip="Control panel size applied on each launch">
            <ComboBoxItem Content="Remember last"/>
            <ComboBoxItem Content="Small"/>
            <ComboBoxItem Content="Normal"/>
            <ComboBoxItem Content="Large"/>
            <ComboBoxItem Content="Extra Large"/>
          </ComboBox>
        </StackPanel>

        <!-- Lens title bar size default -->
        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,3">
          <TextBlock Text="Lens title bar on start:"
                     FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource BrushHint}" Margin="0,0,0,3"/>
          <ComboBox x:Name="DefaultTitleBarSizeCombo" FontSize="{DynamicResource FontSizeCaption}"
                    AutomationProperties.Name="Default lens title bar size on startup"
                    AutomationProperties.HelpText="Choose the lens title bar size that is always applied on launch."
                    ToolTip="Lens title bar size applied on every launch">
            <ComboBoxItem Content="Normal (26px)"/>
            <ComboBoxItem Content="Large (36px)"/>
            <ComboBoxItem Content="X-Large (48px)"/>
            <ComboBoxItem Content="XX-Large (64px)"/>
            <ComboBoxItem Content="XXX-Large (80px)"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Separator/>

    <!-- ROW 4b: Lens bar text visibility -->
    <StackPanel Margin="16,8,16,4">
      <TextBlock x:Name="HeadBarText" Text="Lens Top Bar Text"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"
                 ToolTip="Show or hide individual text labels on the lens top bar"/>

      <CheckBox x:Name="BarHideAllTextCheck" Content="Hide all bar text"
                Margin="0,3,0,6"
                AutomationProperties.Name="Hide all lens bar text"
                AutomationProperties.HelpText="Master switch — hides every text label on the lens top bar at once. The Close button and icon-only buttons (dock arrows) are never affected. Individual toggles below still apply if this is off."
                ToolTip="Hide every text label on the lens top bar (icons and Close button stay)"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>

        <CheckBox x:Name="BarShowSizeLabelCheck" Grid.Row="0" Grid.Column="0"
                  Content="Title-size button (&quot;Aa&quot;)" Margin="0,3"
                  AutomationProperties.Name="Show title-size button label"
                  ToolTip="Show the 'Aa' text on the title bar size button"/>
        <CheckBox x:Name="BarShowColourLabelCheck" Grid.Row="0" Grid.Column="1"
                  Content="Colour picker (&quot;Clr&quot;)" Margin="0,3"
                  AutomationProperties.Name="Show colour picker button label"
                  ToolTip="Show the 'Clr' text on the colour picker button"/>
        <CheckBox x:Name="BarShowSnapLabelCheck" Grid.Row="1" Grid.Column="0"
                  Content="Snapshot (&quot;Snap&quot;)" Margin="0,3"
                  AutomationProperties.Name="Show snapshot button label"
                  ToolTip="Show the 'Snap' text on the save-snapshot button"/>
        <CheckBox x:Name="BarShowClickThruLabelCheck" Grid.Row="1" Grid.Column="1"
                  Content="Click-through (&quot;Thru&quot;)" Margin="0,3"
                  AutomationProperties.Name="Show click-through button label"
                  ToolTip="Show the 'Thru' text on the click-through button"/>
        <CheckBox x:Name="BarShowFreezeLabelCheck" Grid.Row="2" Grid.Column="0"
                  Content="Freeze / Resume word" Margin="0,3"
                  AutomationProperties.Name="Show freeze button word"
                  ToolTip="Show the 'Freeze'/'Resume' word next to the icon (icon always shows)"/>
        <CheckBox x:Name="BarShowZoomValueCheck" Grid.Row="2" Grid.Column="1"
                  Content="Zoom value (e.g. 2.00x)" Margin="0,3"
                  AutomationProperties.Name="Show zoom value label"
                  ToolTip="Show the current zoom level readout"/>
        <CheckBox x:Name="BarShowHoverHintCheck" Grid.Row="3" Grid.Column="0"
                  Content="Hover hint text" Margin="0,3"
                  AutomationProperties.Name="Show hover hint label"
                  ToolTip="Show the inline hint text that appears when hovering a bar button"/>
      </Grid>
    </StackPanel>

    <Separator/>

    <!-- ROW 5: Display & Fonts (Low-Vision: app-wide font family + explicit HUD size) -->
    <StackPanel Margin="16,8,16,4">
      <TextBlock x:Name="HeadDisplayFonts" Text="Display &amp; Fonts"
                 FontFamily="{DynamicResource AppFontFamily}" FontSize="12" FontWeight="Bold"
                 Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"
                 AutomationProperties.HeadingLevel="Level2"
                 ToolTip="App-wide font family and explicit HUD font size (Low-Vision controls)"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status message duration (WCAG 2.2.3) -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Message duration:"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                   x:Name="CboToastDuration" MinHeight="44"
                   AutomationProperties.Name="Status message duration"
                   AutomationProperties.HelpText="How long status messages stay on screen. Until dismissed keeps them until you press Escape or the dismiss button."
                   ToolTip="How long status messages stay on screen">
          <ComboBoxItem Content="At least 5 seconds" Tag="5"/>
          <ComboBoxItem Content="At least 10 seconds" Tag="10"/>
          <ComboBoxItem Content="Until dismissed" Tag="0"/>
        </ComboBox>

        <!-- App font family -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="App font family:"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                   x:Name="CboAppFontFamily" MinHeight="44"
                   AutomationProperties.Name="App font family"
                   AutomationProperties.HelpText="Choose the font family used across the entire app — curated low-vision fonts appear first, followed by all installed system fonts."
                   ToolTip="Pick the app-wide font family. Hyperlegible / OpenDyslexic are great for low-vision reading."
                   SelectionChanged="CboAppFontFamily_SelectionChanged"/>

        <!-- HUD font size -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="HUD font size:"
                   FontFamily="{DynamicResource AppFontFamily}" FontSize="12"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center"/>
        <Slider    Grid.Row="2" Grid.Column="1" x:Name="SldHudFontSize"
                   Minimum="8" Maximum="72" Value="12"
                   TickFrequency="2" IsSnapToTickEnabled="True"
                   SmallChange="1" LargeChange="4"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="HUD font size in pixels"
                   AutomationProperties.HelpText="Range 8 to 72 px. Independent of UI Scale."
                   ToolTip="HUD label size in pixels (8–72). Independent of UI Scale."/>
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="HudFontSizeLabel"
                   Text="12 px" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushText}"
                   VerticalAlignment="Center" TextAlignment="Right"/>
      </Grid>
    </StackPanel>

    </StackPanel>
    </ScrollViewer>

    <!-- Footer — pinned below the scroll area, always visible -->
    <StackPanel Grid.Row="1">
      <Separator/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,4">
        <Image Source="{StaticResource JtIcon.Warning}" Style="{StaticResource JtInlineIcon}" x:Name="StatusIcon" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusLabel" Text="" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource BrushGreenText}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="20,4,20,16">
        <Button x:Name="SaveBtn"
                IsDefault="True"
                Style="{DynamicResource PrimaryButton}"
                AutomationProperties.Name="Save settings"
                AutomationProperties.HelpText="Save all settings and close this dialog. Keyboard shortcut: Enter"
                Click="SaveBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Save}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Save Settings" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Content="Cancel" Margin="10,0,0,0"
                IsCancel="True"
                Style="{DynamicResource FlatButton}"
                AutomationProperties.Name="Cancel"
                AutomationProperties.HelpText="Discard changes and close this dialog. Keyboard shortcut: Escape"
                Click="CancelBtn_Click"/>
        <Button Margin="10,0,0,0"
                Style="{DynamicResource FlatButton}"
                ToolTip="Reset all settings to factory defaults (requires confirmation)"
                AutomationProperties.Name="Reset all settings to factory defaults"
                Click="ResetDefaultsBtn_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Reset to Defaults" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel>
    </StackPanel>

    <!-- Triangular resize handle — bottom-right of whole window -->
    <Path Grid.RowSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="0,0,2,2" IsHitTestVisible="False"
          Fill="{DynamicResource BrushMuted}" Opacity="0.4">
      <Path.Data>
        <PathGeometry>
          <PathFigure StartPoint="0,16" IsClosed="true">
            <LineSegment Point="16,16"/>
            <LineSegment Point="16,0"/>
          </PathFigure>
        </PathGeometry>
      </Path.Data>
    </Path>
  </Grid>
</Window>
