<Window x:Class="SuperMagnifier.HotkeyRemapDialog"
        ResizeMode="CanResize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SuperMagnifier.Controls"
        xmlns:local="clr-namespace:SuperMagnifier"
        Title="Hotkeys — Super Magnifier LV"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <local:InverseBoolConverter x:Key="InverseBool"/>
    <!-- Capture button style — highlights when actively listening -->
    <Style x:Key="CaptureBtn" TargetType="Button">
      <Setter Property="Background"       Value="{DynamicResource BrushSurf}"/>
      <Setter Property="Foreground"       Value="{DynamicResource BrushText}"/>
      <Setter Property="BorderBrush"      Value="{DynamicResource BrushSurf2}"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="FontFamily"       Value="Segoe UI"/>
      <Setter Property="FontSize"         Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Padding"          Value="10,5"/>
      <Setter Property="MinWidth"         Value="120"/>
      <Setter Property="MinHeight"        Value="44"/>
      <Setter Property="Cursor"           Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBlue}"/>
                <Setter Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Listening state — blue pulsing border -->
    <Style x:Key="CaptureBtnListening" TargetType="Button" BasedOn="{StaticResource CaptureBtn}">
      <Setter Property="Background"      Value="{DynamicResource BrushBlue}"/>
      <Setter Property="Foreground"      Value="{DynamicResource BrushOnAccent}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BrushBlue}"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="0,0,0,12">

    <!-- Header bar — BrushBar + BrushText for theme-safe contrast. -->
    <Border Background="{DynamicResource BrushBar}" Padding="16,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Keyboard}" Style="{StaticResource JtHeaderIcon}"/><TextBlock Text="Keyboard Shortcuts" VerticalAlignment="Center"
                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/></StackPanel>
        <TextBlock Text="These shortcuts work in any app. Click a button to capture a new key combination. Press Escape to unbind."
                   FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Instruction bar -->
    <Border x:Name="StatusBar" Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,0,0,1"
            Padding="16,7">
      <DockPanel>
      <Image Source="{StaticResource JtIcon.Warning}" Style="{StaticResource JtInlineIcon}" x:Name="StatusIcon" DockPanel.Dock="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusLabel"
                 Text="Click any button on the right to begin capturing a new shortcut."
                 FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}"
                 TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <!-- Hotkey rows — populated in code-behind -->
    <!-- 30+ rows at 44px → scroll instead of growing past the screen (SizeToContent=Height). -->
    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <ItemsControl x:Name="HotkeyList" Margin="0,4,0,0" KeyboardNavigation.TabNavigation="Continue">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="16,3,16,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <!-- Action label — muted if fixed -->
            <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Capture button — disabled for fixed rows -->
            <Button Grid.Column="2"
                    x:Name="CaptureButton"
                    Content="{Binding DisplayText}"
                    Tag="{Binding ActionKey}"
                    IsEnabled="{Binding IsFixed, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource CaptureBtn}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    Click="CaptureBtn_Click"/>
            <!-- Clear / unbind button — disabled for fixed rows -->
            <Button Grid.Column="4"
                    Tag="{Binding ActionKey}"
                    IsEnabled="{Binding IsFixed, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource CaptureBtn}"
                    Padding="4,5" MinWidth="44"
                    AutomationProperties.Name="{Binding ClearAutomationName}"
                    ToolTip="Clear this hotkey (unbind)"
                    Click="ClearBtn_Click"><Image Source="{StaticResource JtIcon.Close}" Style="{StaticResource JtSoloIcon}"/></Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>

    <Separator Margin="0,8,0,0"/>

    <!-- Conflict warning -->
    <Border x:Name="ConflictBanner" Background="{DynamicResource BrushSurf2}"
            BorderBrush="{DynamicResource BrushAmber}" BorderThickness="0,1,0,1"
            Padding="16,8" Visibility="Collapsed">
      <DockPanel>
        <Image Source="{StaticResource JtIcon.Warning}" Style="{StaticResource JtInlineIcon}" DockPanel.Dock="Left" VerticalAlignment="Top"/>
        <TextBlock x:Name="ConflictLabel" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushAmberText}"/>
      </DockPanel>
    </Border>

    <!-- ── Keys that only work while Super Magnifier is the active window (not global) ── -->
    <Border Background="{DynamicResource BrushSurf}" BorderBrush="{DynamicResource BrushSurf2}"
            BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="16,10,16,10">
      <StackPanel>
        <TextBlock Text="While Super Magnifier or the lens is the active window"
                   Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Arrow keys"       FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Margin="0,2"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="Move lens 10 px" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,2"/>
          <TextBlock Grid.Row="1" Text="Shift+Arrow"      FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Margin="0,2"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Move lens 50 px" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,2"/>
          <TextBlock Grid.Row="2" Text="Ctrl+Arrow"       FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Margin="0,2"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="Move lens 1 px (fine)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,2"/>
          <TextBlock Grid.Row="3" Text="Ctrl+Shift+Arrow" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Margin="0,2"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="Resize lens (use the 'any app' rows above for a global key)" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,2"/>
          <TextBlock Grid.Row="4" Text="Scroll wheel"     FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushBlueText}" Margin="0,2"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Text="Zoom (over the lens)" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushMuted}" Margin="0,2"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Bottom buttons -->
    <Grid Margin="16,10,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Style="{StaticResource CaptureBtn}"
              HorizontalAlignment="Left"
              MinWidth="140" Padding="10,7"
              Click="ResetAllBtn_Click"
              ToolTip="Restore all hotkeys to their factory defaults"
                    AutomationProperties.Name="Reset all hotkeys to defaults"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Undo}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Restore defaults…" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="2" Content="Cancel"
              Style="{StaticResource CaptureBtn}"
              MinWidth="80" Padding="10,7"
              IsCancel="True" Click="CancelBtn_Click"/>
      <Button x:Name="ApplyBtn" Grid.Column="4" Content="Apply"
              Style="{StaticResource CaptureBtn}"
              MinWidth="80" Padding="10,7"
              IsDefault="True" Click="ApplyBtn_Click"
              Background="{DynamicResource BrushBlue}"
              Foreground="{DynamicResource BrushOnAccent}" BorderBrush="{DynamicResource BrushBlue}"/>
    </Grid>


  <ctl:AccessibleResizeGrip/>
  </StackPanel>
</Window>
