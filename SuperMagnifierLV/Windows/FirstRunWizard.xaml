<Window x:Class="SuperMagnifier.FirstRunWizard"
        ResizeMode="CanResizeWithGrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Super Magnifier LV"
        Width="480" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushText}"
        FontFamily="{DynamicResource AppFontFamily}"
        KeyDown="Window_KeyDown">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Progress dots header -->
    <Border Grid.Row="0" Background="{DynamicResource BrushBlue}" Padding="20,14">
      <Grid>
        <StackPanel>
          <TextBlock x:Name="StepTitle" Text="Welcome"
                     FontSize="16" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="StepSubtitle" Text="Super Magnifier LV"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="#CCDEFF" Margin="0,2,0,0"/>
        </StackPanel>
        <!-- Step indicator dots — WCAG 1.4.1: AutomationProperties.Name conveys
             current page position so colour-change is not the sole indicator. -->
        <StackPanel x:Name="DotPanel"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Orientation="Horizontal"
                    AutomationProperties.Name="Step 1 of 5">
          <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="White" Margin="3,0"
                   AutomationProperties.Name="Step 1 (current)"/>
          <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="#5599EE" Margin="3,0"
                   AutomationProperties.Name="Step 2"/>
          <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="#5599EE" Margin="3,0"
                   AutomationProperties.Name="Step 3"/>
          <Ellipse x:Name="Dot4" Width="10" Height="10" Fill="#5599EE" Margin="3,0"
                   AutomationProperties.Name="Step 4"/>
          <Ellipse x:Name="Dot5" Width="10" Height="10" Fill="#5599EE" Margin="3,0"
                   AutomationProperties.Name="Step 5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Step content area -->
    <Border Grid.Row="1" Padding="28,20">
      <ContentControl x:Name="StepContent"/>
    </Border>

    <!-- Bottom nav -->
    <Border Grid.Row="2" Background="{DynamicResource BrushSurf}"
            BorderBrush="{DynamicResource BrushSurf2}" BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid>
        <Button x:Name="BackBtn" HorizontalAlignment="Left"
                MinWidth="80" Padding="12,7" IsEnabled="False"
                Click="BackBtn_Click"
                    AutomationProperties.Name="Back to previous step"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Back}" Style="{StaticResource JtBtnIcon}"/><TextBlock Text="Back" VerticalAlignment="Center"/></StackPanel>
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Background" Value="{DynamicResource BrushSurf}"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BrushSurf2}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Padding" Value="12,7"/>
              <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Opacity="{TemplateBinding Opacity}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource BrushDisabled}"/>
                  <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="SkipBtn" Content="Skip Tour" Margin="0,0,8,0"
                  MinWidth="80" Padding="12,7"
                  IsCancel="True"
                  AutomationProperties.Name="Skip tour and close wizard"
                  AutomationProperties.HelpText="Skip the welcome tour and start using the app. Keyboard shortcut: Escape"
                  Click="SkipBtn_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>
          <Button x:Name="NextBtn"
                  MinWidth="90" Padding="14,7"
                  Click="NextBtn_Click"
                    AutomationProperties.Name="Next step"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource JtIcon.Forward}" Style="{StaticResource JtBtnIcon}" x:Name="NextBtnIcon"/><TextBlock Text="Next" VerticalAlignment="Center" x:Name="NextBtnText"/></StackPanel>
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushBlue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}" CornerRadius="4"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  <!-- Triangular resize handle -->
  <Path Grid.RowSpan="99" Grid.ColumnSpan="99"
        HorizontalAlignment="Right" VerticalAlignment="Bottom"
        Margin="0,0,2,2" IsHitTestVisible="False"
        Fill="{DynamicResource BrushMuted}" Opacity="0.4">
    <Path.Data>
      <PathGeometry>
        <PathFigure StartPoint="0,16" IsClosed="true">
          <LineSegment Point="16,16"/>
          <LineSegment Point="16,0"/>
        </PathFigure>
      </PathGeometry>
    </Path.Data>
  </Path>
  </Grid>
</Window>
