<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Deep Space — cosmic void palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#050510"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#0A0A1C"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#12122A"/>
  <SolidColorBrush x:Key="BrushText"         Color="#B0BEC5"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#90A3AD"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#909CB0"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#8692D0"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#F16A68"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#9C27B0"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#009688"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#030308"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A1A3A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#525F74"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F27471"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#8C98D3"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
