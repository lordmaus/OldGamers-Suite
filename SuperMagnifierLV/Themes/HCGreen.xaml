<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- HC Green — High Contrast terminal green -->
  <SolidColorBrush x:Key="BrushBg"           Color="#001100"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#003300"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#004400"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#AAFFAA"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#66FF66"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF5E5E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#00FF00"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFFF00"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFFF00"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#FF44FF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#FF88FF"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#002200"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#226622"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFFF00"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#66FF66"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF9A9A"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#44FFFF"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#00FF00"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFFF00"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
