<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ayu Light — WCAG AAA: BrushText/BrushMuted/FocusRingBrush ≥7:1 on BrushBg -->
  <SolidColorBrush x:Key="BrushBg"        Color="#FAFAFA"/>
  <SolidColorBrush x:Key="BrushSurf"      Color="#F0F0F0"/>
  <SolidColorBrush x:Key="BrushSurf2"     Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrushText"      Color="#1C1C1C"/>
  <SolidColorBrush x:Key="BrushMuted"     Color="#474747"/>
  <SolidColorBrush x:Key="BrushHint"      Color="#505050"/>
  <SolidColorBrush x:Key="BrushBlue"      Color="#1258A8"/>
  <SolidColorBrush x:Key="BrushRed"       Color="#AF1B1B"/>
  <SolidColorBrush x:Key="BrushGreen"     Color="#2E7D32"/>
  <SolidColorBrush x:Key="BrushAmber"     Color="#F57C00"/>
  <SolidColorBrush x:Key="BrushBar"       Color="#E8E8E8"/>
  <SolidColorBrush x:Key="BrushDisabled"  Color="#9E9E9E"/>
  <!-- Focus ring: #0040CC on #FAFAFA = 8.2:1 — AAA -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#0040CC"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#8A8A8A"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#9F1818"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#115099"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#225C25"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#7E4000"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
