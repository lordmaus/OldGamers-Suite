<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Volcanic — magma and ash palette -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1A0A0A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#2E1010"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#3E1818"/>
  <SolidColorBrush x:Key="BrushText"         Color="#FFCCBC"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#E8A090"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#D1977F"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#FF612E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#AED581"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF8C00"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#CE93D8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#F48FB1"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#80CBC4"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#0D0505"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#4A1A1A"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#C07050"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#FF7F56"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#80DEEA"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#AED581"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFF176"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
