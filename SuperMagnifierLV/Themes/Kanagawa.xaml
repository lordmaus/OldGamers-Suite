<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Kanagawa — inspired by the Great Wave -->
  <SolidColorBrush x:Key="BrushBg"           Color="#1F1F28"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#2A2A37"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#363646"/>
  <SolidColorBrush x:Key="BrushText"         Color="#DCD7BA"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#C9C5D4"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#B7B7B1"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#7E9CD8"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#D67C7E"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#76946A"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#DCA561"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FFA066"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#C0A36E"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#957FB8"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#D27E99"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#6A9589"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#16161D"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#54546D"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#000000"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#75746B"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#E4A7A9"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#A1B7E3"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#A9BCA1"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#DFAE70"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#000000"/>
</ResourceDictionary>
