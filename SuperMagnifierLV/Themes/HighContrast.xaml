<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ═══════════════════════════════════════════════════════════════════
    High-Contrast theme — WCAG 2.1 SC 1.4.11 / 1.4.12 / user preference
    ═══════════════════════════════════════════════════════════════════
    All colour brushes are bound to Windows System Colors so the UI
    honours the user's selected High-Contrast palette exactly
    (High Contrast #1 / #2 / Black / White or any custom scheme).

    System colour mapping:
      WindowColor              → main background
      ControlColor             → surface / cards
      ControlLightLightColor   → elevated surface
      ControlDarkColor         → nav bar background
      WindowTextColor          → body text
      GrayTextColor            → muted / hint text
      HighlightColor           → accent / focus / checked states
      HotTrackColor            → secondary accent
      InactiveBorderColor      → disabled states
      HighlightTextColor       → text on highlighted/checked backgrounds
  -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="BrushBg"       Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="BrushSurf"     Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="BrushSurf2"    Color="{x:Static SystemColors.ControlLightLightColor}"/>
  <SolidColorBrush x:Key="BrushBar"      Color="{x:Static SystemColors.ControlDarkColor}"/>

  <!-- Text -->
  <SolidColorBrush x:Key="BrushText"     Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="BrushMuted"    Color="{x:Static SystemColors.GrayTextColor}"/>
  <SolidColorBrush x:Key="BrushHint"     Color="{x:Static SystemColors.GrayTextColor}"/>

  <!-- Accent colours — HC mode flattens to system highlight.
       Using HighlightColor ensures meaning is conveyed by element
       state (selected/focused), not colour alone (WCAG 1.4.1). -->
  <SolidColorBrush x:Key="BrushBlue"     Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="BrushRed"      Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="BrushGreen"    Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="BrushAmber"    Color="{x:Static SystemColors.HighlightColor}"/>

  <!-- Inactive / disabled — WCAG 1.4.3 disabled exception applies,
       but InactiveBorderColor is visible in all system HC palettes. -->
  <SolidColorBrush x:Key="BrushDisabled" Color="{x:Static SystemColors.InactiveBorderColor}"/>

  <!-- Focus ring — WindowText is guaranteed ≥ 7:1 against Window in all
       Windows HC palette designs, making it always visible as a border. -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="{x:Static SystemColors.WindowTextColor}"/>

  <!-- CheckBox/RadioButton checked fill complement.
       HighlightTextColor is the OS-guaranteed counterpart to HighlightColor. -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="{x:Static SystemColors.HighlightTextColor}"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="{x:Static SystemColors.GrayTextColor}"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="{x:Static SystemColors.HighlightTextColor}"/>
</ResourceDictionary>
