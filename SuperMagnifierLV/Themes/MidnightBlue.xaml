<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Midnight Blue — deep navy night sky -->
  <SolidColorBrush x:Key="BrushBg"           Color="#05091A"/>
  <SolidColorBrush x:Key="BrushSurf"         Color="#080E28"/>
  <SolidColorBrush x:Key="BrushSurf2"        Color="#0E1640"/>
  <SolidColorBrush x:Key="BrushText"         Color="#C5CAE9"/>
  <SolidColorBrush x:Key="BrushMuted"        Color="#95A4D2"/>
  <SolidColorBrush x:Key="BrushHint"         Color="#909CC8"/>
  <SolidColorBrush x:Key="BrushBlue"         Color="#3E50B2"/>
  <SolidColorBrush x:Key="BrushRed"          Color="#B21310"/>
  <SolidColorBrush x:Key="BrushGreen"        Color="#4CAF50"/>
  <SolidColorBrush x:Key="BrushAmber"        Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOrange"       Color="#FF9800"/>
  <SolidColorBrush x:Key="BrushYellow"       Color="#FFEB3B"/>
  <SolidColorBrush x:Key="BrushPurple"       Color="#7C4DFF"/>
  <SolidColorBrush x:Key="BrushPink"         Color="#E91E63"/>
  <SolidColorBrush x:Key="BrushTeal"         Color="#009688"/>
  <SolidColorBrush x:Key="BrushBar"          Color="#030613"/>
  <!-- BrushDisabled exempt per WCAG — inactive UI -->
  <SolidColorBrush x:Key="BrushDisabled"     Color="#1A2560"/>
  <!-- Focus ring — 7:1+ contrast on BrushBg -->
  <SolidColorBrush x:Key="FocusRingBrush"    Color="#FFD700"/>
  <!-- CheckBox glyph on BrushBlue fill -->
  <SolidColorBrush x:Key="BrushBgForChecked" Color="#FFFFFF"/>
  <!-- WCAG AAA text tokens (check_theme_contrast.py, 2026-09-25): accent fills stay BrushRed/Blue/Green/Amber; text uses *Text; text on fills uses BrushOnAccent -->
  <SolidColorBrush x:Key="BrushDivider"     Color="#5060A0"/>
  <SolidColorBrush x:Key="BrushRedText"     Color="#F27976"/>
  <SolidColorBrush x:Key="BrushBlueText"    Color="#8E9AD8"/>
  <SolidColorBrush x:Key="BrushGreenText"   Color="#4DB251"/>
  <SolidColorBrush x:Key="BrushAmberText"   Color="#FFC107"/>
  <SolidColorBrush x:Key="BrushOnAccent"    Color="#FFFFFF"/>
</ResourceDictionary>
