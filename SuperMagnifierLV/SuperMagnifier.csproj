<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SuperMagnifierLV</AssemblyName>
    <RootNamespace>SuperMagnifier</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Version: from version.txt via ..\Directory.Build.props (S-03); build.bat bumps it. -->
    <!-- Publish as a self-contained single-file exe:
         dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true /p:SelfContained=true -->
    <Optimize>true</Optimize>
    <!-- portable PDB → crash.log stacks get file/line (S-08); build.bat stages it in Builds\<ver>\, not the installer -->
    <DebugType>portable</DebugType>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Suppress WPF trimming warnings — P/Invoke and reflection are intentional -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- WFO0003: DPI awareness is configured in app.manifest for WPF.
         Suppress the WinForms warning since this is a WPF app, not WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuperMagnifierLV.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme XAML resource dictionaries — embedded as Resource (not compiled Page)
         so they load correctly via relative URI in single-file publish.
         2026-10-13: the files now live in ..\Shared\Themes and are linked as Resource
         at the bottom of this file (same Themes/X.xaml URIs). -->
    <!-- UIAutomation types (included in WindowsDesktop SDK on net10-windows) -->
    <None Update="Assets\app.manifest" />
    <None Update="Assets\app.ico" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Embedded resource so GetManifestResourceStream works in single-file publish -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="SuperMagnifier.app.ico" />
  </ItemGroup>

  <!-- Suite (2026-10-13): shared library + canonical themes (Shared\Themes, linked so "Themes/X.xaml" URIs still resolve). -->
  <ItemGroup>
    <ProjectReference Include="..\Shared\OldGamers.Wpf.Shared\OldGamers.Wpf.Shared.csproj" />
    <Resource Include="..\Shared\Themes\*.xaml" Link="Themes\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
